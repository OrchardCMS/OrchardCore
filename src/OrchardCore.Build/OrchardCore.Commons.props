<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <VersionPrefix>4.0.0</VersionPrefix>
    <VersionSuffix>preview</VersionSuffix>
    <VersionSuffix Condition="'$(VersionSuffix)'!='' AND '$(BuildNumber)' != ''">$(VersionSuffix)-$(BuildNumber)</VersionSuffix>
    <WarningsNotAsErrors>612,618</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DebugType>portable</DebugType>
    <ImplicitUsings>enable</ImplicitUsings>
    <NetStandardImplicitPackageVersion>2.0.0-*</NetStandardImplicitPackageVersion>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <!-- Enable interceptors -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);OrchardCore.DisplayManagement.Generated</InterceptorsNamespaces>
    <!-- Common NuGet properties-->
    <OCFrameworkDescription>Orchard Core Framework is an application framework for building modular, multi-tenant applications on ASP.NET Core.</OCFrameworkDescription>
    <OCCMSDescription>Orchard Core CMS is a Web Content Management System (CMS) built on top of the Orchard Core Framework.</OCCMSDescription>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>

    <!--This is used to generate symbol package for Source Link-->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- This is used by GitHub Repository to find which repository should contain the package when uploaded -->
    <RepositoryUrl>https://github.com/OrchardCMS/OrchardCore</RepositoryUrl>
    <PackageProjectUrl>https://www.orchardcore.net/</PackageProjectUrl>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>

    <PackageTags>OrchardCore</PackageTags>
    <Copyright>Orchard Core Community and Contributors</Copyright>
    <Authors>Orchard Core Community and Contributors</Authors>
    <Owners>Orchard Core Community and Contributors</Owners>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)/nuget-icon.png">
      <Pack>True</Pack>
      <PackagePath>icon.png</PackagePath>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <!-- The compiler tooling projects neither use the Orchard Core analyzers nor extract localization catalogs. -->
    <OrchardCoreToolingProject Condition="'$(OrchardCoreToolingProject)' == '' and ('$(MSBuildProjectName)' == 'OrchardCore.SourceGenerators' or '$(MSBuildProjectName)' == 'OrchardCore.Localization.Analyzers' or '$(MSBuildProjectName)' == 'OrchardCore.Localization.Analyzers.CodeFixes' or '$(MSBuildProjectName)' == 'OrchardCore.Localization.Extraction' or '$(MSBuildProjectName)' == 'OrchardCore.Localization.Tools' or '$(MSBuildProjectName)' == 'OrchardCore.Localization.Build')">true</OrchardCoreToolingProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(OrchardCoreToolingProject)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)/../OrchardCore/OrchardCore.SourceGenerators/OrchardCore.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- The localization analyzers and their code fixes ship in the OrchardCore.Abstractions package. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)/../OrchardCore/OrchardCore.Localization.Analyzers/OrchardCore.Localization.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)/../OrchardCore/OrchardCore.Localization.Analyzers.CodeFixes/OrchardCore.Localization.Analyzers.CodeFixes.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Import Project="../OrchardCore/OrchardCore.Localization.Build/OrchardCore.Localization.Build.props"
          Condition="'$(GenerateLocalizationCatalog)' != 'false' and '$(OrchardCoreToolingProject)' != 'true'" />
  <Import Project="../OrchardCore/OrchardCore.Localization.Build/OrchardCore.Localization.Build.targets"
          Condition="'$(GenerateLocalizationCatalog)' != 'false' and '$(OrchardCoreToolingProject)' != 'true'" />

</Project>
