@model EditShapePlacementViewModel
@{
    var returnUrl = ViewData["returnUrl"]?.ToString();
}

<style asp-name="codemirror"></style>
<script asp-name="codemirror" at="Foot"></script>
<script asp-name="codemirror-addon-display-autorefresh" at="Foot"></script>
<script asp-name="codemirror-addon-selection-active-line" at="Foot"></script>
<script asp-name="codemirror-mode-javascript" at="Foot"></script>

<zone Name="Title">
    <breadcrumb name="PlacementsEdit" title="@(Model.Creating ? T["Create Placement"] : T["Edit Placement"])">
        <breadcrumb-item id="Placements" action="Index" controller="Admin" area="OrchardCore.Placements" permission="@Permissions.ManagePlacements.Name">@T["Placements"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="Edit" asp-route-returnUrl="@ViewData["returnUrl"]" method="post" class="no-multisubmit">
    @Html.HiddenFor(m => m.Creating)
    @if (!Model.Creating)
    {
        <input asp-for="ShapeType" type="hidden" id="@Html.IdFor(m => m.ShapeType)_Hidden" />
    }

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <a class="btn btn-secondary cancel" role="button" href="@returnUrl">@Localize(CommonLocalizationSources.Cancel)</a>

        @if (!Model.Creating)
        {
            <a asp-route-action="Delete" asp-route-area="OrchardCore.Placements" asp-route-shapeType="@Model.ShapeType" class="btn btn-danger action-bar-secondary" role="button" data-url-af="UnsafeUrl RemoveUrl">@Localize(CommonLocalizationSources.Delete)</a>
        }

        <div class="btn-group"
             role="group"
             aria-label="@Localize(CommonLocalizationSources.SaveActions)"
             data-action-group="oc-placement-save-action"
             data-action-default="Save"
             data-label-default="@Localize(CommonLocalizationSources.Save)"
             data-action-alt="SaveAndContinue"
             data-label-alt="@Localize(CommonLocalizationSources.SaveAndContinue)">
            <button type="submit" value="Save" name="submit" class="btn btn-primary">@Localize(CommonLocalizationSources.Save)</button>
            <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-reference="parent" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <span class="visually-hidden">@Localize(CommonLocalizationSources.ToggleDropdown)</span>
            </button>
            <div class="dropdown-menu">
                <button class="dropdown-item" name="submit" type="submit" value="SaveAndContinue">@T["and continue"]</button>
            </div>
        </div>
    </div>
</form>

<script asp-src="~/OrchardCore.Placements/Scripts/placement-edit/placement-edit.min.js" debug-src="~/OrchardCore.Placements/Scripts/placement-edit/placement-edit.js" at="Foot" type="module"></script>
