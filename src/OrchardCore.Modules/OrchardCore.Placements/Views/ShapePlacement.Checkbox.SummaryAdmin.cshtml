@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Placements.Models

@model ShapeViewModel<ShapePlacement>

<div class="form-check">
    <input type="checkbox" class="form-check-input" value="@Model.Value.ShapeType" name="itemIds" id="itemIds-@Model.Value.ShapeType">
    <label class="form-check-label" for="itemIds-@Model.Value.ShapeType">&nbsp;</label>
</div>
