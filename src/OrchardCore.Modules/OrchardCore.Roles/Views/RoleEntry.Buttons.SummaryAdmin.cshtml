@using Microsoft.AspNetCore.Authorization
@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Roles
@using OrchardCore.Roles.ViewModels

@inject IAuthorizationService AuthorizationService

@model ShapeViewModel<RoleEntry>

@if (await AuthorizationService.AuthorizeAsync(User, RolesPermissions.ManageRoles))
{
    <a class="edit btn btn-primary btn-sm" role="button" asp-action="Edit" asp-controller="Admin" asp-route-id="@Model.Value.Name">@T["Edit"]</a>

    @if (!Model.Value.IsSystemRole)
    {
        <a class="delete btn btn-danger btn-sm" role="button" asp-action="Delete" asp-controller="Admin" asp-route-id="@Model.Value.Name" data-url-af="RemoveUrl UnsafeUrl" data-title="@T["Delete role"]" data-message="@T["Are you sure you want to delete this role?"]">@T["Delete"]</a>
    }
}
