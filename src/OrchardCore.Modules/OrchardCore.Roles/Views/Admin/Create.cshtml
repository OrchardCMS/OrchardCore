@model CreateRoleViewModel
@using OrchardCore.Roles.Controllers
@using OrchardCore.Roles.ViewModels

<zone Name="Title"><h1>@RenderTitleSegments(T["Create Role"])</h1></zone>

<div asp-validation-summary="ModelOnly"></div>

<form asp-action="Create" method="post" class="no-multisubmit">
    <div class="ocat-wrapper" asp-validation-class-for="RoleName">
        <label asp-for="RoleName" class="ocat-label">@T["Name"]</label>
        <div class="ocat-end">
        <input asp-for="RoleName" class="form-control" autofocus />
        <span asp-validation-for="RoleName" class="text-danger"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="RoleDescription">
        <label asp-for="RoleDescription" class="ocat-label">@T["Description"]</label>
        <div class="ocat-end">
        <textarea asp-for="RoleDescription" class="form-control"></textarea>
        <span asp-validation-for="RoleDescription" class="text-danger"></span>
        </div>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <div class="btn-group">
                <button class="btn btn-primary create" type="submit" name="submit">@T["Create"]</button>
                <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-reference="parent" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span class="visually-hidden">@T["Toggle Dropdown"]</span>
                </button>
                <div class="dropdown-menu">
                    <button class="dropdown-item save-continue" name="submit" type="submit" value="@AdminController.SaveAndContinueSubmitValue">@T["and continue"]</button>
                </div>
            </div>
            <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>
