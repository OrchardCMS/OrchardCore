@model CreateRoleViewModel
@using OrchardCore.Roles.Controllers
@using OrchardCore.Roles.ViewModels

<zone Name="Title">
    <breadcrumb name="RolesCreate" title="@T["Create Role"]">
        <breadcrumb-item id="Roles" action="Index" controller="Admin" area="OrchardCore.Roles" permission="@RolesPermissions.ViewRoles.Name">@T["Roles"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div asp-validation-summary="ModelOnly"></div>

<form asp-action="Create" method="post" class="no-multisubmit">
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary create" type="submit" name="submit">@T["Create"]</button>
        <button class="btn btn-secondary save-configure action-bar-secondary" type="submit" name="submit" value="@AdminController.SaveAndConfigureSubmitValue">@T["Save &amp; Configure"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
