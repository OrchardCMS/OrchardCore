@model EditRoleViewModel
@using OrchardCore.Roles.Controllers
@using OrchardCore.Roles.ViewModels

<zone Name="Title">
    <breadcrumb name="RolesEdit" title="@T["Edit '{0}' Role", Model.Role.RoleName]">
        <breadcrumb-item id="Roles" action="Index" controller="Admin" area="OrchardCore.Roles" permission="@RolesPermissions.ViewRoles.Name">@T["Roles"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div asp-validation-summary="ModelOnly"></div>

@await Html.PartialAsync("_DuplicatedPermissions")

<form asp-action="Edit" asp-route-id="@ViewContext.HttpContext.Request.RouteValues["id"]" method="post" class="no-multisubmit" data-list-management data-client-side-search="true" data-search-result-selector=".permissions-list > table > tbody > tr" data-search-text-attribute="data-text" data-search-group-selector=".permissions-list" data-search-group-visible-selector="table > tbody > tr">
    <div class="mb-3" asp-validation-class-for="RoleDescription">
        <label asp-for="RoleDescription" class="form-label">@T["Description"]</label>
        <textarea asp-for="RoleDescription" class="form-control"></textarea>
        <span asp-validation-for="RoleDescription" class="text-danger"></span>
    </div>

    @await Html.PartialAsync("_RolePermissions", Model.Permissions)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <div class="btn-group">
                <button class="btn btn-primary save" type="submit" name="submit">@T["Save"]</button>
                <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-reference="parent" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <span class="visually-hidden">@T["Toggle Dropdown"]</span>
                </button>
                <div class="dropdown-menu">
                    <button class="dropdown-item save-continue" name="submit" type="submit" value="@AdminController.SaveAndContinueSubmitValue">@T["and continue"]</button>
                </div>
            </div>
            <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>

<script asp-src="~/OrchardCore.Roles/Scripts/roles-editors/roles-edit.min.js" debug-src="~/OrchardCore.Roles/Scripts/roles-editors/roles-edit.js" at="Foot" type="module"></script>
