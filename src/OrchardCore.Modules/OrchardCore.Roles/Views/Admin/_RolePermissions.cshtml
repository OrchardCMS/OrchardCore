@model RolePermissionsViewModel
@using OrchardCore.Roles.ViewModels
@using OrchardCore.Localization.Data
@using Microsoft.Extensions.Localization
@using OrchardCore.Security.Permissions
@inject IDataLocalizer D
@inject IStringLocalizerFactory StringLocalizerFactory

@functions {
    // Uses the PO file translation of the description when there is one.
    // Otherwise, uses the Data Localization translation of the description.
    private string GetDescription(Permission permission, string permissionsContext)
    {
        var description = permission.Description;

        if (string.IsNullOrEmpty(description?.Name))
        {
            return permission.Name;
        }

        var localized = StringLocalizerFactory.Localize(description);

        if (!localized.ResourceNotFound && localized.Value != description.Name)
        {
            return localized.Value;
        }

        return D[description.Name, permissionsContext].Value;
    }
}

@if (Model.IsAdminRole)
{
    <div class="alert alert-info" role="alert">@T["This system role provides comprehensive access by granting all available permissions."]</div>
}
else
{
    <div class="my-3">

        <div class="mb-3 border border-1 rounded bg-info-subtle px-3 py-2 d-flex flex-column">
            <div>
                <strong>@T["Allow"]</strong> <span class="hint dashed">@T["Permission is granted explicitly."]</span>
            </div>
            <div>
                <strong>@T["Effective"]</strong> <span class="hint dashed">@T["Permission is implied by a higher level permission, or explicitly granted."]</span>
            </div>
        </div>

        <div class="mb-3">
            <div class="input-group filter-options">
                <input id="search-box" class="form-control" placeholder="@T["Search permissions"]" type="search" autofocus autocomplete="off" />
            </div>
        </div>

        @foreach (var group in Model.RoleCategoryPermissions.OrderBy(x => x.Key.Title).ThenBy(x => x.Key.Source))
        {
            var permissionsContext = $"Permissions{Constants.ContextSeparator}{group.Key.Title}";
            <fieldset class="permissions-list">
                <legend>
                    <span>@D[group.Key.Title, permissionsContext]</span>
                    @if (!string.IsNullOrEmpty(group.Key.Source))
                    {
                        <span class="hint">(@group.Key.Source)</span>
                    }
                </legend>

                <table class="table">
                    <thead>
                        <tr>
                            <th class="col-10">@T["Permission"]</th>
                            <th class="col-1">@T["Allow"]</th>
                            <th class="col-1">@T["Effective"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (permission, description) in group.Value
                            .Select(x => (Permission: x, Description: GetDescription(x, permissionsContext)))
                            .OrderBy(x => x.Description, StringComparer.CurrentCultureIgnoreCase))
                        {

                            var isAssigned = Model.AssignedPermissions.Contains(permission.Name);
                            var isEffective = false;
                            var toolTip = T["This permission is not granted to this role."];
                            if (Model.EffectivePermissions?.TryGetValue(permission.Name, out var effectivePermission) ?? false && effectivePermission is not null)
                            {
                                isEffective = true;
                                if (isAssigned)
                                {
                                    toolTip = T["This permission is granted to this role."];
                                }
                                else
                                {
                                    var impliedByAssigned = effectivePermission.ImpliedBy
                                        ?.Where(p => Model.AssignedPermissions.Contains(p.Name))
                                        .Select(p => GetDescription(p, permissionsContext))
                                        .ToList() ?? [];

                                    if (impliedByAssigned.Count > 0)
                                    {
                                        toolTip = T["This permission is implied by: {0}", string.Join(", ", impliedByAssigned)];
                                    }
                                    else
                                    {
                                        var grantingRoles = new List<string>();
                                        if (Model.AnonymousGrantedPermissions.Contains(permission.Name))
                                        {
                                            grantingRoles.Add(T["Anonymous"].Value);
                                        }
                                        if (Model.AuthenticatedGrantedPermissions.Contains(permission.Name))
                                        {
                                            grantingRoles.Add(T["Authenticated"].Value);
                                        }

                                        toolTip = grantingRoles.Count > 0
                                            ? T["This permission is granted by role: {0}", string.Join(", ", grantingRoles)]
                                            : T["This permission is effective but the source could not be determined."];
                                    }
                                }
                            }

                            <tr data-text="@description">
                                <td class="col-10">
                                    @description
                                    @if (permission.IsSecurityCritical)
                                    {
                                        <div class="float-end">
                                            <span class="badge text-bg-danger" data-bs-toggle="tooltip" data-bs-html="true" title="@T["This permission could allow a user to elevate their other permissions. Grant it with extreme consideration."]">@T["Security Critical"]</span>
                                        </div>
                                    }
                                </td>
                                <td class="col-1">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" disabled="@(!Model.CanEdit)" id="Checkbox.@permission.Name" name="Checkbox.@permission.Name" checked="@isAssigned" value="true">
                                        <label class="form-check-label" for="Checkbox.@permission.Name"></label>
                                    </div>
                                </td>
                                <td class="col-1">
                                    <div class="form-check" data-bs-toggle="tooltip" data-bs-html="true" title="@toolTip">
                                        <input type="checkbox" class="form-check-input" disabled="disabled" id="Effective.@permission.Name" name="Effective.@permission.Name" checked="@isEffective">
                                        <label class="form-check-label" for="Effective.@permission.Name"></label>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </fieldset>
        }
    </div>
}
