@using Microsoft.AspNetCore.Authorization
@using OrchardCore.Roles

@model OrchardCore.Roles.ViewModels.RolesViewModel

@inject IAuthorizationService AuthorizationService

@{
    var hasManagePermission = await AuthorizationService.AuthorizeAsync(User, RolesPermissions.ManageRoles);
}

<zone Name="Title"><h1>@RenderTitleSegments(T["Roles"])</h1></zone>

<div data-list-management data-client-side-search="true">
    <div class="card mb-3 text-bg-theme position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group has-search">
                        <i class="fa-solid fa-search form-control-feedback" aria-hidden="true"></i>
                        <input id="search-box" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]">@T["Go"]</button>
                    </div>
                </div>
                @if (hasManagePermission)
                {
                    <div class="col-auto">
                        <a asp-route-action="Create" class="btn btn-secondary create" role="button">@T["Add Role"]</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <form asp-action="Index" class="roles">
        <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />

        @* The roles are rendered by the AdminList shape using the configured layout (List, Table, ...). *@
        @await DisplayAsync(Model.List)
    </form>

    <div id="list-alert" class="alert alert-info my-3 d-none text-center" role="alert">
        @T["Your search returned no results."]
    </div>
</div>

<script asp-name="list-management" at="Foot"></script>
