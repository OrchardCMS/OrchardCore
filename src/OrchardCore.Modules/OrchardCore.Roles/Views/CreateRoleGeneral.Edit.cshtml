@model CreateRoleViewModel
@using OrchardCore.Roles.ViewModels

<div class="ocat-wrapper" asp-validation-class-for="RoleName">
    <label asp-for="RoleName" class="ocat-label ocat-label-required">@T["Name"]</label>
    <div class="ocat-end">
        <input asp-for="RoleName" class="form-control" autofocus />
        <span asp-validation-for="RoleName" class="text-danger"></span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="RoleDescription">
    <label asp-for="RoleDescription" class="ocat-label">@T["Description"]</label>
    <div class="ocat-end">
        <textarea asp-for="RoleDescription" class="form-control"></textarea>
        <span asp-validation-for="RoleDescription" class="text-danger"></span>
    </div>
</div>
