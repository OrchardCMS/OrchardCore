@{
    TagBuilder tag = Tag(Model, "li");
    tag.AddCssClass("breadcrumb-item");

    string text = Model.Text;
    string href = Model.Href;
    string heading = Model.Heading;

    if (Model.IsCurrent)
    {
        tag.AddCssClass("active");
        tag.Attributes["aria-current"] = "page";
    }

    if (!string.IsNullOrEmpty(href))
    {
        var link = new TagBuilder("a");
        link.Attributes["href"] = href;
        link.InnerHtml.Append(text);

        tag.InnerHtml.AppendHtml(link);
    }
    else if (!string.IsNullOrEmpty(heading))
    {
        var title = new TagBuilder(heading);
        title.InnerHtml.Append(text);

        tag.InnerHtml.AppendHtml(title);
    }
    else
    {
        tag.InnerHtml.Append(text);
    }
}

@tag
