@using OrchardCore.Entities
@{
    Notification notification = Model.Notification;

    if (notification == null)
    {
        return;
    }

    var readInfo = notification.GetOrCreate<NotificationReadInfo>();
}

@* The drivers place the subject and summary in the Content zone, the received date and the type in the Meta zone,
   and a module can add its own fields, badges and buttons to these zones and to the Actions zone, for a notification type. *@
<div data-message-id="@notification.NotificationId" data-is-read="@readInfo.IsRead.ToString().ToLowerInvariant()" class="dropdown-item notification-item mark-notification-as-read text-wrap @(readInfo.IsRead ? "notification-is-read": "notification-is-unread")">
    @if (Model.Content != null)
    {
        <div class="notification-content">
            @await DisplayAsync(Model.Content)
        </div>
    }
    @if (Model.Meta != null)
    {
        <div class="notification-meta">
            @await DisplayAsync(Model.Meta)
        </div>
    }
    @if (Model.Actions != null)
    {
        <div class="notification-actions">
            @await DisplayAsync(Model.Actions)
        </div>
    }
</div>
