@using OrchardCore.Localization

@model ListNotificationOptions

<div class="input-group">
    <input asp-for="OriginalSearchText" type="hidden" />
    <label asp-for="SearchText" class="visually-hidden">@T["Search"]</label>
    <input asp-for="SearchText" class="form-control" placeholder="@T["Search"]" inputmode="search" type="search" autofocus />
    <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
</div>
