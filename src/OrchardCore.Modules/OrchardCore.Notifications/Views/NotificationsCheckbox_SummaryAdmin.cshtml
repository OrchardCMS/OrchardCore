@model NotificationViewModel

<div class="form-check">
    <input type="checkbox" class="form-check-input" value="@Model.Notification.NotificationId" name="itemIds" id="itemIds-@Model.Notification.NotificationId">
    <label class="form-check-label" for="itemIds-@Model.Notification.NotificationId"><span class="visually-hidden">@T["Select {0}", Model.Notification.Summary]</span></label>
</div>
