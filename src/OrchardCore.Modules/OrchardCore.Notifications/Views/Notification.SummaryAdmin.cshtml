<div class="row g-0">
    <div class="col-lg col-12 title d-flex align-items-center">
        @if (Model.Checkbox != null)
        {
            <div class="selectors-container d-flex me-2">
                @if (Model.Selectors != null)
                {
                    <div class="selectors cursor-pointer">
                        @await DisplayAsync(Model.Selectors)
                    </div>
                }
                @await DisplayAsync(Model.Checkbox)
            </div>
        }
        <div class="summary d-flex flex-column flex-md-row list-item-search-text">
            <div class="me-2">
                @if (Model.Content != null)
                {
                    @await DisplayAsync(Model.Content)
                }
            </div>

            @if (Model.Tags != null)
            {
                <div class="tags me-1">
                    @await DisplayAsync(Model.Tags)
                </div>
            }
            @if (Model.Meta != null)
            {
                <div class="metadata me-1">
                    @await DisplayAsync(Model.Meta)
                </div>
            }
        </div>
    </div>
    <div class="col-lg-auto col-12 d-flex justify-content-end">
        @* The Actions and ActionsMenu zones are rendered in the layout configured in the admin settings (Buttons, Menu, ...). *@
        @await DisplayAsync(await New.AdminListActions(Row: Model))
    </div>
</div>
