@using OrchardCore.Notifications.Endpoints.Management
@model NotificationViewModel

@{
    var listUrl = Url.Action("List", "Admin", new { area = NotificationConstants.Features.Notifications });
}

@if (Model.Visibility == NotificationVisibility.Visible && !string.IsNullOrEmpty(Model.Notification.Url))
{
    <a class="btn btn-primary" href="@Url.RouteUrl(OpenNotificationEndpoints.RouteName, new { notificationId = Model.Notification.NotificationId })">@T["Open"]</a>
}

<a class="btn btn-secondary" asp-action="Toggle" asp-controller="Admin" asp-route-area="OrchardCore.Notifications" asp-route-markAsRead="false" asp-route-notificationId="@Model.Notification.NotificationId" asp-route-returnUrl="@listUrl">@T["Mark as unread"]</a>

<a class="btn btn-danger" asp-action="Delete" asp-controller="Admin" asp-route-area="OrchardCore.Notifications" asp-route-notificationId="@Model.Notification.NotificationId" asp-route-returnUrl="@listUrl" data-url-af="UnsafeUrl RemoveUrl" data-title=@T["Delete a notification"] data-message=@T["Are you sure you want to delete this notification?"] data-ok-text="@T["Yes"]" data-cancel-text="@T["No"]" data-ok-class="btn-primary">@T["Delete"]</a>
