@model ListNotificationsViewModel

<div class="bulk-select-list" data-checkbox-name="itemIds" data-bulk-action-name="Options.BulkAction" data-selected-text="@T["selected"]">
<!-- Hidden submit button do not remove -->
<input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
<input type="submit" name="submit.BulkAction" class="visually-hidden" />
@Html.HiddenFor(o => o.Options.BulkAction)

@if (Model.Header?.Search != null || Model.Header?.ActionBarButtons != null)
{
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                @if (Model.Header.Search != null)
                {
                    <div class="col">
                        @await DisplayAsync(Model.Header.Search)
                    </div>
                }

                @if (Model.Header.ActionBarButtons != null)
                {
                    <div class="col-auto">
                        @await DisplayAsync(Model.Header.ActionBarButtons)
                    </div>
                }
            </div>
        </div>
    </div>
}

@* The notifications, the header and the pager are rendered by the AdminList shape using the configured layout (List, Grid, ...). *@
@await DisplayAsync(Model.List)
</div>

<style asp-name="bootstrap-select" at="Head"></style>
<script asp-name="bootstrap-select" at="Foot"></script>
<script asp-src="~/OrchardCore.Notifications/Scripts/notifications-admin-list/notifications-admin-list.min.js" debug-src="~/OrchardCore.Notifications/Scripts/notifications-admin-list/notifications-admin-list.js" at="Foot" type="module"></script>

<style at="Head">
    /* The read state is a class on the row, so it applies in every layout: the <li> of the List layout
       and the row element of the Grid layout. */
    .admin-list .notification-is-unread,
    .admin-list .notification-is-unread > .admin-list-grid-cell {
        color: #664d03 !important;
        background-color: #fff3cd !important;
    }
</style>
