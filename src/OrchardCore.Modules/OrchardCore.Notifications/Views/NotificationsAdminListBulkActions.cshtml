@model ListNotificationOptions

@foreach (var item in Model.BulkActions)
{
    <a class="dropdown-item" href="javascript:void(0)" data-action="@item.Value" data-title="@T["Bulk Action"]" data-message="@T.Note("{0} is the lowercased name of the selected bulk action.")["Are you sure you want to {0} these items?", Arg("bulk action", item.Text.ToLower())]">@item.Text</a>
}
