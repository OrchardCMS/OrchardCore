@using OrchardCore.Notifications.Endpoints.Management
@model NotificationViewModel

@if (!string.IsNullOrEmpty(Model.Notification.Url))
{
    <a class="d-block text-reset text-decoration-none notification-link" href="@Url.RouteUrl(OpenNotificationEndpoints.RouteName, new { notificationId = Model.Notification.NotificationId })">
        <span class="d-block @(Model.IsRead ? null : "fw-semibold")">@Model.Notification.Subject</span>
    </a>
}
else
{
    <span class="d-block @(Model.IsRead ? null : "fw-semibold")">@Model.Notification.Subject</span>
}

@if (!string.IsNullOrWhiteSpace(Model.Notification.Summary))
{
    <div class="small text-body-secondary">
        @Html.Raw(Model.Notification.Summary)
    </div>
}
