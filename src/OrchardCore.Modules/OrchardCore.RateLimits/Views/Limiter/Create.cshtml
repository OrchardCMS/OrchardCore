@model OrchardCore.RateLimits.ViewModels.RateLimiterEditorViewModel
@using OrchardCore.RateLimits.Models
@inject OrchardCore.RateLimits.Core.IRateLimitPolicyStore PolicyStore

@{
    var sourceId = ViewContext.HttpContext.Request.Query["id"];
    var policyId = ViewContext.RouteData.Values["policyId"]?.ToString();
}

<zone Name="Title">
    <breadcrumb name="RateLimitsLimiterCreate" title="@T["Add '{0}' Limiter", Model.DisplayName]">
        <breadcrumb-item id="RateLimits" action="Index" controller="Admin" area="OrchardCore.RateLimits" permission="@RateLimitsPermissions.ManageRateLimits.Name">@T["Rate Limit Policies"]</breadcrumb-item>
        @if (!string.IsNullOrEmpty(policyId))
        {
            var policy = await PolicyStore.FindByIdAsync(policyId, PolicyVersion.Current);
            <breadcrumb-item id="Policy" action="Edit" controller="Admin" area="OrchardCore.RateLimits" route-policyId="@policyId" permission="@RateLimitsPermissions.ManageRateLimits.Name">@(policy?.Name ?? T["Rate Limit Policy"].Value)</breadcrumb-item>
        }
    </breadcrumb>
</zone>

<form asp-action="Create" method="post" class="no-multisubmit">
    <input type="hidden" name="id" value="@sourceId" />
    <div class="alert alert-info" role="alert">
        <span>@Model.Description</span>
        <a class="seedoc" href="@Model.DocumentationUrl" target="_blank">@T["Learn more"]</a>
    </div>

    @await DisplayAsync(Model.Editor)

    <div class="mt-4 d-flex gap-1">
        <button class="btn btn-primary" type="submit">@T["Add Limiter"]</button>
        <a asp-action="Edit" asp-controller="Admin" asp-route-policyId="@ViewContext.RouteData.Values["policyId"]" class="btn btn-secondary">@T["Cancel"]</a>
    </div>
</form>
