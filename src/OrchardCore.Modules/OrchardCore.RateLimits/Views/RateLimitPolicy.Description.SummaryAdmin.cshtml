@using System.Globalization
@using OrchardCore.DisplayManagement.Views
@using OrchardCore.RateLimits.Models

@model ShapeViewModel<RateLimitPolicy>

@{
    var policy = Model.Value;

    var target = policy.Scope switch
    {
        RateLimitPolicyScope.Global => T["Applies to every tenant request."].Value,
        RateLimitPolicyScope.Endpoint => string.Format(CultureInfo.CurrentCulture, T["Matches requests starting with '{0}'."].Value, policy.Path),
        RateLimitPolicyScope.Group => string.Format(CultureInfo.CurrentCulture, T["Matches endpoints in the '{0}' group."].Value, policy.GroupName),
        _ => string.Empty,
    };
}

@if (!string.IsNullOrWhiteSpace(target) || !string.IsNullOrWhiteSpace(policy.Description))
{
    <div class="admin-list-secondary">
        @if (!string.IsNullOrWhiteSpace(target))
        {
            <div>@target</div>
        }
        @if (!string.IsNullOrWhiteSpace(policy.Description))
        {
            <div>@policy.Description</div>
        }
    </div>
}
