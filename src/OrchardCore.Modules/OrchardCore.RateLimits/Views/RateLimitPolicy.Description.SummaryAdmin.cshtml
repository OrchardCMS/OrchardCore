@using OrchardCore.DisplayManagement.Views
@using OrchardCore.RateLimits.Models

@model ShapeViewModel<RateLimitPolicy>

@{
    var policy = Model.Value;

    // Rendered as they are: a localized text is already HTML, and the localizer encodes its arguments.
    var target = policy.Scope switch
    {
        RateLimitPolicyScope.Global => T["Applies to every tenant request."],
        RateLimitPolicyScope.Endpoint => T["Matches requests starting with '{0}'.", policy.Path],
        RateLimitPolicyScope.Group => T["Matches endpoints in the '{0}' group.", policy.GroupName],
        _ => null,
    };
}

@if (target != null || !string.IsNullOrWhiteSpace(policy.Description))
{
    <div class="admin-list-secondary">
        @if (target != null)
        {
            <div>@target</div>
        }
        @if (!string.IsNullOrWhiteSpace(policy.Description))
        {
            <div>@policy.Description</div>
        }
    </div>
}
