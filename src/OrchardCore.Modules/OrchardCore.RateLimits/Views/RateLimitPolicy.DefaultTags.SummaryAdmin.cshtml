@using OrchardCore.DisplayManagement.Views
@using OrchardCore.RateLimits.Models

@model ShapeViewModel<RateLimitPolicy>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@Localize(CommonLocalizationSources.Status)">
    <i class="fa-solid @(Model.Value.IsEnabled ? "fa-check text-success" : "fa-ban text-secondary")" aria-hidden="true"></i>
    @(Model.Value.IsEnabled ? Localize(CommonLocalizationSources.EnabledState) : Localize(CommonLocalizationSources.DisabledState))
</span>
