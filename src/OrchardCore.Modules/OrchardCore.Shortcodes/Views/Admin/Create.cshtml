@model ShortcodeTemplateViewModel
@using System.Text.Json
@inject IDisplayManager<ShortcodeDescriptor> ShortcodeDescriptorDisplayManager
@inject IShortcodeDescriptorManager ShortcodeDescriptorManager
@{
    var shortcodeDescriptors = await ShortcodeDescriptorManager.GetShortcodeDescriptors();
    var categories = shortcodeDescriptors
        .SelectMany(shortcodeDescriptor => shortcodeDescriptor.Categories ?? Enumerable.Empty<string>())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    // The categories of the shortcode, the posted ones when the form is displayed again, and the other ones of the shortcodes.
    var selectedCategories = Model.Categories?.Length > 0 || string.IsNullOrEmpty(Model.SelectedCategories)
        ? Model.Categories ?? []
        : JConvert.DeserializeObject<string[]>(Model.SelectedCategories) ?? [];
    categories = selectedCategories
        .Concat(categories)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(category => category)
        .ToList();
}

<style asp-name="codemirror"></style>
<style asp-name="codemirror-addon-display-fullscreen"></style>
<script asp-name="codemirror" at="Foot"></script>
<script asp-name="codemirror-addon-edit-closetag" at="Foot"></script>
<script asp-name="codemirror-mode-javascript" at="Foot"></script>
<script asp-name="codemirror-addon-display-autorefresh" at="Foot"></script>
<script asp-name="codemirror-addon-display-fullscreen" at="Foot"></script>
<script asp-name="codemirror-addon-mode-simple" at="Foot"></script>
<script asp-name="codemirror-addon-mode-multiplex" at="Foot"></script>
<script asp-name="codemirror-addon-selection-active-line" at="Foot"></script>
<script asp-name="codemirror-mode-css" at="Foot"></script>
<script asp-name="codemirror-mode-htmlmixed" at="Foot"></script>
<script asp-name="codemirror-mode-javascript" at="Foot"></script>
<script asp-name="codemirror-mode-xml" at="Foot"></script>

<script asp-src="~/OrchardCore.Liquid/codemirror/liquid.js" at="Foot"></script>

<style asp-name="bootstrap-select" at="Head"></style>
<script asp-name="bootstrap-select" at="Foot"></script>
<style asp-src="~/OrchardCore.Shortcodes/Styles/shortcodes.min.css" debug-src="~/OrchardCore.Shortcodes/Styles/shortcodes.css" asp-name="shortcodes"></style>
<script asp-src="~/OrchardCore.Shortcodes/Scripts/shortcode-templates.min.js" debug-src="~/OrchardCore.Shortcodes/Scripts/shortcode-templates.js" at="Foot"></script>

<zone Name="Title">
    <breadcrumb name="ShortcodesCreate" title="@T["Create Shortcode"]">
        <breadcrumb-item id="Shortcodes" action="Index" controller="Admin" area="OrchardCore.Shortcodes" permission="@ShortcodesPermissions.ManageShortcodeTemplates.Name">@T["Shortcodes"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div asp-validation-summary="All"></div>
<form asp-action="Create" method="post" class="no-multisubmit">
            <div class="ocat-wrapper" asp-validation-class-for="Name">
                <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
                <div class="ocat-end">
                <input asp-for="Name" class="form-control" autofocus />
                <span asp-validation-for="Name"></span>
                <span class="hint">@T["The name of the shortcode."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="Hint">
                <label asp-for="Hint" class="ocat-label">@T["Hint"]</label>
                <div class="ocat-end">
                <input asp-for="Hint" class="form-control" />
                <span class="hint">@T["The hint for the shortcode."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="Usage">
                <label asp-for="Usage" class="ocat-label">@T["Usage"]</label>
                <div class="ocat-end">
                <textarea asp-for="Usage" rows="10" class="form-control"></textarea>
                <span class="hint">@T["Example usage of the shortcode."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="SelectedCategories">
                <label for="shortcodeCategories" class="ocat-label">@T["Categories"]</label>
                <div class="ocat-end">
                    <input type="hidden" asp-for="SelectedCategories" />
                    <select id="shortcodeCategories" multiple data-shortcode-categories data-values-input="@Html.IdFor(x => x.SelectedCategories)" data-values-format="json" data-live-search="true" data-show-selected-tags="true" data-open-options="true" data-open-options-text="@T["Add the category: {0}", "{0}"]" data-width="100%" placeholder="@T["Type to search"]" data-live-search-placeholder="@T["Search"]" data-none-results-text="@T["No categories match {0}", "{0}"]" data-selected-tag-remove-label="@T["Remove"]">
                        @foreach (var category in categories)
                        {
                            <option value="@category" selected="@selectedCategories.Contains(category, StringComparer.OrdinalIgnoreCase)">@category</option>
                        }
                    </select>
                    <span class="hint">@T["The categories for this shortcode."]</span>
                </div>
            </div>

            <div class="ocat-wrapper" asp-validation-class-for="DefaultValue">
                <label asp-for="DefaultValue" class="ocat-label">@T["Default Shortcode Value"]</label>
                <div class="ocat-end">
                <input asp-for="DefaultValue" class="form-control" />
                <span class="hint">@T["The default value of the shortcode when selected. Defaults to [name]."]</span>
                </div>
            </div>

    <div class="mb-3 d-flex align-items-center justify-content-center">
        <div id="shortcodePreview" style="display: none;">
            @{
                var descriptor = new ShortcodeDescriptor();
                var shape = await ShortcodeDescriptorDisplayManager.BuildDisplayAsync(descriptor, null, "SummaryAdmin");
                shape.Properties["Actions"] = null;
                @await DisplayAsync(shape)
            }
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="Content">
        <label asp-for="Content" class="ocat-label ocat-label-required">@T["Content"]</label>
        <div class="ocat-end">
        <textarea asp-for="Content" rows="10" class="form-control"></textarea>
        <span asp-validation-for="Content"></span>
        <span class="hint">@T["The Shortcode Liquid template."]</span>
        </div>
    </div>

    <div class="action-bar-bottom">
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>

        <div class="btn-group"
             role="group"
             aria-label="@T["Save actions"]"
             data-action-group="oc-shortcode-save-action"
             data-action-default="Save"
             data-label-default="@T["Save"]"
             data-action-alt="SaveAndContinue"
             data-label-alt="@T["Save and continue"]">
            <button type="submit" value="Save" name="submit" class="btn btn-primary save">@T["Save"]</button>
            <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-reference="parent" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <span class="visually-hidden">@T["Toggle Dropdown"]</span>
            </button>
            <div class="dropdown-menu">
                <button class="dropdown-item save-continue" name="submit" type="submit" value="SaveAndContinue">@T["and continue"]</button>
            </div>
        </div>
    </div>
</form>

<script asp-src="~/OrchardCore.Shortcodes/Scripts/shortcode-template-editor/shortcode-template-editor.min.js" debug-src="~/OrchardCore.Shortcodes/Scripts/shortcode-template-editor/shortcode-template-editor.js" at="Foot" type="module"></script>
