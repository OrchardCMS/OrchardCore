@model ShortcodeTemplateIndexViewModel

<zone Name="Title">
    <breadcrumb name="Shortcodes" title="@T["Shortcodes"]" />
</zone>

@* the form is necessary to generate an antiforgery token for the delete action *@
<form asp-action="Index" method="post" class="no-multisubmit bulk-select-list" data-checkbox-name="itemIds" data-bulk-action-name="Options.BulkAction" data-selected-text="@T["selected"]">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input asp-for="Options.BulkAction" type="hidden" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group has-search">
                        <i class="fa-solid fa-search form-control-feedback" aria-hidden="true"></i>
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]">@T["Go"]</button>
                    </div>
                </div>
                <div class="col-auto">
                    <a asp-action="Create" class="btn btn-secondary create" role="button">@T["Add Shortcode Template"]</a>
                </div>
            </div>
        </div>
    </div>

    @* The templates, the toolbar and the pager are rendered by the AdminList shape using the configured layout (List, Grid, ...). *@
    @await DisplayAsync(Model.List)
</form>

<script asp-src="~/OrchardCore.Shortcodes/Scripts/shortcodes-admin-list/shortcodes-admin-list.min.js" debug-src="~/OrchardCore.Shortcodes/Scripts/shortcodes-admin-list/shortcodes-admin-list.js" at="Foot" type="module"></script>
