@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Shortcodes.ViewModels

@model ShapeViewModel<ShortcodeTemplateEntry>

<a asp-action="Edit" asp-controller="Admin" asp-route-name="@Model.Value.Name" class="btn btn-primary btn-sm">@T["Edit"]</a>

<a asp-action="Delete" asp-controller="Admin" asp-route-name="@Model.Value.Name" class="btn btn-danger btn-sm" data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
