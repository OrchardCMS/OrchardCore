@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Shortcodes.ViewModels

@model ShapeViewModel<ShortcodeTemplateEntry>

<div class="form-check">
    <input type="checkbox" class="form-check-input" value="@Model.Value.Name" name="itemIds" id="itemIds-@Model.Value.Name">
    <label class="form-check-label" for="itemIds-@Model.Value.Name">&nbsp;</label>
</div>
