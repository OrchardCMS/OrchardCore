@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Media.ViewModels

@model ShapeViewModel<MediaProfileEntry>

<a asp-action="Edit" asp-controller="MediaProfiles" asp-route-name="@Model.Value.Name" class="btn btn-primary btn-sm">@Localize(CommonLocalizationSources.Edit)</a>

<a asp-action="Delete" asp-controller="MediaProfiles" asp-route-name="@Model.Value.Name" class="btn btn-danger btn-sm" data-url-af="RemoveUrl UnsafeUrl">@Localize(CommonLocalizationSources.Delete)</a>
