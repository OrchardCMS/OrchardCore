@model MediaProfileViewModel

<zone Name="Title">
    <breadcrumb name="MediaProfilesCreate" title="@T["Create Media Profile"]">
        <breadcrumb-item id="MediaProfiles" action="Index" controller="MediaProfiles" area="OrchardCore.Media" permission="@MediaPermissions.ManageMediaProfiles.Name">@T["Media Profiles"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div asp-validation-summary="All"></div>
<form asp-action="Create" method="post" class="no-multisubmit">
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <div class="btn-group"
             role="group"
             aria-label="@T["Save actions"]"
             data-action-group="oc-media-profile-save-action"
             data-action-default="Save"
             data-label-default="@T["Save"]"
             data-action-alt="SaveAndContinue"
             data-label-alt="@T["Save and continue"]">
            <button type="submit" value="Save" name="submit" class="btn btn-success save">@T["Save"]</button>
            <button type="button" class="btn btn-success dropdown-toggle dropdown-toggle-split" data-reference="parent" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <span class="visually-hidden">@T["Toggle Dropdown"]</span>
            </button>
            <div class="dropdown-menu">
                <button class="dropdown-item save-continue" name="submit" type="submit" value="SaveAndContinue">@T["and continue"]</button>
            </div>
        </div>

        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>

<script asp-src="~/OrchardCore.Media/Scripts/media-profile-editor/media-profile-editor.min.js" debug-src="~/OrchardCore.Media/Scripts/media-profile-editor/media-profile-editor.js" at="Foot" type="module"></script>
