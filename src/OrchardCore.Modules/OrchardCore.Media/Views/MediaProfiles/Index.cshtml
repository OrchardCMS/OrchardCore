@using OrchardCore.Admin.Models
@using OrchardCore.Admin
@model MediaProfileIndexViewModel

<zone Name="Title">
    <breadcrumb name="MediaProfiles" title="@T["Media Profiles"]" />
</zone>

@* the form is necessary to generate an antiforgery token for the delete action *@
<form asp-action="Index" method="post" class="no-multisubmit bulk-select-list" data-selected-text="@T["selected"]">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input asp-for="Options.BulkAction" type="hidden" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <a asp-action="Create" class="btn btn-secondary create" role="button">@T["Add Media Profile"]</a>
                </div>
            </div>
        </div>
    </div>

    @* The profiles, the toolbar and the pager are rendered by the AdminList shape using the configured layout (List, Grid, ...). *@
    <admin-list name="MediaProfiles" context="Model.List"
                bulk-actions="Model.Options.ContentsBulkAction"
                empty-message="@T["<strong>Nothing here!</strong> There are no media profiles for the moment."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column type="Select" />
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</form>

<script asp-src="~/OrchardCore.Media/Scripts/media-profiles-index/media-profiles-index.min.js" debug-src="~/OrchardCore.Media/Scripts/media-profiles-index/media-profiles-index.js" at="Foot" type="module"></script>
