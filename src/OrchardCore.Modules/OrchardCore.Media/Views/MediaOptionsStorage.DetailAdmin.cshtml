@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Media.ViewModels

@model ShapeViewModel<MediaOptionsViewModel>

<div class="ocat-wrapper">
    <div class="ocat-label">@T["Storage provider"]</div>
    <div class="ocat-end">
        <div><code>@Model.Value.StorageName</code></div>
        <span class="hint">@T["The name of the configured media storage provider."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-label">@T["Hierarchical namespace"]</div>
    <div class="ocat-end">
        <div>
            <i class="fa-solid @(Model.Value.HasHierarchicalNamespace ? "fa-check text-success" : "fa-xmark text-danger")" aria-hidden="true"></i>
            <span class="visually-hidden">@T[Model.Value.HasHierarchicalNamespace ? "Yes" : "No"]</span>
        </div>
        <span class="hint">@T["Indicates whether the storage provider supports a true hierarchical folder structure."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-label">@T["Atomic move"]</div>
    <div class="ocat-end">
        <div>
            <i class="fa-solid @(Model.Value.SupportsAtomicMove ? "fa-check text-success" : "fa-xmark text-danger")" aria-hidden="true"></i>
            <span class="visually-hidden">@T[Model.Value.SupportsAtomicMove ? "Yes" : "No"]</span>
        </div>
        <span class="hint">@T["Indicates whether the storage provider supports atomic move operations."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-label">@T["SignalR"]</div>
    <div class="ocat-end">
        <div>
            <i class="fa-solid @(Model.Value.SignalrEnabled ? "fa-check text-success" : "fa-xmark text-danger")" aria-hidden="true"></i>
            <span class="visually-hidden">@T[Model.Value.SignalrEnabled ? "Yes" : "No"]</span>
        </div>
        <span class="hint">@T["Indicates whether SignalR is enabled for real-time media updates."]</span>
    </div>
</div>
