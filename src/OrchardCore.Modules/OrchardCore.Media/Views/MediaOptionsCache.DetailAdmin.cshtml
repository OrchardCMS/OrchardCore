@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Media.ViewModels

@model ShapeViewModel<MediaOptionsViewModel>

<div class="ocat-wrapper">
    <div class="ocat-label">@T["Max browser cache days"]</div>
    <div class="ocat-end">
        <div><code>@Model.Value.Options.MaxBrowserCacheDays</code></div>
        <span class="hint">@T["The default number of days for the media cache control header."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-label">@T["Max secure files browser cache days"]</div>
    <div class="ocat-end">
        <div><code>@Model.Value.Options.MaxSecureFilesBrowserCacheDays</code></div>
        <span class="hint">@T["The default number of days for the media cache control header for secure files."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-label">@T["Max cache days"]</div>
    <div class="ocat-end">
        <div><code>@Model.Value.Options.MaxCacheDays</code></div>
        <span class="hint">@T["The maximum number of days a cached resized media item will be valid for, before being rebuilt on request."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-label">@T["Cdn base url"]</div>
    <div class="ocat-end">
        <div><code>@Model.Value.Options.CdnBaseUrl</code></div>
        <span class="hint">@T["A CDN base url that will be prefixed to the request path when serving images."]</span>
    </div>
</div>
