@model OrchardCore.Media.ViewModels.EditMediaFieldViewModel
@inject IDataLocalizer D
@inject IOptions<MediaOptions> MediaOptions
@inject Microsoft.AspNetCore.Authorization.IAuthorizationService AuthorizationService
@{
    var tusEnabled = Context.RequestServices.IsMediaTusEnabled();
    var signalrEnabled = Context.RequestServices.IsMediaSignalREnabled();
    var apiAuthScheme = Context.RequestServices.GetRequiredService<ISiteService>().GetSettings<MediaApiSettings>().AuthenticationScheme.ToString();
    var settings = Model.PartFieldDefinition.GetSettings<MediaFieldSettings>();
    var fieldId = Html.IdFor(m => m);
    var jsLocalizations = Orchard.GetJSLocalizations("media-field");
    var mediaAppLocalizations = Orchard.GetJSLocalizations("media-gallery");
    var translationsJson = System.Text.Json.JsonSerializer.Serialize(jsLocalizations);
    var mediaAppTranslationsJson = System.Text.Json.JsonSerializer.Serialize(mediaAppLocalizations);
    var canUploadRestrictedMedia = await AuthorizationService.AuthorizeAsync(User, MediaPermissions.UploadRestrictedMedia);
    var allowedExtensionsAttribute = Model.AllowedExtensions.Length > 0
        ? string.Join(',', Model.AllowedExtensions.Where(extension => MediaOptions.Value.IsFileExtensionAllowed(extension, canUploadRestrictedMedia)))
        : string.Join(',', MediaOptions.Value.AllowedFileExtensions);
    if (Model.AllowedExtensions.Length == 0 && canUploadRestrictedMedia && MediaOptions.Value.RestrictedFileExtensions.Count > 0)
    {
        allowedExtensionsAttribute += (allowedExtensionsAttribute.Length > 0 ? "," : string.Empty)
            + string.Join(',', MediaOptions.Value.RestrictedFileExtensions);
    }
    if (allowedExtensionsAttribute.Length == 0)
    {
        allowedExtensionsAttribute = ".__none__";
    }
    string localizedFieldName = D[Model.PartFieldDefinition.DisplayName(), DataLocalizationContext.ContentField(Model.PartFieldDefinition.PartDefinition.Name)];
}

<style asp-name="media" at="Head"></style>
<style asp-name="media-picker" at="Head"></style>

<div class="@($"ocat-wrapper field-wrapper field-wrapper-{Model.PartFieldDefinition.PartDefinition.Name.HtmlClassify()}-{Model.PartFieldDefinition.Name.HtmlClassify()}" + (Model.PartFieldDefinition.IsNamedPart() ? $" field-wrapper-{Model.PartFieldDefinition.ContentTypePartDefinition.Name.HtmlClassify()}-{Model.PartFieldDefinition.Name.HtmlClassify()}" : string.Empty))" id="@Html.IdFor(x => x.Paths)_FieldWrapper">
    <label asp-for="Paths" class="ocat-label @(settings.Required ? "ocat-label-required" : "")">@localizedFieldName</label>
    <div class="ocat-end" id="@fieldId" data-for="@Html.IdFor(m => m.Paths)">
        @if (!string.IsNullOrWhiteSpace(settings.Hint))
        {
            @await DisplayAsync(await New.Hint_Admin(Hint: settings.Hint))
        }

        <div id="@fieldId"
             class="media-field-app"
             data-media-field-type="gallery"
             data-input-name="@Html.NameFor(m => m.Paths)"
             data-paths="@Model.Paths"
             data-multiple="@(settings.Multiple ? "true" : "false")"
             data-allow-media-text="@(settings.AllowMediaText ? "true" : "false")"
             data-allow-anchors="@(settings.AllowAnchors ? "true" : "false")"
             data-allowed-extensions="@allowedExtensionsAttribute"
             data-media-item-url="@Url.Content("~/api/media/GetMediaItem")"
             data-media-items-url="@Url.Content("~/api/media/GetMediaFieldItems")"
             data-media-gallery-translations="@mediaAppTranslationsJson"
             data-base-path="@Url.Content("~/")"
             data-api-auth-scheme="@apiAuthScheme"
             data-upload-files-url="@Url.Content("~/api/media/Upload")"
             data-tus-enabled="@(tusEnabled ? "true" : "false")"
             data-tus-endpoint-url="@Url.Content("~/api/media/tus")"
             data-tus-file-info-url="@Url.Content("~/api/media/TusFileInfo")"
             data-signalr-enabled="@(signalrEnabled ? "true" : "false")"
             data-translations="@translationsJson">
        </div>

        <span asp-validation-for="Paths"></span>
    </div>
</div>

<script asp-name="media-picker" at="Foot"></script>
