@using System.Globalization

@model PublishLaterPartViewModel

@if (Model.ScheduledPublishUtc.HasValue)
{
    var scheduledUtc = Model.ScheduledPublishUtc.Value.ToString("yyyy-MM-ddTHH:mm:sszzz", CultureInfo.InvariantCulture);

    @* A fact about the item, so it reads as a badge like the other facts of the row. *@
    <span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Scheduled to be published on {0}", (object)(await DisplayAsync(await New.DateTime(Utc: Model.ScheduledPublishUtc, Format: "g")))]">
        <i class="fa-solid fa-clock text-secondary" aria-hidden="true"></i> <time datetime="@scheduledUtc">@await DisplayAsync(await New.Timespan(Utc: Model.ScheduledPublishUtc))</time>
    </span>
}
