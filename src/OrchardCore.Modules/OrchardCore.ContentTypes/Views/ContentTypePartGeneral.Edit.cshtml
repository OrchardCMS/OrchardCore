@model EditTypePartViewModel
@using OrchardCore.ContentManagement.Metadata.Settings
@using OrchardCore.DisplayManagement

@{
    var isReusable = Model.TypePartDefinition.PartDefinition.IsReusable();
}

@if (isReusable)
{
    <div class="ocat-limited-wrapper">
        <label asp-for="DisplayName" class="ocat-label ocat-label-required">@T["Display Name"]</label>
        <div class="ocat-limited">
            <input asp-for="DisplayName" class="form-control" />
            <span class="hint">@T["Name of the part as it will be displayed in screens."]</span>
        </div>
    </div>

    <div class="ocat-limited-wrapper">
        <label asp-for="Description" class="ocat-label">@T["Description"]</label>
        <div class="ocat-limited">
            <input asp-for="Description" class="form-control" />
            <span class="hint">@T["The description of the part as it will be displayed in screens."]</span>
        </div>
    </div>
}

@if (Model.EditorShapes.Any())
{
    <div class="ocat-wrapper">
        <label asp-for="Editor" class="ocat-label">@T["What type of editor should be used?"]</label>
        <div class="ocat-end">
            <select asp-for="Editor" class="form-select" data-type-part-editor-select>
                @foreach (var editorShape in Model.EditorShapes)
                {
                    var shape = await Factory.CreateAsync(editorShape);
                    shape.Properties["Editor"] = Model.Editor;
                    @await DisplayAsync(shape)
                }
            </select>
        </div>
    </div>
}

@if (Model.DisplayShapes.Any())
{
    <div class="ocat-wrapper">
        <label asp-for="DisplayMode" class="ocat-label">@T["What type of display mode should be used?"]</label>
        <div class="ocat-end">
            <select asp-for="DisplayMode" class="form-select" data-type-part-display-select>
                @foreach (var displayShape in Model.DisplayShapes)
                {
                    var shape = await Factory.CreateAsync(displayShape);
                    shape.Properties["DisplayMode"] = Model.DisplayMode;
                    @await DisplayAsync(shape)
                }
            </select>
        </div>
    </div>
}
