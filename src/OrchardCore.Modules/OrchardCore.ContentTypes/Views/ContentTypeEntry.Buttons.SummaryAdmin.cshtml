@using OrchardCore.ContentManagement.Metadata.Settings
@using OrchardCore.ContentTypes.Models
@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Localization.Data

@inject IDataLocalizer D

@model ShapeViewModel<ContentTypeEntry>

@{
    var entry = Model.Value;
    var settings = entry.TypeDefinition.GetSettings<ContentTypeSettings>();
    var contentSettings = entry.TypeDefinition.GetSettings<ContentSettings>();
    string localizedDisplayName = D[entry.DisplayName, "Content Types"];
}

@if (settings.Creatable)
{
    <a id="btn-create-@entry.Name" asp-route-area="OrchardCore.Contents" asp-route-action="Create" asp-route-id="@entry.Name" asp-route-returnUrl="@FullRequestPath" class="btn btn-success btn-sm">@T["Create New {0}", localizedDisplayName]</a>
}

<a role="btn-list-@entry.Name" asp-route-action="List" asp-route-area="OrchardCore.Contents" asp-route-contentTypeId="@entry.Name" class="btn btn-secondary btn-sm">@T["List Items"]</a>

<a role="btn-edit-@entry.Name" asp-route-action="Edit" asp-route-area="OrchardCore.ContentTypes" asp-route-id="@entry.Name" class="btn btn-primary btn-sm edit-button list-item-action">@T["Edit"]</a>

@if (contentSettings.IsSystemDefined)
{
    <div class="d-inline" data-bs-toggle="tooltip" data-bs-title="@T["System-defined types are integral components of the system and cannot be removed."]">
        <button type="button" class="btn btn-sm btn-danger" disabled>
            @T["Delete"]
        </button>
    </div>
}
else
{
    <a role="btn-delete-@entry.Name" asp-route-action="Delete" asp-route-area="OrchardCore.ContentTypes" asp-route-id="@entry.Name" asp-route-returnUrl="@FullRequestPath" class="btn btn-danger btn-sm" data-url-af="RemoveUrl UnsafeUrl" data-title="@T["Delete"]" data-message="@T["Are you sure you want to delete this content type?"]" data-ok-text="@T["Ok"]" data-cancel-text="@T["Cancel"]">@T["Delete"]</a>
}
