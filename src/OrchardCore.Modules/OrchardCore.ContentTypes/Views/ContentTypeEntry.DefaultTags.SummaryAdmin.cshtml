@using OrchardCore.ContentManagement.Metadata.Settings
@using OrchardCore.ContentTypes.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<ContentTypeEntry>

@{
    var settings = Model.Value.TypeDefinition.GetSettings<ContentTypeSettings>();
}

<span class="badge rounded-pill ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Technical Name"]"><i class="fa-solid fa-file-alt text-danger" aria-hidden="true"></i> @Model.Value.Name</span>

@if (!string.IsNullOrWhiteSpace(settings.Stereotype))
{
    <span class="badge rounded-pill ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Stereotype"]"><i class="fa-solid fa-file text-info" aria-hidden="true"></i> @settings.Stereotype</span>
}
