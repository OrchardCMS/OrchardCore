@using OrchardCore.Mvc.Utilities
@using OrchardCore.ContentManagement.Metadata.Settings
@using OrchardCore.Localization.Data

@model AddFieldViewModel
@inject OrchardCore.ContentManagement.Metadata.IContentDefinitionManager ContentDefinitionManager
@inject IDataLocalizer D

@{
    var returnUrl = ViewData["returnUrl"]?.ToString();
    string localizedPartName = D[Model.Part.DisplayName(), "Content Types"];

    // A part named after a content type holds that type's own fields, which are added from the type editor, so the
    // trail leads back through the type rather than through the list of parts.
    var typeDefinition = await ContentDefinitionManager.GetTypeDefinitionAsync(Model.Part.Name);
}

<script asp-src="~/OrchardCore.ContentTypes/Scripts/autocomplete/autocomplete.js" at="Foot"></script>
<zone Name="Title">
    <breadcrumb name="ContentTypesAddField" title="@T["Add New Field To \"{0}\"", localizedPartName]">
        @if (typeDefinition is not null)
        {
            <breadcrumb-item id="ContentTypes" action="List" controller="Admin" area="OrchardCore.ContentTypes" permission="@ContentTypesPermissions.ViewContentTypes.Name">@T["Content Types"]</breadcrumb-item>
            <breadcrumb-item id="ContentType" action="Edit" controller="Admin" area="OrchardCore.ContentTypes" route-id="@typeDefinition.Name" permission="@ContentTypesPermissions.EditContentTypes.Name">@T["Edit Content Type - {0}", D[typeDefinition.DisplayName, "Content Types"]]</breadcrumb-item>
        }
        else
        {
            <breadcrumb-item id="ContentParts" action="ListParts" controller="Admin" area="OrchardCore.ContentTypes" permission="@ContentTypesPermissions.ViewContentTypes.Name">@T["Content Parts"]</breadcrumb-item>
            <breadcrumb-item id="ContentPart" action="EditPart" controller="Admin" area="OrchardCore.ContentTypes" route-id="@Model.Part.Name" permission="@ContentTypesPermissions.EditContentTypes.Name">@T["Edit Content Part - {0}", localizedPartName]</breadcrumb-item>
        }
    </breadcrumb>
</zone>

<form asp-action="AddFieldTo" asp-route-returnUrl="@ViewData["returnUrl"]">
    @Html.ValidationSummary()

    <div class="ocat-limited-wrapper">
        <label asp-for="DisplayName" class="ocat-label">@T["Display Name"]</label>
        <div class="ocat-limited">
            <input data-displayname="@Html.IdFor(m => m.DisplayName)" asp-for="DisplayName" class="form-control" autofocus />
            <span class="hint">@T["Name of the field as it will be displayed in screens."]</span>
        </div>
    </div>

    <div class="ocat-limited-wrapper">
        <label asp-for="Name" class="ocat-label">@T["Technical Name"]</label>
        <div class="ocat-limited">
            <input data-name="@Html.IdFor(m => m.DisplayName)" asp-for="Name" class="form-control" />
            <span class="hint">@T["Technical name of the field."]</span>
        </div>
    </div>

    <div class="ocat-limited-wrapper">
        <label asp-for="FieldTypeName" class="ocat-label">@T["Field Type"]</label>
        <div class="ocat-limited">
            <ul class="list-group">
                @for (var i = 0; i < Model.Fields.Count; i++)
                {
                    <li class="list-group-item list-group-item-action">
                        <div class="form-check">
                            <input type="radio" class="form-check-input" asp-for="FieldTypeName" id="@Html.IdFor(m => m.Fields[i])" value="@Model.Fields[i]" checked="@(i == 0)">
                            <label class="form-check-label" asp-for="Fields[i]">@Model.Fields[i].CamelFriendly()</label>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary save" type="submit" name="submit.Save" value="Save">@T["Save"]</button>
            <button class="btn btn-secondary" type="submit" name="submit.Save" value="SaveAndConfigure">@T["Save &amp; Configure"]</button>
            @if (Url.IsLocalUrl(returnUrl))
            {
                <a class="btn btn-secondary cancel" role="button" href="@returnUrl">@T["Cancel"]</a>
            }
        </div>
    </div>
</form>
