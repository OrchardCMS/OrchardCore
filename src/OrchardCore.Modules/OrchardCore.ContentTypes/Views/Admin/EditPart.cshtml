@model EditPartViewModel
@using OrchardCore.Localization.Data

@inject IDataLocalizer D

@{
    string localizedPartName = D[Model.DisplayName, "Content Types"];
}
<zone Name="Title">
    <breadcrumb name="ContentPartsEdit" title="@T["Edit Content Part - {0}", localizedPartName]">
        <breadcrumb-item id="ContentParts" action="ListParts" controller="Admin" area="OrchardCore.ContentTypes" permission="@ContentTypesPermissions.ViewContentTypes.Name">@T["Content Parts"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="EditPart">
    @Html.ValidationSummary()

    @if (Model.Editor.Shortcuts != null)
    {
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                @await DisplayAsync(Model.Editor.Shortcuts)
            </div>
        </div>
    }

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary save" type="submit" name="submit.Save" value="Save">@T["Save"]</button>
        <a role="button" asp-route-action="DeletePart" asp-route-id="@Model.Name" class="btn btn-danger action-bar-secondary" data-url-af="RemoveUrl UnsafeUrl" data-title="@T["Delete"]" data-message="@T["Are you sure you want to delete this content part?"]" data-ok-text="@T["Ok"]" data-cancel-text="@T["Cancel"]">@T["Delete"]</a>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="ListParts">@T["Cancel"]</a>
    </div>
</form>
<script asp-name="Sortable" at="Foot"></script>
<script asp-src="~/OrchardCore.ContentTypes/Scripts/content-type-sortable/content-type-sortable.min.js" debug-src="~/OrchardCore.ContentTypes/Scripts/content-type-sortable/content-type-sortable.js" depends-on="Sortable" at="Foot" type="module"></script>
