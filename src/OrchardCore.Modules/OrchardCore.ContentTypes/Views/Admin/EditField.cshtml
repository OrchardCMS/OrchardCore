@using OrchardCore.Mvc.Utilities
@using OrchardCore.ContentManagement.Metadata.Settings
@using OrchardCore.ContentManagement.Metadata.Models
@using OrchardCore.DisplayManagement
@using OrchardCore.Localization.Data
@using OrchardCore.DisplayManagement.Theming

@model EditFieldViewModel

@inject IThemeManager ThemeManager
@inject OrchardCore.DisplayManagement.Descriptors.IShapeTableManager ShapeTableManager
@inject OrchardCore.ContentManagement.Metadata.IContentDefinitionManager ContentDefinitionManager
@inject IDataLocalizer D

@{
    var shapeTable = await ThemeManager.GetShapeTableAsync(ShapeTableManager);
    var editorShapes = shapeTable.Bindings.Keys.Where(x => x.StartsWith(Model.PartFieldDefinition.FieldDefinition.Name + "_Option__", StringComparison.OrdinalIgnoreCase) || x.Equals(Model.PartFieldDefinition.FieldDefinition.Name + "_Option", StringComparison.OrdinalIgnoreCase));
    var displayShapes = shapeTable.Bindings.Keys.Where(x => x.StartsWith(Model.PartFieldDefinition.FieldDefinition.Name + "_DisplayOption__", StringComparison.OrdinalIgnoreCase) || x.Equals(Model.PartFieldDefinition.FieldDefinition.Name + "_DisplayOption", StringComparison.OrdinalIgnoreCase));
    var returnUrl = ViewData["returnUrl"]?.ToString();
    var fieldContext = $"Content Fields{Constants.ContextSeparator}{Model.PartFieldDefinition.PartDefinition.Name}";
    string localizedFieldName = D[Model.DisplayName, fieldContext];
    string localizedPartName = D[Model.PartFieldDefinition.PartDefinition.DisplayName(), "Content Types"];

    // A part named after a content type holds that type's own fields, which are edited from the type editor, so the
    // trail leads back through the type rather than through the list of parts.
    var typeDefinition = await ContentDefinitionManager.GetTypeDefinitionAsync(Model.PartFieldDefinition.PartDefinition.Name);
}

<zone Name="Title">
    <breadcrumb name="ContentPartsEditField" title="@T["\"{0}\" settings", localizedFieldName]">
        @if (typeDefinition is not null)
        {
            <breadcrumb-item id="ContentTypes" action="List" controller="Admin" area="OrchardCore.ContentTypes" permission="@ContentTypesPermissions.ViewContentTypes.Name">@T["Content Types"]</breadcrumb-item>
            <breadcrumb-item id="ContentType" action="Edit" controller="Admin" area="OrchardCore.ContentTypes" route-id="@typeDefinition.Name" permission="@ContentTypesPermissions.EditContentTypes.Name">@T["Edit Content Type - {0}", D[typeDefinition.DisplayName, "Content Types"]]</breadcrumb-item>
        }
        else
        {
            <breadcrumb-item id="ContentParts" action="ListParts" controller="Admin" area="OrchardCore.ContentTypes" permission="@ContentTypesPermissions.ViewContentTypes.Name">@T["Content Parts"]</breadcrumb-item>
            <breadcrumb-item id="ContentPart" action="EditPart" controller="Admin" area="OrchardCore.ContentTypes" route-id="@Model.PartFieldDefinition.PartDefinition.Name" permission="@ContentTypesPermissions.EditContentTypes.Name">@T["Edit Content Part - {0}", localizedPartName]</breadcrumb-item>
        }
    </breadcrumb>
</zone>

<form asp-action="EditField" asp-route-returnUrl="@ViewData["returnUrl"]">
    @Html.ValidationSummary()

    <div class="ocat-limited-wrapper">
        <label asp-for="DisplayName" class="ocat-label">@T["Display Name"]</label>
        <div class="ocat-limited">
            <input asp-for="DisplayName" autofocus class="form-control" />
            <span class="hint">@T["Name of the field as it will be displayed in screens."]</span>
        </div>
    </div>

    <div class="ocat-limited-wrapper">
        <label asp-for="Name" class="ocat-label">@T["Technical Name"]</label>
        <div class="ocat-limited">
            <input asp-for="Name" class="form-control" readonly />
            <span class="hint">@T["Technical name of the field."]</span>
        </div>
    </div>

    @if (Model.Shape.Shortcuts != null)
    {
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                @await DisplayAsync(Model.Shape.Shortcuts)
            </div>
        </div>
    }

    @if (Model.Shape.Content != null)
    {
        @await DisplayAsync(Model.Shape.Content)

        @if (editorShapes.Any())
        {
            <div class="ocat-wrapper">
                <label asp-for="Editor" class="ocat-label">@T["What type of editor should be used?"]</label>
                <div class="ocat-end">
                    <select asp-for="Editor" class="form-select" id="field-editor-select">
                        @foreach (var editorShape in editorShapes)
                        {
                            var shape = await Factory.CreateAsync(editorShape);
                            shape.Properties["Editor"] = Model.Editor;
                            @await DisplayAsync(shape)
                        }
                    </select>
                </div>
            </div>
        }

        <div id="field-editor-container" style="display: none">
            @await DisplayAsync(Model.Shape.Editor)
        </div>

        @if (displayShapes.Any())
        {
            <div class="ocat-wrapper">
                <label asp-for="DisplayMode" class="ocat-label">@T["What type of display mode should be used?"]</label>
                <div class="ocat-end">
                    <select asp-for="DisplayMode" class="form-select" id="field-display-select">
                        @foreach (var displayShape in displayShapes)
                        {
                            var shape = await Factory.CreateAsync(displayShape);
                            shape.Properties["DisplayMode"] = Model.DisplayMode;
                            @await DisplayAsync(shape)
                        }
                    </select>
                </div>
            </div>
        }

        <div id="field-display-container" style="display: none">
            @await DisplayAsync(Model.Shape.DisplayMode)
        </div>
    }

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary save" type="submit" name="submit.Save" value="Save">@T["Save"]</button>
            @if (Url.IsLocalUrl(returnUrl))
            {
                <a class="btn btn-secondary cancel" role="button" href="@returnUrl">@T["Cancel"]</a>
            }
        </div>
    </div>
</form>

<script asp-src="~/OrchardCore.ContentTypes/Scripts/content-type-editors/edit-field-selector.min.js" debug-src="~/OrchardCore.ContentTypes/Scripts/content-type-editors/edit-field-selector.js" at="Foot" type="module"></script>
