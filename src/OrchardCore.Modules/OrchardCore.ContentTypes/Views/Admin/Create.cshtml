@model CreateTypeViewModel

<script asp-src="~/OrchardCore.ContentTypes/Scripts/autocomplete/autocomplete.js" at="Foot"></script>
<zone Name="Title">
    <breadcrumb name="ContentTypesCreate" title="@T["New Content Type"]">
        <breadcrumb-item id="ContentTypes" action="List" controller="Admin" area="OrchardCore.ContentTypes" permission="@ContentTypesPermissions.ViewContentTypes.Name">@T["Content Types"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="Create">
    @Html.ValidationSummary()

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary create" type="submit">@T["Create"]</button>
    </div>
</form>
