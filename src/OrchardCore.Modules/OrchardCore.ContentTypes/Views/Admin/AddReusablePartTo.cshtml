@model AddReusablePartViewModel
@using OrchardCore.Localization.Data
@inject IDataLocalizer D
@{
    string localizedTypeName = D[Model.Type.DisplayName, "Content Types"];
}

<script asp-src="~/OrchardCore.ContentTypes/Scripts/autocomplete/autocomplete.js" at="Foot"></script>
<zone Name="Title">
    <breadcrumb name="ContentTypesAddReusablePart" title="@T["Add Named Part"]">
        <breadcrumb-item id="ContentTypes" action="List" controller="Admin" area="OrchardCore.ContentTypes" permission="@ContentTypesPermissions.ViewContentTypes.Name">@T["Content Types"]</breadcrumb-item>
        <breadcrumb-item id="ContentType" action="Edit" controller="Admin" area="OrchardCore.ContentTypes" route-id="@Model.Type.Name" permission="@ContentTypesPermissions.EditContentTypes.Name">@T["Edit Content Type - {0}", localizedTypeName]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="AddReusablePartTo">
    @Html.ValidationSummary()

    @if (!Model.PartSelections.Any())
    {
        <p class="alert alert-warning">@T["There are no available named parts."]</p>
    }

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        @if (Model.PartSelections.Any())
        {
            <button class="btn btn-primary save" type="submit" name="submit.Save" value="Save">@T["Save"]</button>
            <button class="btn btn-secondary action-bar-secondary" type="submit" name="submit.Save" value="SaveAndConfigure">@T["Save &amp; Configure"]</button>
        }
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Edit" asp-route-id="@Model.Type.Name">@T["Cancel"]</a>
    </div>
</form>
