@model CreatePartViewModel

<zone Name="Title">
    <breadcrumb name="ContentPartsCreate" title="@T["New Content Part"]">
        <breadcrumb-item id="ContentParts" action="ListParts" controller="Admin" area="OrchardCore.ContentTypes" permission="@ContentTypesPermissions.ViewContentTypes.Name">@T["Content Parts"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="CreatePart">
    @Html.ValidationSummary()

    <div class="ocat-limited-wrapper">
        <label asp-for="Name" class="ocat-label">@T["Name"]</label>
        <div class="ocat-limited">
            <input asp-for="Name" class="form-control" autofocus="autofocus" />
            <span class="hint">@T["Use no spaces or special characters. For example, \"MyCustomPart\""]</span>
        </div>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary create" type="submit">@T["Create"]</button>
        </div>
    </div>
</form>
