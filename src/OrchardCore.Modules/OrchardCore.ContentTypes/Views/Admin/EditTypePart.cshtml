@model EditTypePartViewModel
@using OrchardCore.Localization.Data

@inject IDataLocalizer D

@{
    var typePart = Model.TypePartDefinition;
    string localizedDisplayName = D[Model.DisplayName, "Content Types"];
    var contentTypeDefinition = typePart.ContentTypeDefinition;
    string localizedTypeName = D[contentTypeDefinition.DisplayName, "Content Types"];

    // The settings of the part are only rendered when the part has settings.
    bool hasContent = Model.Shape.Content != null;
}

<zone Name="Title">
    <breadcrumb name="ContentTypesEditPart" title="@T["Edit Part - {0}", localizedDisplayName]">
        <breadcrumb-item id="ContentTypes" action="List" controller="Admin" area="OrchardCore.ContentTypes" permission="@ContentTypesPermissions.ViewContentTypes.Name">@T["Content Types"]</breadcrumb-item>
        <breadcrumb-item id="ContentType" action="Edit" controller="Admin" area="OrchardCore.ContentTypes" route-id="@contentTypeDefinition.Name" permission="@ContentTypesPermissions.EditContentTypes.Name">@T["Edit Content Type - {0}", localizedTypeName]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="alert alert-success" role="alert">
    @T["Some part settings common to all types can also be defined at the <a href=\"{0}\">Part Definition</a> level.", Url.Action("EditPart", new { id = typePart.PartDefinition.Name })]
</div>

<form asp-action="EditTypePart">
    @Html.ValidationSummary()

    @if (hasContent && Model.Shape.Shortcuts != null)
    {
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                @await DisplayAsync(Model.Shape.Shortcuts)
            </div>
        </div>
    }

    @* The common settings of the part, in the "General" card of the header zone. The settings of the other modules are cards of the zones rendered below. *@
    @await DisplayAsync(Model.Shape.Header)

    @if (hasContent)
    {
        @* The settings of the selected editor follow its selection, before the settings of the part. *@
        <div id="type-part-editor-container" style="display: none">
            @await DisplayAsync(Model.Shape.Editor)
        </div>

        @await DisplayAsync(Model.Shape.Content)

        <div id="type-part-display-container" style="display: none">
            @await DisplayAsync(Model.Shape.DisplayMode)
        </div>
    }

    <div class="action-bar-bottom">
        <button class="btn btn-primary save" type="submit" name="submit.Save" value="Save">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Edit" asp-route-id="@Model.TypePartDefinition.ContentTypeDefinition.Name">@T["Cancel"]</a>
    </div>
</form>

<script asp-src="~/OrchardCore.ContentTypes/Scripts/content-type-editors/edit-type-part-selector.min.js" debug-src="~/OrchardCore.ContentTypes/Scripts/content-type-editors/edit-type-part-selector.js" at="Foot" type="module"></script>
