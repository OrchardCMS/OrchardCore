@using OrchardCore.ContentManagement.Metadata.Settings
@using OrchardCore.Localization.Data

@model EditTypeViewModel

@inject IDataLocalizer D

@{
    var contentSettings = Model.TypeDefinition.GetSettings<ContentSettings>();
    string localizedTypeName = D[Model.TypeDefinition.DisplayName, DataLocalizationContext.ContentType];
}

<zone Name="Title">
    <breadcrumb name="ContentTypesEdit" title="@T["Edit Content Type - {0}", localizedTypeName]">
        <breadcrumb-item id="ContentTypes" action="List" controller="Admin" area="OrchardCore.ContentTypes" permission="@ContentTypesPermissions.ViewContentTypes.Name">@T["Content Types"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post">
    @Html.ValidationSummary()

    <input type="hidden" asp-for="Name" />

    @if (Model.Editor.Shortcuts != null)
    {
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                @await DisplayAsync(Model.Editor.Shortcuts)
            </div>
        </div>
    }

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <div class="btn-group"
             role="group"
             aria-label="@T["Save actions"]"
             data-action-group="oc-content-type-save-action"
             data-action-default="Save"
             data-label-default="@T["Save"]"
             data-action-alt="SaveAndContinue"
             data-label-alt="@T["Save and continue"]">
            <button asp-route-action="Edit" class="btn btn-success save" type="submit" name="submit.Save" value="Save">@T["Save"]</button>
            <button type="button" class="btn btn-success dropdown-toggle dropdown-toggle-split" data-reference="parent" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <span class="visually-hidden">@T["Toggle Dropdown"]</span>
            </button>
            <div class="dropdown-menu">
                <button asp-route-action="Edit" class="dropdown-item save-continue" type="submit" name="submit.Save" value="SaveAndContinue">@T["and continue"]</button>
            </div>
        </div>
        @if (contentSettings.IsSystemDefined)
        {
            <div class="d-inline action-bar-secondary" data-bs-toggle="tooltip" data-bs-title="@T["System-defined types are integral components of the system and cannot be removed."]">
                <button type="button" class="btn btn-danger" disabled>
                    @T["Delete"]
                </button>
            </div>
        }
        else
        {
            <a role="button" asp-route-action="Delete" asp-route-id="@Model.Name" class="btn btn-danger action-bar-secondary" data-url-af="RemoveUrl UnsafeUrl" data-title="@T["Delete"]" data-message="@T["Are you sure you want to delete this content type?"]" data-ok-text="@T["Ok"]" data-cancel-text="@T["Cancel"]">@T["Delete"]</a>
        }
        <a class="btn btn-secondary cancel" role="button" asp-route-action="List">@T["Cancel"]</a>
    </div>
</form>
<script asp-name="Sortable" at="Foot"></script>
<script asp-src="~/OrchardCore.ContentTypes/Scripts/content-type-sortable/content-type-sortable.min.js" debug-src="~/OrchardCore.ContentTypes/Scripts/content-type-sortable/content-type-sortable.js" depends-on="Sortable" at="Foot" type="module"></script>
