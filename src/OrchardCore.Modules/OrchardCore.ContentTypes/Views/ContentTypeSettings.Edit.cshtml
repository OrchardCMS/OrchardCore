@model ContentTypeSettingsViewModel

<div class="ocat-limited-wrapper">
    <label asp-for="Description" class="ocat-label">@T["Description"]</label>
    <div class="ocat-limited">
        <input asp-for="Description" type="text" class="form-control">
        <span class="hint">@T["(Optional) Description of the content type"]</span>
    </div>
</div>

<div class="ocat-limited-wrapper">
    <label asp-for="Stereotype" class="ocat-label">@T["Stereotype"]</label>
    <div class="ocat-limited">
        <input asp-for="Stereotype" list="stereotypeOptions" type="text" class="form-control">
        <datalist id="stereotypeOptions">
            @foreach (var item in Model.Options.Stereotypes)
            {
                <option value="@item.Stereotype">@item.DisplayName</option>
            }
        </datalist>
        <span class="hint">@T["(Optional) The stereotype of the content type. e.g., Widget, MenuItem, ..."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper">
    <label asp-for="Category" class="ocat-label">@T["Category"]</label>
    <div class="ocat-limited">
        <input asp-for="Category" list="categoryOptions" type="text" class="form-control">
        <datalist id="categoryOptions">
            @foreach (var category in Model.Options.Categories ?? Enumerable.Empty<string>())
            {
                <option value="@category">@category</option>
            }
        </datalist>
        <span class="hint">@T["(Optional) Category for grouping content types in content type pickers. e.g., Common, Media, Layout, ..."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper">
    <label asp-for="ThumbnailPath" class="ocat-label">@T["Thumbnail"]</label>
    <div class="ocat-limited">
        <input asp-for="ThumbnailPath" type="text" class="form-control">
        <span class="hint">@T["(Optional) Path to thumbnail image for content type pickers."]</span>
    </div>
</div>
