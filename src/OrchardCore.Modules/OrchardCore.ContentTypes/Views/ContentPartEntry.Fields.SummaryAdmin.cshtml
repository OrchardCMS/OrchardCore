@using OrchardCore.ContentTypes.Models
@using OrchardCore.DisplayManagement.Views
@using OrchardCore.ContentTypes
@using OrchardCore.Localization.Data

@inject IDataLocalizer D

@model ShapeViewModel<ContentPartEntry>

@* Plain link, like the title of a content item in the Manage Content list. *@
<a class="list-item-search-text" asp-route-action="EditPart" asp-route-area="OrchardCore.ContentTypes" asp-route-id="@Model.Value.Name">@D[Model.Value.DisplayName, DataLocalizationContext.ContentType]</a>
