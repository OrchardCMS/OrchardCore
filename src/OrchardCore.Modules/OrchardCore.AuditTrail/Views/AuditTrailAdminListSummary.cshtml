@model AuditTrailIndexOptions

<div class="text-nowrap">
    <span class="d-inline-block my-1" id="items">
        @T.Plural(Model.EventsCount, "{0} item", "{0} items")
		<span title="@T["Items {0} to {1}", Model.StartIndex, Model.EndIndex]">@T.Plural(Model.TotalItemCount, " / {0} item in total", " / {0} items in total")</span>
    </span>
</div>
