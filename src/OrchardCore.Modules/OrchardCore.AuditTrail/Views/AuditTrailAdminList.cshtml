@using OrchardCore.Admin.Models
@using OrchardCore.Admin
@model AuditTrailListViewModel
@using OrchardCore.DisplayManagement.Zones
@{
    // The options editor shape: its zones hold the search bar and the buttons of the action bar.
    var header = (IZoneHolding)Model.Header;
}

<style asp-name="bootstrap-select" at="Head"></style>
<script asp-name="bootstrap-select" at="Foot"></script>
<style asp-name="audittrailui" asp-src="~/OrchardCore.AuditTrail/Styles/audittrailui.min.css" debug-src="~/OrchardCore.AuditTrail/Styles/audittrailui.css" at="Head"></style>

<div data-list-management>
<!-- Hidden submit button do not remove -->
<input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />

<div class="card mb-3 text-bg-theme position-sticky action-bar">
    <div class="card-body">
        <div class="row gx-2">
            <div class="col">
                @await DisplayAsync(header.Zones["Search"])
            </div>
        </div>
    </div>
</div>

@* The events, the header and the pager are rendered by the AdminList shape using the configured layout (List, Grid, ...). *@
<admin-list name="AuditTrail" context="Model.List">
    <admin-list-list item-css-class="list-group-item list-group-item-action" />
    <admin-list-grid>
        <admin-list-column name="Event" position="10" title="@T["Event"]" width="25%" />
        <admin-list-column name="Category" position="20" title="@T["Category"]" width="25%" />
        <admin-list-column name="Details" position="30" title="@T["Details"]" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
</div>

<script asp-src="~/OrchardCore.AuditTrail/Scripts/audit-trail-admin-list/audit-trail-admin-list.min.js" debug-src="~/OrchardCore.AuditTrail/Scripts/audit-trail-admin-list/audit-trail-admin-list.js" at="Foot" type="module"></script>
