@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Sitemaps.ViewModels

@model ShapeViewModel<SitemapIndexListEntry>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@Localize(CommonLocalizationSources.Status)">
    <i class="fa-solid @(Model.Value.Enabled ? "fa-check text-success" : "fa-ban text-secondary")" aria-hidden="true"></i>
    @(Model.Value.Enabled ? Localize(CommonLocalizationSources.EnabledState) : Localize(CommonLocalizationSources.DisabledState))
</span>
