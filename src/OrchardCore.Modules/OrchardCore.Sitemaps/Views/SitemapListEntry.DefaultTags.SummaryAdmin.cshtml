@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Sitemaps.ViewModels

@model ShapeViewModel<SitemapListEntry>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Status"]">
    <i class="fa-solid @(Model.Value.Enabled ? "fa-check text-success" : "fa-ban text-secondary")" aria-hidden="true"></i>
    @(Model.Value.Enabled ? T["Enabled"] : T["Disabled"])
</span>
