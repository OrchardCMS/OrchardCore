@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Sitemaps.ViewModels

@model ShapeViewModel<SitemapListEntry>

@* A bare item, never wrapped in <li>: AdminListActions renders the menu in a <div class="dropdown-menu">. *@
<a asp-action="Toggle" asp-controller="Admin" asp-route-sitemapId="@Model.Value.SitemapId" class="dropdown-item" data-url-af="UnsafeUrl">@(Model.Value.Enabled ? T["Disable"] : T["Enable"])</a>
