@model ListSitemapViewModel

<zone Name="Title"><h1>@RenderTitleSegments(T["Sitemaps"])</h1></zone>

@if (string.IsNullOrEmpty(Site.BaseUrl))
{
    <p class="alert alert-warning">@T["The site settings 'Base url' property is empty, but is required to generate sitemaps."]</p>
}

@* the form is necessary to generate the antiforgery token *@
<form asp-action="List" method="post" class="no-multisubmit" data-list-management data-selected-label="@T["selected"]">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input asp-for="Options.BulkAction" type="hidden" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group has-search">
                        <i class="fa-solid fa-search form-control-feedback" aria-hidden="true"></i>
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]">@T["Go"]</button>
                    </div>
                </div>
                <div class="col-auto">
                    <a asp-route-action="Create" class="btn btn-secondary create" role="button">@T["Add Sitemap"]</a>
                </div>
            </div>
        </div>
    </div>

    @* The rows, the toolbar and the pager are rendered by the AdminList shape using the configured layout (List, Table, ...). *@
    @await DisplayAsync(Model.List)
</form>

<script asp-name="list-management" at="Foot"></script>
