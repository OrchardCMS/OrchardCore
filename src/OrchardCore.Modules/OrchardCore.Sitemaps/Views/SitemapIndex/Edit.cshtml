@model EditSitemapIndexViewModel

<zone Name="Title">
    <breadcrumb name="SitemapIndexesEdit" title="@T["Edit Sitemap Index"]">
        <breadcrumb-item id="SitemapIndexes" action="List" controller="SitemapIndex" area="OrchardCore.Sitemaps" permission="@SitemapsPermissions.ManageSitemaps.Name">@T["Sitemap Indexes"]</breadcrumb-item>
    </breadcrumb>
</zone>

@if (string.IsNullOrEmpty(Site.BaseUrl))
{
    <p class="alert alert-warning">@T["The site settings 'Base url' property is empty, but is required to generate sitemaps."]</p>
}

<div asp-validation-summary="ModelOnly"></div>
<form asp-action="Edit" method="post" class="no-multisubmit">
    <input type="hidden" asp-for="SitemapId" />

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary save" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-controller="SitemapIndex" asp-action="List" asp-area="OrchardCore.Sitemaps">@T["Cancel"]</a>
    </div>
</form>
