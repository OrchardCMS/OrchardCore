@model CreateSourceViewModel
@using OrchardCore.Sitemaps.Services
@inject ISitemapManager SitemapManager

<zone Name="Title">
    <breadcrumb name="SitemapsSourceCreate" title="@T["Create Sitemap Source"]">
        <breadcrumb-item id="Sitemaps" action="List" controller="Admin" area="OrchardCore.Sitemaps" permission="@SitemapsPermissions.ManageSitemaps.Name">@T["Sitemaps"]</breadcrumb-item>
        @if (!string.IsNullOrEmpty(Model.SitemapId))
        {
            var sitemap = await SitemapManager.GetSitemapAsync(Model.SitemapId);
            <breadcrumb-item id="Sitemap" action="Display" controller="Admin" area="OrchardCore.Sitemaps" route-sitemapId="@Model.SitemapId" permission="@SitemapsPermissions.ManageSitemaps.Name">@(sitemap?.Name ?? (object)T["Sitemap"])</breadcrumb-item>
        }
    </breadcrumb>
</zone>

@{
    // The shapes of the editor placed in no card, such as the editor of a source whose driver doesn't declare a card,
    // are grouped in the "General" card.
    if (Model.Editor.Content is IEnumerable<object> editorShapes)
    {
        var generalCard = new OrchardCore.DisplayManagement.Descriptors.GroupingMetadata(T["General"].Value, "10");

        foreach (var shape in editorShapes.OfType<OrchardCore.DisplayManagement.IShape>())
        {
            if (!shape.Metadata.CardGrouping.HasValue)
            {
                shape.Metadata.CardGrouping = generalCard;
            }
        }
    }
}

<div asp-validation-summary="ModelOnly"></div>
<form asp-action="Create" method="post" class="no-multisubmit">
    @await DisplayAsync(Model.Editor.Content)

    <input type="hidden" asp-for="SitemapId" />
    <input type="hidden" asp-for="SitemapSourceId" />
    <input type="hidden" asp-for="SitemapSourceType" />

    <div class="action-bar-bottom">
        <button class="btn btn-primary create" type="submit">@T["Create"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Display" asp-route-controller="Admin" asp-route-sitemapId="@Model.SitemapId">@T["Cancel"]</a>
    </div>

</form>
