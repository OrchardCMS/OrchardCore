@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Sitemaps.ViewModels

@model ShapeViewModel<SitemapIndexListEntry>

@* Plain link, like the title of a content item in the Manage Content list. *@
<a class="@(Model.Value.Enabled ? string.Empty : "text-muted")" asp-action="Edit" asp-controller="SitemapIndex" asp-route-sitemapId="@Model.Value.SitemapId">@Model.Value.Name</a>
