@using OrchardCore.Features

@model FeaturesViewModel
@{
    var title = T["Features"];
    if (!string.IsNullOrEmpty(Model.Name))
    {
        title = T["Features for {0} tenant", Model.Name];
    }

    var totalFeatures = Model.Features.Count();
}

<zone Name="Title"><h1>@RenderTitleSegments(title)</h1></zone>

<style asp-name="bootstrap-select" at="Head"></style>
<script asp-name="bootstrap-select" at="Foot"></script>

<div data-list-management
     data-client-side-search="true"
     data-min-selected-items="1"
     data-filter-selector=".list-management-unused"
     >
<form autocomplete="off" class="position-sticky action-bar">
    <div class="card text-bg-theme mb-3">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group has-search">
                        <i class="fa-solid fa-search form-control-feedback" aria-hidden="true"></i>
                        <input id="search-box" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]">@T["Go"]</button>
                    </div>
                </div>
                <div class="col-auto">
                    <div class="dropdown">
                        <button class="btn btn-secondary dropdown-toggle" type="button" id="bulk-action-menu-button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            @T["Bulk Actions"]
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#" data-action="@nameof(FeaturesBulkAction.Disable)">@T["Disable"]</a></li>
                            <li><a class="dropdown-item" href="#" data-action="@nameof(FeaturesBulkAction.Enable)">@T["Enable"]</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<form asp-action="Features" method="post" class="no-multisubmit">
    <input name="BulkAction" type="hidden" />
    <input name="Force" type="hidden" value="true" />
    <input type="submit" name="submit.BulkAction" class="d-none" />

    <div class="card text-bg-theme mb-3">
        <div class="card-body">
            <div class="row gx-2 align-items-center">
                <div class="col">
                    <span id="list-summary"
                          data-summary-text="@T["Showing {0} of {1} features", "__VISIBLE__", "__TOTAL__"]"
                          data-total-count="@totalFeatures">
                        @T["Showing {0} of {1} features", totalFeatures, totalFeatures]
                    </span>
                </div>
                <div class="col col-md-auto text-end d-flex align-items-center justify-content-end gap-2">
                    <div class="btn-group filter">
                        <select id="visibility-filter" class="selectpicker show-tick nosubmit me-2" multiple data-list-filter data-header="@T["Filter by visibility"]" data-selected-text-format="static" data-width="fit" title="@T["Visibility"]" data-style="btn-sm">
                            <option value="true" data-list-filter-attribute="data-is-on-demand" data-list-filter-mode="exclude" selected>@T["Hide on demand"]</option>
                            <option value="true" data-list-filter-attribute="data-is-always-enabled" data-list-filter-mode="exclude" selected>@T["Hide always enabled"]</option>
                        </select>
                        <select id="status-filter" class="selectpicker show-tick nosubmit" data-list-filter data-list-filter-attribute="data-is-enabled" data-header="@T["Filter by status"]" data-selected-text-format="static" data-width="fit" title="@T["Status"]" data-style="btn-sm">
                            <option value="" selected>@T["Any status"]</option>
                            <option value="true">@T["Enabled only"]</option>
                            <option value="false">@T["Disabled only"]</option>
                        </select>
                    </div>
                    @if (Model.LayoutSelector != null)
                    {
                        @await DisplayAsync(Model.LayoutSelector)
                    }
                </div>
            </div>
        </div>
    </div>

    @foreach (var group in Model.Groups)
    {
        @* No data-filter-value on the group itself: only the rows are counted by the search, and a category
           whose rows are all filtered out is hidden with them. *@
        <div class="feature-group list-management-group mb-3">
            <h3 class="mb-2">@group.Category</h3>

            @* The features of this category are rendered by the AdminList shape using the configured layout. *@
            @await DisplayAsync(group.List)
        </div>
    }

    <div id="list-alert" class="alert alert-info d-none" role="alert">
        @T["<strong>Nothing here!</strong> Your search or filters returned no results."]
    </div>
</form>
</div>
<script asp-name="list-management" at="Foot"></script>
<script at="Foot">
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.badge-show-more').forEach((button) => {
            button.addEventListener('click', (e) => {
                e.preventDefault();

                const transitiveDependencies = button.previousElementSibling;

                if (!transitiveDependencies?.classList.contains('transitive-dependencies')) {
                    return;
                }

                transitiveDependencies.classList.toggle('d-none');
                button.classList.toggle('d-none');

                const tooltip = bootstrap.Tooltip.getInstance(button);

                if (tooltip) {
                    tooltip.dispose();
                }
            });
        });
    });
</script>
