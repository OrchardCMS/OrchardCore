@using OrchardCore.DisplayManagement.Views
@using OrchardCore.OpenId.ViewModels

@model ShapeViewModel<OpenIdScopeEntry>

<a asp-action="Edit" asp-controller="Scope" asp-route-id="@Model.Value.Id" class="btn btn-primary btn-sm">@T["Edit"]</a>

<a asp-action="Delete" asp-controller="Scope" asp-route-id="@Model.Value.Id" class="delete btn btn-danger btn-sm" role="button" data-url-af="UnsafeUrl RemoveUrl">@T["Delete"]</a>
