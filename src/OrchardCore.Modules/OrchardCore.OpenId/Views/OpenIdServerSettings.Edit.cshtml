@using OrchardCore.OpenId.ViewModels
@model OpenIdServerSettingsViewModel

<div class="ocat-wrapper" asp-validation-class-for="EnableTokenEndpoint">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="EnableTokenEndpoint" data-openid-field="EnableTokenEndpoint">
            <label class="form-check-label" asp-for="EnableTokenEndpoint">@T["Enable Token Endpoint"]</label>
            <span class="hint dashed">@T["Enables the endpoint:"]</span> <code>/connect/token</code>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="EnableAuthorizationEndpoint">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="EnableAuthorizationEndpoint" data-openid-field="EnableAuthorizationEndpoint">
            <label class="form-check-label" asp-for="EnableAuthorizationEndpoint">@T["Enable Authorization Endpoint"]</label>
            <span class="hint dashed">@T["Enables the endpoint:"]</span> <code>/connect/authorize</code>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="EnablePushedAuthorizationEndpoint">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="EnablePushedAuthorizationEndpoint">
            <label class="form-check-label" asp-for="EnablePushedAuthorizationEndpoint">@T["Enable Pushed Authorization Endpoint"]</label>
            <span class="hint dashed">@T["Enables the endpoint:"]</span> <code>/connect/par</code>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="EnableLogoutEndpoint">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="EnableLogoutEndpoint">
            <label class="form-check-label" asp-for="EnableLogoutEndpoint">@T["Enable End Session Endpoint"]</label>
            <span class="hint dashed">@T["Enables the endpoint:"]</span> <code>/connect/logout</code>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="RequireEndSessionConfirmation">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="RequireEndSessionConfirmation">
            <label class="form-check-label" asp-for="RequireEndSessionConfirmation">@T["Require logout confirmation"]</label>
            <span class="hint dashed">@T["When unchecked, end-users are signed out without a confirmation prompt if a valid id_token_hint matching the current session is provided."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="EnableUserInfoEndpoint">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="EnableUserInfoEndpoint">
            <label class="form-check-label" asp-for="EnableUserInfoEndpoint">@T["Enable User Info Endpoint"]</label>
            <span class="hint dashed">@T["Enables the endpoint:"]</span> <code>/connect/userinfo</code>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="EnableIntrospectionEndpoint">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="EnableIntrospectionEndpoint">
            <label class="form-check-label" asp-for="EnableIntrospectionEndpoint">@T["Enable Introspection Endpoint"]</label>
            <span class="hint dashed">@T["Enables the endpoint:"]</span> <code>/connect/introspect</code>
        </div>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="EnableRevocationEndpoint">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="EnableRevocationEndpoint">
            <label class="form-check-label" asp-for="EnableRevocationEndpoint">@T["Enable Revocation Endpoint"]</label>
            <span class="hint dashed">@T["Enables the endpoint:"]</span> <code>/connect/revoke</code>
        </div>
    </div>
</div>

<script asp-src="~/OrchardCore.OpenId/Scripts/openid-settings/openid-server-settings.min.js" debug-src="~/OrchardCore.OpenId/Scripts/openid-settings/openid-server-settings.js" at="Foot" type="module"></script>
