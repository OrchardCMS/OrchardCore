@model CreateOpenIdApplicationViewModel
@using OrchardCore.OpenId.ViewModels
@using OrchardCore.OpenId.Settings
@{
    var settings = ViewData[nameof(OpenIdServerSettings)] as OpenIdServerSettings;
}
<zone Name="Title">
    <breadcrumb name="OpenIdApplicationsCreate" title="@T["Create a new application"]">
        <breadcrumb-item id="OpenIdApplications" action="Index" controller="Application" area="OrchardCore.OpenId" permission="@OpenIdPermissions.ManageApplications.Name">@T["Applications"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div asp-validation-summary="ModelOnly"></div>
<form asp-action="Create" method="post" class="no-multisubmit openid-application-editor"
      data-settings-configured="@(settings != null ? "true" : "false")"
      data-allow-authorization-code-flow="@(settings?.AllowAuthorizationCodeFlow == true ? "true" : "false")"
      data-allow-client-credentials-flow="@(settings?.AllowClientCredentialsFlow == true ? "true" : "false")"
      data-allow-implicit-flow="@(settings?.AllowImplicitFlow == true ? "true" : "false")"
      data-allow-hybrid-flow="@(settings?.AllowHybridFlow == true ? "true" : "false")"
      data-allow-password-flow="@(settings?.AllowPasswordFlow == true ? "true" : "false")"
      data-allow-refresh-token-flow="@(settings?.AllowRefreshTokenFlow == true ? "true" : "false")"
      data-logout-endpoint-configured="@(settings?.LogoutEndpointPath.HasValue == true ? "true" : "false")">

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary save" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
<script asp-name="credential-helpers" at="Foot"></script>
<script asp-src="~/OrchardCore.OpenId/Scripts/openid-application-editor/application-create.min.js" debug-src="~/OrchardCore.OpenId/Scripts/openid-application-editor/application-create.js" depends-on="credential-helpers" at="Foot" type="module"></script>

@* The scripts show and hide the redirect settings and the client credentials roles depending on the flows: their cards are hidden with them. *@
<style at="Head">
    .openid-application-editor fieldset:has(#RedirectSection.collapse:not(.show)),
    .openid-application-editor fieldset:has(#RoleGroup.collapse:not(.show)) {
        display: none;
    }
</style>
