@model EditOpenIdScopeViewModel
@using OrchardCore.OpenId
@using OrchardCore.OpenId.ViewModels

<zone Name="Title">
    <breadcrumb name="OpenIdScopesEdit" title="@T["Edit a scope"]">
        <breadcrumb-item id="OpenIdScopes" action="Index" controller="Scope" area="OrchardCore.OpenId" permission="@OpenIdPermissions.ManageScopes.Name">@T["Scopes"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div asp-validation-summary="ModelOnly"></div>
<form asp-action="Edit" method="post" class="no-multisubmit">

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary save" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
