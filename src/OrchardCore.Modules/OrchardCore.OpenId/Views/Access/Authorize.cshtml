@using Microsoft.Extensions.Primitives
@using OrchardCore.OpenId.ViewModels
@model AuthorizeViewModel

@{
    ViewLayout = "Layout__Login";
}

<div class="row">
    <section class="col-md-8 offset-md-2 py-4" aria-labelledby="authorization-title">
        <h1 id="authorization-title" class="h3 mb-3">@T["Authorize {0}", Model.ApplicationName]</h1>
        <p class="text-body-secondary mb-4">@T["Review the requested access. Only continue if you started this sign-in request."]</p>

        @await DisplayAsync(await New.OpenIdConsentScopes(Scope: Model.Scope))

        <form asp-controller="Access" asp-action="Authorize" method="post" class="no-multisubmit">
            @* Preserve the validated protocol request for the Accept/Reject actions. *@
            @foreach (var parameter in Context.Request.HasFormContentType ?
              (IEnumerable<KeyValuePair<string, StringValues>>) Context.Request.Form : Context.Request.Query)
            {
                <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
            }

            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-primary" name="submit.Accept" value="yes" type="submit">@T["Allow access"]</button>
                <button class="btn btn-secondary" name="submit.Deny" value="no" type="submit">@T["Cancel"]</button>
            </div>
        </form>
    </section>
</div>
