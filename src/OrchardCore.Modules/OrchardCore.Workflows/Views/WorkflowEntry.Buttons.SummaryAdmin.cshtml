@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Workflows.Models
@using OrchardCore.Workflows.ViewModels

@model ShapeViewModel<WorkflowEntry>

@{
    // A workflow that is mid-flight cannot be restarted.
    var restartable = Model.Value.Workflow.Status is not (WorkflowStatus.Executing or WorkflowStatus.Halted or WorkflowStatus.Resuming or WorkflowStatus.Starting);
}

@if (restartable)
{
    <a asp-action="Restart" asp-controller="Workflow" asp-route-id="@Model.Value.Workflow.Id" class="btn btn-warning btn-sm" data-title="@T["Restart"]" data-message="@T["Are you sure you want to restart this workflow instance?"]" data-url-af="RemoveUrl UnsafeUrl">@T["Restart"]</a>
}

<a asp-action="Delete" asp-controller="Workflow" asp-route-id="@Model.Value.Workflow.Id" class="btn btn-danger btn-sm" data-message="@T["Are you sure you want to delete this workflow instance?"]" data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
