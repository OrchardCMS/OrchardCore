@using OrchardCore.Workflows.Models
@model SetOutputTaskViewModel

<div class="ocat-wrapper" asp-validation-class-for="OutputName">
    <label asp-for="OutputName" class="ocat-label ocat-label-required">@T["Name"]</label>
    <div class="ocat-end">
        <input asp-for="OutputName" class="form-control" autofocus="autofocus" />
        <span asp-validation-for="OutputName"></span>
        <span class="hint">@T["The name to output to."]</span>
    </div>
</div>

@{
    var valueEditor = await Factory.CreateWorkflowExpressionEditorAsync(Html, m => m.Value, editor =>
    {
        editor.Label = T["Value"].Value;
        editor.Hint = T["The value to store in the specified output."].Value;
        editor.Required = true;
        editor.Multiline = true;
    });
}
@await DisplayAsync(valueEditor)
