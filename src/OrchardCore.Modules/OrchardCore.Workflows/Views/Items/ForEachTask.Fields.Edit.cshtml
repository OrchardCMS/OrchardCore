@using OrchardCore.Workflows.Models
@model ForEachTaskViewModel

@{
    var enumerableEditor = await Factory.CreateWorkflowExpressionEditorAsync(Html, m => m.Enumerable, editor =>
    {
        editor.Label = T["Items"].Value;
        editor.Hint = T["The list to iterate: a JavaScript list, a Liquid template that renders a JSON array or comma-separated values, or a literal list."].Value;
        editor.Required = true;
        editor.Multiline = false;
        editor.Examples[WorkflowExpressionSyntaxes.Literal] = "a, b, c";
        editor.Examples[WorkflowExpressionSyntaxes.JavaScript] = "input(\"Items\")";
        editor.Examples[WorkflowExpressionSyntaxes.Liquid] = "{{ Workflow.Properties.Items | json }}";
    });
}
@await DisplayAsync(enumerableEditor)

<div class="ocat-wrapper" asp-validation-class-for="LoopVariableName">
    <label asp-for="LoopVariableName" class="ocat-label ocat-label-required">@T["Looping Variable"]</label>
    <div class="ocat-end">
        <input asp-for="LoopVariableName" class="form-control" />
        <span asp-validation-for="LoopVariableName"></span>
        <span class="hint">@T["The name of the looping variable. The current value of each iteration is set to a property with this name as well as the last result."]</span>
    </div>
</div>
