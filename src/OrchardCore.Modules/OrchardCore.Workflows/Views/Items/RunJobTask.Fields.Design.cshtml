@model OrchardCore.Workflows.ViewModels.ActivityViewModel<OrchardCore.Workflows.Jobs.RunJobTask>
@using OrchardCore.Workflows.Helpers

<header>
    <h4><i class="fa-solid fa-gears" aria-hidden="true"></i>@Model.Activity.GetTitleOrDefault(() => T["Run Job"])</h4>
</header>
<span>@(Model.Activity.WaitForCompletion ? T["Waits for the run"] : T["Doesn't wait for the run"])</span>
