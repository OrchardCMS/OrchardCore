@using OrchardCore.Workflows.Models
@model ForLoopTaskViewModel

@{
    var fromEditor = await Factory.CreateWorkflowExpressionEditorAsync(Html, m => m.From, editor =>
    {
        editor.Label = T["From"].Value;
        editor.Hint = T["The start value."].Value;
        editor.Required = true;
        editor.Multiline = false;
        editor.Examples[WorkflowExpressionSyntaxes.Literal] = "0";
        editor.Examples[WorkflowExpressionSyntaxes.JavaScript] = "0";
        editor.Examples[WorkflowExpressionSyntaxes.Liquid] = "{{ Workflow.Properties.Start }}";
    });
}
@await DisplayAsync(fromEditor)

@{
    var toEditor = await Factory.CreateWorkflowExpressionEditorAsync(Html, m => m.To, editor =>
    {
        editor.Label = T["To"].Value;
        editor.Hint = T["The end value, which isn't included."].Value;
        editor.Required = true;
        editor.Multiline = false;
        editor.Examples[WorkflowExpressionSyntaxes.Literal] = "10";
        editor.Examples[WorkflowExpressionSyntaxes.JavaScript] = "10";
        editor.Examples[WorkflowExpressionSyntaxes.Liquid] = "{{ Workflow.Properties.End }}";
    });
}
@await DisplayAsync(toEditor)

@{
    var stepEditor = await Factory.CreateWorkflowExpressionEditorAsync(Html, m => m.Step, editor =>
    {
        editor.Label = T["Step"].Value;
        editor.Hint = T["The value added at each iteration."].Value;
        editor.Required = true;
        editor.Multiline = false;
        editor.Examples[WorkflowExpressionSyntaxes.Literal] = "1";
        editor.Examples[WorkflowExpressionSyntaxes.JavaScript] = "1";
        editor.Examples[WorkflowExpressionSyntaxes.Liquid] = "{{ Workflow.Properties.Step }}";
    });
}
@await DisplayAsync(stepEditor)

<div class="ocat-wrapper" asp-validation-class-for="LoopVariableName">
    <label asp-for="LoopVariableName" class="ocat-label ocat-label-required">@T["Looping Variable"]</label>
    <div class="ocat-end">
        <input asp-for="LoopVariableName" class="form-control" />
        <span asp-validation-for="LoopVariableName"></span>
        <span class="hint">@T["The name of the looping variable. The current value of each iteration is set to a property with this name as well as the last result."]</span>
    </div>
</div>
