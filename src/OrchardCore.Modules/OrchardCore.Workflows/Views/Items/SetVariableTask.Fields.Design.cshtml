@using OrchardCore.Workflows.Models
@model ActivityViewModel<SetVariableTask>

@{
    var expression = WorkflowExpressionSyntaxes.Resolve(Model.Activity.Value, Model.Activity.LiquidValue?.Expression, Model.Activity.Syntax).Expression;
}

<header>
    <h4><i class="fa-solid fa-square-root-variable" aria-hidden="true"></i>@Model.Activity.GetTitleOrDefault(() => T["Set {0}", Model.Activity.VariableName])</h4>
</header>
<span><em>@expression</em></span>
