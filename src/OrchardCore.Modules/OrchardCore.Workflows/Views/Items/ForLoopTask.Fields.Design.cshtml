@using OrchardCore.Workflows.Models
@model ActivityViewModel<ForLoopTask>

@{
    var fromExpression = WorkflowExpressionSyntaxes.Resolve(Model.Activity.From, Model.Activity.LiquidFrom?.Expression, Model.Activity.Syntax).Expression;
    var toExpression = WorkflowExpressionSyntaxes.Resolve(Model.Activity.To, Model.Activity.LiquidTo?.Expression, Model.Activity.Syntax).Expression;
}

<header>
    <h4><i class="fa-solid fa-circle-notch" aria-hidden="true"></i>@Model.Activity.GetTitleOrDefault(() => T["For Loop"])</h4>
</header>
<span>@T["Iterate <em>{0}</em> from <em>{1}</em> to <em>{2}</em>", Model.Activity.LoopVariableName, fromExpression, toExpression]</span>
