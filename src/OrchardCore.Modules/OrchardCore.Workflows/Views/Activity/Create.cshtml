@model OrchardCore.Workflows.ViewModels.ActivityEditViewModel
@using OrchardCore.Workflows.Models
@using YesSql
@inject YesSql.ISession Session

<div data-workflow-type-id="@Model.WorkflowTypeId" data-activity-id="@Model.ActivityId">
    <zone Name="Title">
        <breadcrumb name="WorkflowsActivityCreate" title="@T["Add {0}", Model.Activity.DisplayText.Value]">
            <breadcrumb-item id="WorkflowTypes" action="Index" controller="WorkflowType" area="OrchardCore.Workflows" permission="@WorkflowsPermissions.ManageWorkflows.Name">@T["Workflows"]</breadcrumb-item>
            @if (Model.WorkflowTypeId != 0)
            {
                var workflowType = await Session.GetAsync<WorkflowType>(Model.WorkflowTypeId);
                <breadcrumb-item id="WorkflowType" action="Edit" controller="WorkflowType" area="OrchardCore.Workflows" route-id="@Model.WorkflowTypeId" permission="@WorkflowsPermissions.ManageWorkflows.Name">@workflowType?.Name</breadcrumb-item>
            }
        </breadcrumb>
    </zone>

    <div asp-validation-summary="ModelOnly"></div>
    <form asp-action="Create" asp-route-workflowtypeid="@Model.WorkflowTypeId" asp-route-activityname="@Model.Activity.Name" asp-route-returnurl="@Model.ReturnUrl" method="post" enctype="multipart/form-data" class="no-multisubmit">
        <input type="hidden" asp-for="ActivityId" />
        @await DisplayAsync(Model.ActivityEditor)

        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <button class="btn btn-primary save" type="submit">@T["Save"]</button>
                <a class="btn btn-secondary cancel" role="button" href="@Model.ReturnUrl">@T["Cancel"]</a>
            </div>
        </div>
    </form>
</div>
