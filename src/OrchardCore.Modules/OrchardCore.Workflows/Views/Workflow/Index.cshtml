@model WorkflowIndexViewModel

<style asp-name="bootstrap-select" at="Head"></style>
<script asp-name="bootstrap-select" at="Foot"></script>

<zone Name="Title"><h1>@RenderTitleSegments(T["Workflow Instances - {0}", Model.WorkflowType.Name])</h1></zone>

<form asp-action="Index" method="post" class="no-multisubmit" data-list-management data-selected-label="@T["selected"]">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />
    <input asp-for="Options.BulkAction" type="hidden" />
    <input asp-for="ReturnUrl" type="hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col"></div>
                <div class="col-auto">
                    <a asp-action="Index" asp-controller="WorkflowType" class="btn btn-secondary" role="button">@T["Back to workflows"]</a>
                </div>
            </div>
        </div>
    </div>

    @* The instances, the toolbar and the pager are rendered by the AdminList shape using the configured layout (List, Table, ...). *@
    @await DisplayAsync(Model.List)
</form>

<script asp-name="list-management" at="Foot"></script>
