@model OrchardCore.Workflows.ViewModels.WorkflowTypePropertiesViewModel

<zone Name="Title">
    <breadcrumb name="WorkflowTypesClone" title="@T["Clone Workflow"]">
        <breadcrumb-item id="WorkflowTypes" action="Index" controller="WorkflowType" area="OrchardCore.Workflows" permission="@WorkflowsPermissions.ManageWorkflows.Name">@T["Workflows"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div asp-validation-summary="ModelOnly"></div>
<form asp-action="Clone" method="post" class="no-multisubmit">
    @* The locking settings are on the Advanced tab: their errors show above the tabs too. *@
    <div><span asp-validation-for="LockTimeout" class="text-danger">@T["Invalid lock timeout value in the advanced tab"]</span></div>
    <div><span asp-validation-for="LockExpiration" class="text-danger">@T["Invalid lock expiration value in the advanced tab"]</span></div>

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary save" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" href="@Model.ReturnUrl">@T["Cancel"]</a>
    </div>
</form>
