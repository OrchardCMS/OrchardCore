@model WorkflowDesignerViewModel

@* The designer's toolbar shows the workflow's name and links back to the list, so the page has no heading or
   breadcrumb of its own, which leaves the height to the canvas. *@
@{
    Title.AddSegment(Html.Raw(Html.Encode(Model.WorkflowType.Name ?? string.Empty)));
}

@* The designer reads the antiforgery token from this form for its POST requests. *@
<form id="workflow-designer-antiforgery" class="d-none">@Html.AntiForgeryToken()</form>

<div id="workflow-designer" data-config="@Model.ConfigJson"></div>

<style asp-name="workflows-designer"></style>
@if (OrchardCore.Workflows.RealTime.WorkflowsRealTime.IsEnabled(Context.RequestServices))
{
    <script asp-name="signalr" at="Foot"></script>
}
<script asp-name="workflows-designer" at="Foot"></script>
