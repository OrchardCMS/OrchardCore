@using OrchardCore.Admin.Models
@using OrchardCore.Admin
@model WorkflowTypeIndexViewModel

<zone Name="Title">
    <breadcrumb name="WorkflowTypes" title="@T["Workflows"]" />
</zone>

<form asp-action="Index" id="workflows-types-form" method="post" class="no-multisubmit workflow-bulk-select-list" data-selected-text="@T["selected"]">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />
    <input asp-for="Options.BulkAction" type="hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                <div class="col-auto">
                    <a asp-action="EditProperties" asp-route-returnUrl="@FullRequestPath" class="btn btn-secondary create" role="button">@T["Create Workflow"]</a>
                </div>
            </div>
        </div>
    </div>

    @* The workflow types, the toolbar and the pager are rendered by the AdminList shape using the configured layout (List, Grid, ...). *@
    <admin-list name="WorkflowTypes" context="Model.List"
                bulk-actions="Model.Options.WorkflowTypesBulkAction"
                empty-message="@T["<strong>Nothing here!</strong> There are no workflow types for the moment."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column type="Select" />
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</form>

<script asp-src="~/OrchardCore.Workflows/Scripts/workflow-index-editors/workflow-type-index.min.js" debug-src="~/OrchardCore.Workflows/Scripts/workflow-index-editors/workflow-type-index.js" at="Foot" type="module"></script>
