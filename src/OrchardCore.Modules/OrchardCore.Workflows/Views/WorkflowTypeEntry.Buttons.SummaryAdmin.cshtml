@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Workflows.ViewModels

@model ShapeViewModel<WorkflowTypeEntry>

<a asp-action="Edit" asp-controller="WorkflowType" asp-route-id="@Model.Value.WorkflowType.Id" asp-route-returnUrl="@FullRequestPath" class="btn btn-primary btn-sm">@T["Edit"]</a>

<a asp-action="EditProperties" asp-controller="WorkflowType" asp-route-id="@Model.Value.WorkflowType.Id" asp-route-returnUrl="@FullRequestPath" class="btn btn-success btn-sm">@T["Properties"]</a>

<a asp-action="Delete" asp-controller="WorkflowType" asp-route-id="@Model.Value.WorkflowType.Id" class="btn btn-danger btn-sm" data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
