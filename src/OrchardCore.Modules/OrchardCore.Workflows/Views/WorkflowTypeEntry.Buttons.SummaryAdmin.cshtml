@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Workflows.ViewModels

@model ShapeViewModel<WorkflowTypeEntry>

<a asp-action="Edit" asp-controller="WorkflowType" asp-route-id="@Model.Value.WorkflowType.Id" asp-route-returnUrl="@FullRequestPath" class="btn btn-primary btn-sm">@Localize(CommonLocalizationSources.Edit)</a>

<a asp-action="Delete" asp-controller="WorkflowType" asp-route-id="@Model.Value.WorkflowType.Id" class="btn btn-danger btn-sm" data-url-af="RemoveUrl UnsafeUrl">@Localize(CommonLocalizationSources.Delete)</a>
