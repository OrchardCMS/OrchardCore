@using OrchardCore.Workflows.Models
@model WorkflowTypePropertiesViewModel

<div class="ocat-wrapper" asp-validation-class-for="Name">
    <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
    <div class="ocat-end">
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
        <span class="hint">@T["The name of the workflow."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="IsEnabled" type="checkbox" class="form-check-input" />
            <label class="form-check-label" asp-for="IsEnabled">@T["Enabled"]</label>
            <span class="hint dashed">@T["Uncheck to prevent workflows of this type from being executed."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="InstanceLimit" class="ocat-label">@T["Instances at a time"]</label>
    <div class="ocat-end">
        <select asp-for="InstanceLimit" class="form-select" data-cy="instance-limit">
            <option value="@WorkflowInstanceLimit.Any">@T["Any number"]</option>
            <option value="@WorkflowInstanceLimit.One">@T["One at a time"]</option>
            <option value="@WorkflowInstanceLimit.OnePerCorrelation">@T["One per correlated item"]</option>
        </select>
        <span class="hint">@T["With one at a time, an event doesn't start an instance while another instance waits. With one per correlated item, it doesn't start one while an instance for the same item waits, such as the same content item or user, when the event starting it has a correlation id."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="DeleteFinishedWorkflows" type="checkbox" class="form-check-input" />
            <label class="form-check-label" asp-for="DeleteFinishedWorkflows">@T["Delete successfully completed workflows"]</label>
            <span class="hint dashed">@T["Check to automatically delete workflows that have completed successfully. Leave unchecked to maintain a history of executed workflows."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="IsActivity" type="checkbox" class="form-check-input" />
            <label class="form-check-label" asp-for="IsActivity">@T["Usable as an activity"]</label>
            <span class="hint dashed">@T["Check to let other workflows run this one with the Execute Workflow task. Its variables marked as inputs and outputs are what they pass and get back."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="BranchingMode" class="ocat-label">@T["Outcomes with several transitions"]</label>
    <div class="ocat-end">
        <select asp-for="BranchingMode" class="form-select">
            <option value="@WorkflowBranchingMode.FirstOnly">@T["Follow the first transition only"]</option>
            <option value="@WorkflowBranchingMode.All">@T["Follow every transition"]</option>
        </select>
        <span class="hint">@T["Follow every transition to run several branches from one outcome without a Fork activity. With the first transition only, the other transitions of an outcome are ignored."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="FaultOnScriptErrors" type="checkbox" class="form-check-input" />
            <label class="form-check-label" asp-for="FaultOnScriptErrors">@T["Fault the workflow on script errors"]</label>
            <span class="hint dashed">@T["Check to fault an instance at the activity whose script failed, so it can be retried. Leave unchecked to go on with what the script fell back to; the error shows on the instance's page."]</span>
        </div>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="RecordActivityData" type="checkbox" class="form-check-input" />
            <label class="form-check-label" asp-for="RecordActivityData">@T["Record activity data"]</label>
            <span class="hint dashed">@T["Check to record, in the journal of each instance, the expressions each activity evaluated, the outputs it set, the variables it changed and its last result, to see what a run did. Values can be large or sensitive (personal data, keys), so leave it unchecked when they shouldn't be stored."]</span>
        </div>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="LockTimeout">
    <label asp-for="LockTimeout" class="ocat-label">@T["Lock timeout (ms)"]</label>
    <div class="ocat-limited">
        <input asp-for="LockTimeout" type="number" min="0" max="30000" class="form-control" />
        <span asp-validation-for="LockTimeout" class="text-danger"></span>
        <span class="hint">@T["The timeout in milliseconds to acquire a lock before resuming a given workflow instance of this type atomically. Leave it to zero to not use any locking."]</span>
    </div>
</div>

<div class="ocat-limited-wrapper" asp-validation-class-for="LockExpiration">
    <label asp-for="LockExpiration" class="ocat-label">@T["Lock expiration (ms)"]</label>
    <div class="ocat-limited">
        <input asp-for="LockExpiration" type="number" min="0" max="30000" class="form-control" />
        <span asp-validation-for="LockExpiration" class="text-danger"></span>
        <span class="hint">@T["The expiration in milliseconds of the lock acquired before resuming a workflow instance of this type atomically. Leave it to zero to not use any locking."]</span>
    </div>
</div>
