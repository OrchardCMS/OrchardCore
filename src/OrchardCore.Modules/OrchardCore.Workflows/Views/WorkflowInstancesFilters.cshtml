@*
    The filters of the workflow instances admin list, passed to the AdminListToolbar as its 'Actions' so they
    render at the end of the toolbar next to the bulk actions. The workflow filter is only shown on the page of
    every workflow's instances (ShowWorkflowTypes).
*@
@using OrchardCore.Workflows.ViewModels

@{
    var options = (WorkflowIndexOptions)Model.Options;
    var showWorkflowTypes = Model.ShowWorkflowTypes == true;
}

<div class="btn-group filter">
    @if (showWorkflowTypes)
    {
        <select asp-for="@options.WorkflowTypeId" name="Options.WorkflowTypeId" asp-items="@options.WorkflowTypes" class="selectpicker show-tick me-2" data-header="@T["Filter by workflow"]" data-live-search="true" data-width="fit" data-dropdown-align-right="true" title="@T["Workflow"]" data-style="btn-sm" data-cy="filter-workflow"></select>
    }
    <select asp-for="@options.Filter" name="Options.Filter" asp-items="@options.WorkflowsStatuses" class="selectpicker show-tick me-2" data-header="@T["Filter by status"]" data-width="fit" data-selected-text-format="static" data-dropdown-align-right="true" title="@T["Status"]" data-style="btn-sm"></select>
    <select asp-for="@options.Created" name="Options.Created" asp-items="@options.WorkflowsCreated" class="selectpicker show-tick me-2" data-header="@T["Filter by creation date"]" data-width="fit" data-selected-text-format="static" data-dropdown-align-right="true" title="@T["Created"]" data-style="btn-sm" data-cy="filter-created"></select>
    <select asp-for="@options.OrderBy" name="Options.OrderBy" asp-items="@options.WorkflowsSorts" class="selectpicker show-tick" data-header="@T["Sort by"]" data-width="fit" data-selected-text-format="static" data-dropdown-align-right="true" title="@T["Sort"]" data-style="btn-sm"></select>
</div>
