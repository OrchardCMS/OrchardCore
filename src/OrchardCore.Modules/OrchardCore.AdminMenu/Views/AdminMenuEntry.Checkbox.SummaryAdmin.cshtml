@using OrchardCore.AdminMenu.ViewModels
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<AdminMenuEntry>

<div class="form-check">
    <input type="checkbox" class="form-check-input" value="@Model.Value.AdminMenu.Id" name="itemIds" id="itemIds-@Model.Value.AdminMenu.Id">
    <label class="form-check-label" for="itemIds-@Model.Value.AdminMenu.Id">&nbsp;</label>
</div>
