@model PlaceholderAdminNodeViewModel
@using System.Text.Json
@using System.Text.Json.Nodes

<style asp-src="~/OrchardCore.AdminMenu/Styles/admin-menu.min.css" debug-src="~/OrchardCore.AdminMenu/Styles/admin-menu.css" at="Head"></style>
<style asp-src="~/OrchardCore.AdminMenu/Styles/admin-menu-icon-picker.min.css" debug-src="~/OrchardCore.AdminMenu/Styles/admin-menu-icon-picker.css" at="Head"></style>

<script asp-name="vuejs" at="Foot" version="2"></script>
<script asp-src="~/OrchardCore.AdminMenu/Scripts/admin-menu-icon-picker.min.js" debug-src="~/OrchardCore.AdminMenu/Scripts/admin-menu-icon-picker.js" at="Foot" depends-on="bootstrap, jQuery, fontawesome-iconpicker"></script>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <h5 class="mb-0">@T["Placeholder"]</h5>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="LinkText">
    <label asp-for="LinkText" class="ocat-label">@T["Link Text"]</label>
    <div class="ocat-end">
        <input asp-for="LinkText" class="form-control" />
        <span asp-validation-for="LinkText"></span>
        <span class="hint">@T["The text of the menu item as it will be shown in the tree."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="IconClass" class="ocat-label">@T["Icon"]</label>
    <div class="ocat-end">
        <div class="btn-toolbar" role="toolbar" aria-label="Icon Selector Toolbar">
            <div class="btn-group input-group me-2" role="group" aria-label="Icon Selector">
                <button type="button" class="btn btn-secondary sample-icon">
                    <i id="@("sample-icon-" + Html.IdFor(m=>m.IconClass))" class="@Model.IconClass"></i>
                </button>
                <input type="hidden" name="@Html.NameFor(m=>m.IconClass)" id="@Html.IdFor(m => m.IconClass)" value="@Model.IconClass" />
                <button type="button"
                        class="btn btn-secondary icon-picker-trigger"
                        data-related-node="@Html.IdFor(m => m.IconClass)">
                    @T["Pick"]
                </button>
                <button type="button" class="btn btn-warning remove-icon" data-related-node="@Html.IdFor(m => m.IconClass)">
                    <div style="pointer-events:none;">
                        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                    </div>
                </button>
            </div>
        </div>
        <span class="hint">@T["Select an icon to display when this menu item is at the first level."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    @{
        var selectedItems = JConvert.SerializeObject(Model.SelectedItems, JOptions.CamelCase);
        var allItems = JConvert.SerializeObject(Model.AllItems, JOptions.CamelCase);
        var translations = Orchard.GetJSLocalizations("permission-picker");
        var translationsJson = Json.Serialize(translations).ToString();
    }

    <style asp-name="admin-menu-permission-picker" asp-src="~/OrchardCore.AdminMenu/Styles/admin-menu-permission-picker.min.css" debug-src="~/OrchardCore.AdminMenu/Styles/admin-menu-permission-picker.css"></style>

    <label asp-for="SelectedPermissionNames" class="ocat-label">@T["Permissions"]</label>

    <div class="ocat-end">
        <div id="PermissionPicker" class="vue-multiselect" data-selected-items="@selectedItems" data-all-items="@allItems" data-translations="@translationsJson" data-selected-names-input-id="@Html.IdFor(m => m.SelectedPermissionNames)" data-selected-names-input-name="@Html.NameFor(m => m.SelectedPermissionNames)" data-hint-text="@T["The permissions required to display this menu item (optional)."]" v-cloak>
        </div>
    </div>
</div>

<div id="iconPickerVue">
    <div class="modal" id="iconPickerModal" tabindex="-1" role="dialog" aria-labelledby="iconPickerModal" aria-hidden="true">
        <div class="modal-dialog" role="dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@T["Pick an icon"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <div id="inline-picker" class="icp icp-auto" data-placement="inline"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script asp-src="~/OrchardCore.AdminMenu/Scripts/admin-node-editors/placeholder-admin-node.min.js" debug-src="~/OrchardCore.AdminMenu/Scripts/admin-node-editors/placeholder-admin-node.js" depends-on="vuejs, vue-multiselect" at="Foot" type="module"></script>
