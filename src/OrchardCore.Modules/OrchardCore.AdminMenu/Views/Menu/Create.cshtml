@model AdminMenuCreateViewModel

<zone Name="Title">
    <breadcrumb name="AdminMenusCreate" title="@T["Create Admin Menu"]">
        <breadcrumb-item id="AdminMenus" action="List" controller="Menu" area="OrchardCore.AdminMenu" permission="@AdminMenuPermissions.ManageAdminMenu.Name">@T["Admin Menus"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div asp-validation-summary="ModelOnly"></div>

<form asp-action="Create" method="post" class="no-multisubmit">
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-success create" type="submit">@T["Create"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="List">@T["Cancel"]</a>
    </div>
</form>
