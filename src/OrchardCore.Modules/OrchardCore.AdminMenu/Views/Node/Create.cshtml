@model AdminNodeEditViewModel
@using OrchardCore.AdminMenu.Services
@inject IAdminMenuService AdminMenuService

<zone Name="Title">
    <breadcrumb name="AdminMenusNodeCreate" title="@T["Create Node"]">
        <breadcrumb-item id="AdminMenus" action="List" controller="Menu" area="OrchardCore.AdminMenu" permission="@AdminMenuPermissions.ManageAdminMenu.Name">@T["Admin Menus"]</breadcrumb-item>
        @if (!string.IsNullOrEmpty(Model.AdminMenuId))
        {
            var adminMenu = AdminMenuService.GetAdminMenuById(await AdminMenuService.GetAdminMenuListAsync(), Model.AdminMenuId);
            <breadcrumb-item id="Nodes" action="List" controller="Node" area="OrchardCore.AdminMenu" route-id="@Model.AdminMenuId" permission="@AdminMenuPermissions.ManageAdminMenu.Name">@T["Edit Nodes for '{0}'", adminMenu?.Name]</breadcrumb-item>
        }
    </breadcrumb>
</zone>

<div asp-validation-summary="All"></div>
<form asp-action="Create" method="post" class="no-multisubmit">
    @await DisplayAsync(Model.Editor.Content)

    <input type="hidden" asp-for="AdminMenuId" />
    <input type="hidden" asp-for="AdminNodeId" />
    <input type="hidden" asp-for="AdminNodeType" />

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-success create" type="submit">@T["Create"]</button>
            <a class="btn btn-secondary cancel"
               role="button"
               asp-route-controller="Node"
               asp-route-action="List"
               asp-route-id="@Model.AdminMenuId">@T["Cancel"]</a>
        </div>
    </div>
</form>
