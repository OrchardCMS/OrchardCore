@model AdminNodeEditViewModel
@using OrchardCore.AdminMenu.Services
@inject IAdminMenuService AdminMenuService

<zone Name="Title">
    <breadcrumb name="AdminMenusNodeEdit" title="@T["Edit Node"]">
        <breadcrumb-item id="AdminMenus" action="List" controller="Menu" area="OrchardCore.AdminMenu" permission="@AdminMenuPermissions.ManageAdminMenu.Name">@T["Admin Menus"]</breadcrumb-item>
        @if (!string.IsNullOrEmpty(Model.AdminMenuId))
        {
            var adminMenu = AdminMenuService.GetAdminMenuById(await AdminMenuService.GetAdminMenuListAsync(), Model.AdminMenuId);
            <breadcrumb-item id="Nodes" action="List" controller="Node" area="OrchardCore.AdminMenu" route-id="@Model.AdminMenuId" permission="@AdminMenuPermissions.ManageAdminMenu.Name">@T["Edit Nodes for '{0}'", adminMenu?.Name]</breadcrumb-item>
        }
    </breadcrumb>
</zone>

@{
    // The shapes of the editor placed in no card, such as the editor of a node whose driver doesn't declare a card,
    // are grouped in the "General" card.
    if (Model.Editor.Content is IEnumerable<object> editorShapes)
    {
        var generalCard = new OrchardCore.DisplayManagement.Descriptors.GroupingMetadata(T["General"].Value, "10");

        foreach (var shape in editorShapes.OfType<OrchardCore.DisplayManagement.IShape>())
        {
            if (!shape.Metadata.CardGrouping.HasValue)
            {
                shape.Metadata.CardGrouping = generalCard;
            }
        }
    }
}

<div asp-validation-summary="All"></div>
<form asp-action="Edit" method="post" class="no-multisubmit">
    @await DisplayAsync(Model.Editor.Content)

    <input type="hidden" asp-for="AdminMenuId" />
    <input type="hidden" asp-for="AdminNodeId" />
    <input type="hidden" asp-for="AdminNodeType" />

    <div class="action-bar-bottom">
        <div class="btn-group"
             role="group"
             aria-label="@T["Save actions"]"
             data-action-group="oc-admin-menu-node-save-action"
             data-action-default="save"
             data-label-default="@T["Save"]"
             data-action-alt="SaveAndContinue"
             data-label-alt="@T["Save and continue"]">
            <button class="btn btn-success save" type="submit" name="submit" value="save">@T["Save"]</button>
            <button type="button" class="btn btn-success dropdown-toggle dropdown-toggle-split" data-reference="parent" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <span class="visually-hidden">@T["Toggle Dropdown"]</span>
            </button>
            <div class="dropdown-menu">
                <button class="dropdown-item save-continue" type="submit" name="submit" value="SaveAndContinue">@T["and continue"]</button>
            </div>
        </div>

        <a class="btn btn-danger delete action-bar-secondary"
           asp-action="Delete"
           asp-controller="Node"
           asp-route-id="@Model.AdminMenuId"
           asp-route-treeNodeId="@Model.AdminNodeId"
           data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>

        <a class="btn btn-secondary cancel"
           role="button"
           asp-route-action="List"
           asp-route-id="@Model.AdminMenuId">@T["Cancel"]</a>
    </div>
</form>
