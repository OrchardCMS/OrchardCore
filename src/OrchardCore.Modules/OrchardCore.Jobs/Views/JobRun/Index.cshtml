@model JobRunIndexViewModel

<zone Name="Title">
    <breadcrumb name="JobRuns" title="@T["Job Runs"]" />
</zone>

<form asp-action="Index" method="post" class="no-multisubmit bulk-select-list" data-checkbox-name="runIds" data-bulk-action-name="Options.BulkAction" data-selected-text="@T["selected"]" data-job-runs-states-url="@Url.Action("States")">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input asp-for="Options.BulkAction" type="hidden" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />

    @* The runs, the toolbar and the pager are rendered by the AdminList shape using the configured layout (List, Grid, ...). *@
    <admin-list name="JobRuns" context="Model.List"
                bulk-actions="Model.Options.BulkActions"
                empty-message="@T["<strong>Nothing here!</strong> There are no runs for the moment."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column type="Select" />
            <admin-list-column name="Title" position="20" title="@T["Job"]" />
            <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
            <admin-list-column name="Trigger" position="40" title="@T["Trigger"]" width="auto" />
            <admin-list-column name="Started" position="50" title="@T["Started"]" width="auto" />
            <admin-list-column name="Duration" position="60" title="@T["Duration"]" width="auto" />
            <admin-list-column name="Server" position="70" title="@T["Server"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</form>

<style asp-name="bootstrap-select" at="Head"></style>
<script asp-name="bootstrap-select" at="Foot"></script>
<script asp-src="~/OrchardCore.Jobs/Scripts/jobs/job-runs-index.min.js" debug-src="~/OrchardCore.Jobs/Scripts/jobs/job-runs-index.js" at="Foot" type="module"></script>
<script asp-src="~/OrchardCore.Jobs/Scripts/jobs/job-run-state.min.js" debug-src="~/OrchardCore.Jobs/Scripts/jobs/job-run-state.js" at="Foot" type="module"></script>
