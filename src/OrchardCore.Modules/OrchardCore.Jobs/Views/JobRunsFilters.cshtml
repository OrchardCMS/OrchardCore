@*
    The status and job filters of the runs admin list, passed to the AdminListToolbar as its 'Actions'
    so they render at the end of the toolbar next to the bulk actions.
*@
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var options = (JobRunIndexOptions)Model.Options;
}

<div class="btn-group filter">
    <select asp-for="@options.JobName" name="Options.JobName" asp-items="@options.Jobs" class="selectpicker show-tick me-2" data-header="@T["Filter by job"]" data-live-search="true" data-width="fit" data-dropdown-align-right="true" title="@T["Job"]" data-style="btn-sm"></select>
    <select asp-for="@options.Status" name="Options.Status" asp-items="@options.Statuses" class="selectpicker show-tick me-2" data-header="@T["Filter by status"]" data-width="fit" data-selected-text-format="static" data-dropdown-align-right="true" title="@T["Status"]" data-style="btn-sm"></select>
</div>
