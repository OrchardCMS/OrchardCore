@model JobScheduleRowViewModel

@* Bare items, never wrapped in <li>: AdminListActions renders the menu in a <div class="dropdown-menu">. *@
@if (Model.IsJobRegistered)
{
    <a asp-action="Run" asp-controller="JobSchedule" asp-route-area="OrchardCore.Jobs" asp-route-scheduleId="@Model.Schedule.ScheduleId" class="dropdown-item" data-url-af="UnsafeUrl">@T["Run now"]</a>
}
<a asp-action="Index" asp-controller="JobRun" asp-route-area="OrchardCore.Jobs" asp-route-Options.JobName="@Model.Schedule.JobName" class="dropdown-item">@T["Runs"]</a>
@if (Model.CanDelete)
{
    <a asp-action="Delete" asp-controller="JobSchedule" asp-route-area="OrchardCore.Jobs" asp-route-scheduleId="@Model.Schedule.ScheduleId" class="dropdown-item text-danger" data-title="@T["Delete"]" data-message="@T["Are you sure you want to delete this schedule?"]" data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
}
