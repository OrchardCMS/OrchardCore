@model FeatureProfileViewModel

<zone Name="Title">
    <breadcrumb name="FeatureProfilesEdit" title="@T["Edit Feature Profile"]">
        <breadcrumb-item id="FeatureProfiles" action="Index" controller="FeatureProfiles" area="OrchardCore.Tenants" permission="@Permissions.ManageTenantFeatureProfiles.Name">@T["Feature Profiles"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div asp-validation-summary="All"></div>

<form asp-action="Edit" method="post" class="no-multisubmit">
    <input type="hidden" asp-for="Id" />

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <div class="btn-group"
             role="group"
             aria-label="@T["Save actions"]"
             data-action-group="oc-feature-profile-save-action"
             data-action-default="Save"
             data-label-default="@T["Save"]"
             data-action-alt="SaveAndContinue"
             data-label-alt="@T["Save and continue"]">
            <button type="submit" value="Save" name="submit" class="btn btn-primary save">@T["Save"]</button>
            <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-reference="parent" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <span class="visually-hidden">@T["Toggle Dropdown"]</span>
            </button>
            <div class="dropdown-menu">
                <button class="dropdown-item save-continue" name="submit" type="submit" value="SaveAndContinue">@T["and continue"]</button>
            </div>
        </div>

        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>

<style asp-name="monaco"></style>
<script asp-name="monaco" at="Foot"></script>
<script asp-src="~/OrchardCore.Tenants/Scripts/feature-profile-editor/feature-profile-editor.min.js" debug-src="~/OrchardCore.Tenants/Scripts/feature-profile-editor/feature-profile-editor.js" depends-on="monaco, admin" at="Foot" type="module"></script>
