@using OrchardCore.Tenants.Workflows.ViewModels
@model SetupTenantTaskViewModel

<div data-task-editor="setup-tenant">
    <div class="ocat-wrapper" asp-validation-class-for="TenantNameExpression">
        <label asp-for="TenantNameExpression" class="ocat-label">@T["Tenant name"]</label>
        <div class="ocat-end">
            <textarea asp-for="TenantNameExpression" rows="1" class="form-control code" autofocus></textarea>
            <span asp-validation-for="TenantNameExpression"></span>
            <span class="hint">@T["Select the name of tenant to setup."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="SiteNameExpression">
        <label asp-for="SiteNameExpression" class="ocat-label">@T["Site name"]</label>
        <div class="ocat-end">
            <textarea asp-for="SiteNameExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="SiteNameExpression"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="AdminUsernameExpression">
        <label asp-for="AdminUsernameExpression" class="ocat-label">@T["Admin user name"]</label>
        <div class="ocat-end">
            <textarea asp-for="AdminUsernameExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="AdminUsernameExpression"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="AdminEmailExpression">
        <label asp-for="AdminEmailExpression" class="ocat-label">@T["Admin email"]</label>
        <div class="ocat-end">
            <textarea asp-for="AdminEmailExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="AdminEmailExpression"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="AdminPasswordExpression">
        <label asp-for="AdminPasswordExpression" class="ocat-label">@T["Admin password"]</label>
        <div class="ocat-end">
            <textarea asp-for="AdminPasswordExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="AdminPasswordExpression"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="DatabaseProviderExpression">
        <label asp-for="DatabaseProviderExpression" class="ocat-label">@T["What type of database to use?"]</label>
        <div class="ocat-end">
            <textarea asp-for="DatabaseProviderExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="DatabaseProviderExpression"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="DatabaseTablePrefixExpression">
        <label asp-for="DatabaseTablePrefixExpression" class="ocat-label">@T["Table Prefix"]</label>
        <div class="ocat-end">
            <textarea asp-for="DatabaseTablePrefixExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="DatabaseTablePrefixExpression"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="DatabaseConnectionStringExpression">
        <label asp-for="DatabaseConnectionStringExpression" class="ocat-label">@T["Connection string"]</label>
        <div class="ocat-end">
            <textarea asp-for="DatabaseConnectionStringExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="DatabaseConnectionStringExpression"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="DatabaseSchemaExpression">
        <label asp-for="DatabaseSchemaExpression" class="ocat-label">@T["Schema"]</label>
        <div class="ocat-end">
            <textarea asp-for="DatabaseSchemaExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="DatabaseSchemaExpression"></span>
            <div class="hint">@T["When left blank, the default value on the server will be used."] @T["For example, '{0}' for SQL Server.", "dbo"]</div>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="RecipeNameExpression">
        <label asp-for="RecipeNameExpression" class="ocat-label">@T["Recipe"]</label>
        <div class="ocat-end">
            <textarea asp-for="RecipeNameExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="RecipeNameExpression"></span>
        </div>
    </div>
</div>

<style asp-name="codemirror"></style>
<script asp-name="codemirror" at="Foot"></script>
<script asp-name="codemirror-mode-javascript" at="Foot"></script>
<script asp-name="codemirror-addon-display-autorefresh" at="Foot"></script>
<script asp-name="codemirror-addon-mode-simple" at="Foot"></script>
<script asp-name="codemirror-addon-mode-multiplex" at="Foot"></script>
<script asp-name="codemirror-mode-xml" at="Foot"></script>
<script asp-src="~/OrchardCore.Liquid/codemirror/liquid.js" at="Foot"></script>

<script asp-src="~/OrchardCore.Tenants/Scripts/tenant-task-editors/setup-tenant-task.min.js" debug-src="~/OrchardCore.Tenants/Scripts/tenant-task-editors/setup-tenant-task.js" at="Foot" type="module"></script>
