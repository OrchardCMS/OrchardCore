@using OrchardCore.Tenants.Workflows.ViewModels
@model SetupTenantTaskViewModel

<div data-task-editor="setup-tenant">
    <div class="ocat-wrapper" asp-validation-class-for="TenantNameExpression">
        <label asp-for="TenantNameExpression" class="ocat-label">@T["Tenant name"]</label>
        <div class="ocat-end">
            <input type="text" asp-for="TenantNameExpression" class="form-control code" autofocus />
            <span asp-validation-for="TenantNameExpression"></span>
            <span class="hint">@T["Select the name of tenant to setup."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="SiteNameExpression">
        <label asp-for="SiteNameExpression" class="ocat-label">@T["Site name"]</label>
        <div class="ocat-end">
            <input type="text" asp-for="SiteNameExpression" class="form-control code" />
            <span asp-validation-for="SiteNameExpression"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="RecipeNameExpression">
        <label asp-for="RecipeNameExpression" class="ocat-label">@T["Recipe"]</label>
        <div class="ocat-end">
            <input type="text" asp-for="RecipeNameExpression" class="form-control code" />
            <span asp-validation-for="RecipeNameExpression"></span>
        </div>
    </div>
</div>

<style asp-name="codemirror"></style>
<script asp-name="codemirror" at="Foot"></script>
<script asp-name="codemirror-mode-javascript" at="Foot"></script>
<script asp-name="codemirror-addon-display-autorefresh" at="Foot"></script>
<script asp-name="codemirror-addon-mode-simple" at="Foot"></script>
<script asp-name="codemirror-addon-mode-multiplex" at="Foot"></script>
<script asp-name="codemirror-mode-xml" at="Foot"></script>
<script asp-src="~/OrchardCore.Liquid/codemirror/liquid.js" at="Foot"></script>

<script asp-src="~/OrchardCore.Tenants/Scripts/tenant-task-editors/setup-tenant-task.min.js" debug-src="~/OrchardCore.Tenants/Scripts/tenant-task-editors/setup-tenant-task.js" at="Foot" type="module"></script>
