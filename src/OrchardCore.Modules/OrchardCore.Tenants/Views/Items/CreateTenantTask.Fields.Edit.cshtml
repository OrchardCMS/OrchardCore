@using OrchardCore.Tenants.Workflows.ViewModels
@model CreateTenantTaskViewModel

<div data-task-editor="create-tenant">
    <div class="ocat-wrapper" asp-validation-class-for="TenantNameExpression">
        <label asp-for="TenantNameExpression" class="ocat-label">@T["Name"]</label>
        <div class="ocat-end">
            <input type="text" asp-for="TenantNameExpression" class="form-control code" autofocus />
            <span asp-validation-for="TenantNameExpression"></span>
            <span class="hint">@T["Select the name of the tenant to create."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="DescriptionExpression">
        <label asp-for="DescriptionExpression" class="ocat-label">@T["Description"]</label>
        <div class="ocat-end">
            <input type="text" asp-for="DescriptionExpression" class="form-control code" autofocus />
            <span asp-validation-for="DescriptionExpression"></span>
            <span class="hint">@T["(Optional) the description of the tenant to create."]</span>
        </div>
    </div>
</div>

<style asp-name="codemirror"></style>
<script asp-name="codemirror" at="Foot"></script>
<script asp-name="codemirror-mode-javascript" at="Foot"></script>
<script asp-name="codemirror-addon-display-autorefresh" at="Foot"></script>
<script asp-name="codemirror-addon-mode-simple" at="Foot"></script>
<script asp-name="codemirror-addon-mode-multiplex" at="Foot"></script>
<script asp-name="codemirror-mode-xml" at="Foot"></script>
<script asp-src="~/OrchardCore.Liquid/codemirror/liquid.js" at="Foot"></script>

<script asp-src="~/OrchardCore.Tenants/Scripts/tenant-task-editors/create-tenant-task.min.js" debug-src="~/OrchardCore.Tenants/Scripts/tenant-task-editors/create-tenant-task.js" at="Foot" type="module"></script>
