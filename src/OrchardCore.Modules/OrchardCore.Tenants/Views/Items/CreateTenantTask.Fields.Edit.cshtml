@using OrchardCore.Tenants.Workflows.ViewModels
@model CreateTenantTaskViewModel

<div data-task-editor="create-tenant">
    <div class="ocat-wrapper" asp-validation-class-for="TenantNameExpression">
        <label asp-for="TenantNameExpression" class="ocat-label">@T["Name"]</label>
        <div class="ocat-end">
            <textarea asp-for="TenantNameExpression" rows="1" class="form-control code" autofocus></textarea>
            <span asp-validation-for="TenantNameExpression"></span>
            <span class="hint">@T["Select the name of the tenant to create."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="DescriptionExpression">
        <label asp-for="DescriptionExpression" class="ocat-label">@T["Description"]</label>
        <div class="ocat-end">
            <textarea asp-for="DescriptionExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="DescriptionExpression"></span>
            <span class="hint">@T["(Optional) the description of the tenant to create."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="RequestUrlPrefixExpression">
        <label asp-for="RequestUrlPrefixExpression" class="ocat-label">@T["Url Prefix"]</label>
        <div class="ocat-end">
            <textarea asp-for="RequestUrlPrefixExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="RequestUrlPrefixExpression"></span>
            <span class="hint">@T["(Optional) Example: If prefix is \"site1\", the tenant URL prefix is \"http://orchardproject.net/site1\"."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="RequestUrlHostExpression">
        <label asp-for="RequestUrlHostExpression" class="ocat-label">@T["Host name"]</label>
        <div class="ocat-end">
            <textarea asp-for="RequestUrlHostExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="RequestUrlHostExpression"></span>
            <span class="hint">@T["Example: If host is \"orchardproject.net\", the tenant site URL is \"http://orchardproject.net/\". With Liquid support."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="DatabaseProviderExpression">
        <label asp-for="DatabaseProviderExpression" class="ocat-label">@T["What type of database to use?"]</label>
        <div class="ocat-end">
            <textarea asp-for="DatabaseProviderExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="DatabaseProviderExpression"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="TablePrefixExpression">
        <label asp-for="TablePrefixExpression" class="ocat-label">@T["Table Prefix"]</label>
        <div class="ocat-end">
            <textarea asp-for="TablePrefixExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="TablePrefixExpression"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="ConnectionStringExpression">
        <label asp-for="ConnectionStringExpression" class="ocat-label">@T["Connection string"]</label>
        <div class="ocat-end">
            <textarea asp-for="ConnectionStringExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="ConnectionStringExpression"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="SchemaExpression">
        <label asp-for="SchemaExpression" class="ocat-label">@T["Schema"]</label>
        <div class="ocat-end">
            <textarea asp-for="SchemaExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="SchemaExpression"></span>
            <div class="hint">@T["When left blank, the default value on the server will be used."] @T["For example, '{0}' for SQL Server.", "dbo"]</div>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="RecipeNameExpression">
        <label asp-for="RecipeNameExpression" class="ocat-label">@T["Recipe"]</label>
        <div class="ocat-end">
            <textarea asp-for="RecipeNameExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="RecipeNameExpression"></span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="FeatureProfileExpression">
        <label asp-for="FeatureProfileExpression" class="ocat-label">@T["Feature Profile"]</label>
        <div class="ocat-end">
            <textarea asp-for="FeatureProfileExpression" rows="1" class="form-control code"></textarea>
            <span asp-validation-for="FeatureProfileExpression"></span>
        </div>
    </div>
</div>

<style asp-name="codemirror"></style>
<script asp-name="codemirror" at="Foot"></script>
<script asp-name="codemirror-mode-javascript" at="Foot"></script>
<script asp-name="codemirror-addon-display-autorefresh" at="Foot"></script>
<script asp-name="codemirror-addon-mode-simple" at="Foot"></script>
<script asp-name="codemirror-addon-mode-multiplex" at="Foot"></script>
<script asp-name="codemirror-mode-xml" at="Foot"></script>
<script asp-src="~/OrchardCore.Liquid/codemirror/liquid.js" at="Foot"></script>

<script asp-src="~/OrchardCore.Tenants/Scripts/tenant-task-editors/create-tenant-task.min.js" debug-src="~/OrchardCore.Tenants/Scripts/tenant-task-editors/create-tenant-task.js" at="Foot" type="module"></script>
