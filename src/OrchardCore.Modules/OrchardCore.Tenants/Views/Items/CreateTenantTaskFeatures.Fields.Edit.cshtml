@using OrchardCore.Tenants.Workflows.ViewModels
@model CreateTenantTaskViewModel

<div data-task-editor="create-tenant">
    <div class="ocat-wrapper" asp-validation-class-for="FeatureProfileExpression">
        <label asp-for="FeatureProfileExpression" class="ocat-label">@T["Feature Profile"]</label>
        <div class="ocat-end">
            <input type="text" asp-for="FeatureProfileExpression" class="form-control code" />
            <span asp-validation-for="FeatureProfileExpression"></span>
        </div>
    </div>
</div>
