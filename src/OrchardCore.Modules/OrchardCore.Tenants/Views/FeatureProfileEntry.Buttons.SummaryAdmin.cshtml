@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Tenants.ViewModels

@model ShapeViewModel<FeatureProfileEntry>

<a asp-action="Edit" asp-controller="FeatureProfiles" asp-route-id="@Model.Value.Id" class="btn btn-primary btn-sm">@T["Edit"]</a>

<a asp-action="Delete" asp-controller="FeatureProfiles" asp-route-id="@Model.Value.Id" class="btn btn-danger btn-sm" data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
