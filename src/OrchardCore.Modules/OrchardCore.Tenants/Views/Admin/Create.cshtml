@using OrchardCore.Tenants.Controllers

@model EditTenantViewModel

<zone Name="Title">
    <breadcrumb name="TenantsCreate" title="@T["Create Tenant"]">
        <breadcrumb-item id="Tenants" action="Index" controller="Admin" area="OrchardCore.Tenants" permission="@Permissions.ManageTenants.Name">@T["Tenants"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div asp-validation-summary="ModelOnly"></div>
<form asp-action="Create" method="post" class="no-multisubmit">

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary create" type="submit" name="action" value="create">@T["Create"]</button>
        <button class="btn btn-primary action-bar-secondary" type="submit" name="action" value="@AdminController.CreateAndSetupValue">@T["Create &amp; Setup"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>

<script at="Foot" asp-src="~/OrchardCore.Tenants/Scripts/tenant.js"></script>
