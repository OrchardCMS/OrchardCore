@model AdminIndexViewModel

<style asp-name="bootstrap-select" at="Head"></style>
<script asp-name="bootstrap-select" at="Foot"></script>

<zone Name="Title">
    <breadcrumb name="Tenants" title="@T["Tenants"]" />
</zone>

<form asp-action="Index" method="post" class="no-multisubmit bulk-select-list" data-checkbox-name="tenantNames" data-bulk-action-name="BulkAction" data-selected-text="@T["selected"]">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />
    <input name="BulkAction" type="hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group has-search">
                        <i class="fa-solid fa-search form-control-feedback" aria-hidden="true"></i>
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]">@T["Go"]</button>
                    </div>
                </div>
                <div class="col-auto">
                    <a asp-route-action="Create" class="btn btn-secondary create" role="button">@T["Add Tenant"]</a>
                </div>
            </div>
        </div>
    </div>

    @* The tenants, the toolbar and the pager are rendered by the AdminList shape using the configured layout (List, Grid, ...). *@
    @await DisplayAsync(Model.List)
</form>

<script asp-src="~/OrchardCore.Tenants/Scripts/tenants-admin-lists/tenants-admin-list.min.js" debug-src="~/OrchardCore.Tenants/Scripts/tenants-admin-lists/tenants-admin-list.js" at="Foot" type="module"></script>
