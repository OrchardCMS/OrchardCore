@using OrchardCore.DisplayManagement.Views
@using OrchardCore.Tenants.ViewModels

@model ShapeViewModel<FeatureProfileEntry>

<div class="form-check">
    <input type="checkbox" class="form-check-input" value="@Model.Value.Name" name="itemIds" id="itemIds-@Model.Value.Name">
    <label class="form-check-label" for="itemIds-@Model.Value.Name">&nbsp;<span class="visually-hidden">@T["Select {0}", Model.Value.Name]</span></label>
</div>
