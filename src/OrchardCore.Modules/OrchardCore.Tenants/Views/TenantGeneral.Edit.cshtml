@model EditTenantViewModel

@if (Model.IsNewTenant)
{
    <div class="ocat-wrapper" asp-validation-class-for="Name">
        <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
        <div class="ocat-end">
            <input asp-for="Name" class="form-control" autofocus />
            <span asp-validation-for="Name" class="text-danger"></span>
            <span class="hint">@T["The name of the tenant."]</span>
        </div>
    </div>
}
else
{
    <div class="ocat-wrapper" asp-validation-class-for="Name">
        <label asp-for="Name" class="ocat-label">@T["Name"]</label>
        <div class="ocat-end">
            <input asp-for="Name" class="form-control" readonly autofocus />
            <span asp-validation-for="Name" class="text-danger"></span>
            <span class="hint">@T["The name of the tenant."]</span>
        </div>
    </div>
}

<div class="ocat-wrapper" asp-validation-class-for="Description">
    <label asp-for="Description" class="ocat-label">@T["Description"]</label>
    <div class="ocat-end">
        <input asp-for="Description" class="form-control" autofocus />
        <span asp-validation-for="Description" class="text-danger"></span>
        <span class="hint">@T["The description of the tenant."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <label asp-for="Category" class="ocat-label">@T["Category"]</label>
    <div class="ocat-end">
        <input asp-for="Category" class="form-control" />
        <span class="hint">@T["The category of the tenant."]</span>
    </div>
</div>
