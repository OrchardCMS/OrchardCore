{
  "name": "RemoteManagement",
  "displayName": "Orchard Core Remote Management",
  "description": "Configures shared OpenID Connect authentication, token validation, and the remote management scope without registering client applications.",
  "author": "The Orchard Core Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": false,
  "categories": [
    "api",
    "security"
  ],
  "tags": [
    "openid",
    "openapi",
    "remote-management"
  ],
  "steps": [
    {
      "name": "feature",
      "enable": [
        "OrchardCore.RemoteManagement",
        "OrchardCore.OpenId.Management",
        "OrchardCore.OpenId.Server",
        "OrchardCore.OpenId.Validation"
      ]
    },
    {
      "name": "RemoteManagementConfiguration"
    },
    {
      "name": "ReloadTenant"
    }
  ]
}
