@using OrchardCore.ContentTypes
@using OrchardCore.Lists.ViewModels
@using OrchardCore.Localization.Data
@model ListPartSummaryAdminViewModel

@inject IDataLocalizer D

@if (Model.ContainedContentTypes.Length == 1)
{
    var contentType = Model.TypePartDefinition.Name == nameof(ListPart)
        ? Model.ContainedContentTypes[0]
        : Model.TypePartDefinition.DisplayName();
    <a class="btn btn-sm btn-secondary" admin-for="@Model.ContentItem" asp-route-partName="@Model.TypePartDefinition.Name">@T["List {0} Items", D[contentType, DataLocalizationContext.ContentType]]</a>
}
else
{
    <a class="btn btn-sm btn-secondary" admin-for="@Model.ContentItem">@T["List Items"]</a>
}
