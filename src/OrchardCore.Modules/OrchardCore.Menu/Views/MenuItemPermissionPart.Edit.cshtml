@model MenuItemPermissionViewModel

<style asp-name="bootstrap-select" at="Head"></style>
<script asp-name="bootstrap-select" at="Foot"></script>

<div class="ocat-wrapper">
    <label for="PermissionPicker" class="ocat-label">@T["Permissions"]</label>
    <div class="ocat-end">
        <div class="w-xl-50">
            <input type="hidden" asp-for="SelectedPermissionNames" />
            <select id="PermissionPicker" multiple data-permission-picker data-values-input="@Html.IdFor(m => m.SelectedPermissionNames)" data-live-search="true" data-show-selected-tags="true" data-selected-items-style="list" data-width="100%" placeholder="@T["Type to search"]" data-live-search-placeholder="@T["Search"]" data-none-results-text="@T["No permissions match {0}", "{0}"]" data-selected-tag-remove-label="@T["Remove"]">
                @foreach (var permission in Model.AllItems)
                {
                    <option value="@permission.Name" selected="@Model.SelectedItems.Any(item => item.Name == permission.Name)">@permission.DisplayText</option>
                }
            </select>
        </div>
        <span class="hint">@T["The permissions required to display this menu item (optional)."]</span>
    </div>
</div>

<script asp-src="~/OrchardCore.Menu/Scripts/menu-item-permission-part/menu-item-permission-part.min.js" debug-src="~/OrchardCore.Menu/Scripts/menu-item-permission-part/menu-item-permission-part.js" at="Foot" depends-on="bootstrap-select" type="module"></script>
