@model HtmlMenuItemPartSettingsViewModel

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" asp-for="SanitizeHtml" checked="@Model.SanitizeHtml" />
            <label class="form-check-label" asp-for="SanitizeHtml">@T["Sanitize Html"]</label>
            <span class="hint dashed">
                @T["Whether the Html is sanitized to prevent custom scripts."]
                <a class="seedoc" href="@(OrchardCore.Admin.Constants.DocsUrl)reference/modules/Sanitizer" target="_blank">@Localize(CommonLocalizationSources.SeeDocumentation)</a>
            </span>
        </div>
    </div>
</div>