<div class="alert alert-warning secrets-expiration-warning" role="alert">
    @if (Model.ExpiredCount > 0)
    {
        <span>@T.Plural((int)Model.ExpiredCount, "One secret has expired.", "{0} secrets have expired.")</span>
    }
    @if (Model.ExpiringCount > 0)
    {
        <span>@T.Plural((int)Model.ExpiringCount, "One secret expires within 30 days.", "{0} secrets expire within 30 days.")</span>
    }
    <a asp-area="OrchardCore.Secrets" asp-controller="Admin" asp-action="Index" class="alert-link">@T["Review secrets"]</a>
</div>
