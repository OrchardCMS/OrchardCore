@*
    The expiration and type filters of the secrets admin list, passed to the AdminListToolbar as its 'Actions' so they
    render at the end of the toolbar next to the bulk actions.
*@
@{
    var options = (SecretIndexOptions)Model.Options;
}

<div class="btn-group filter">
    <select asp-for="@options.Status" name="Options.Status" asp-items="@options.Statuses" class="selectpicker show-tick me-2" data-header="@T["Filter by expiration"]" data-selected-text-format="static" data-width="fit" data-dropdown-align-right="auto" title="@T["Expiration"]" data-style="btn-sm"></select>
    <select asp-for="@options.Type" name="Options.Type" asp-items="@options.Types" class="selectpicker show-tick" data-header="@T["Filter by type"]" data-selected-text-format="static" data-width="fit" data-dropdown-align-right="auto" title="@T["Type"]" data-style="btn-sm"></select>
</div>
