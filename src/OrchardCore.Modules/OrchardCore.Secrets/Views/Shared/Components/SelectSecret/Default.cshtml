@model OrchardCore.Secrets.ViewModels.SelectSecretViewModel

<select id="@Model.HtmlId" name="@Model.HtmlName" class="form-select @Model.CssClass">
    @foreach (var secret in Model.Secrets)
    {
        <option value="@secret.Value" selected="@secret.Selected">@secret.Text</option>
    }
</select>
