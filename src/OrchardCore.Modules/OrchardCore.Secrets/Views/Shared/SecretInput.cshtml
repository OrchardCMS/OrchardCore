@model SecretInputEditorViewModel
@*
    Rendered by the <secret-input> tag helper when the Secrets feature is enabled.
    The value can stay, protected, in the settings, reference an existing secret, or be moved to a new secret.
*@
@{
    var input = Model.Input ?? new SecretInputViewModel();
    var name = Model.HtmlName;
    var id = Model.HtmlId;
    var source = input.Source;

    string GetError(string propertyName)
        => ViewData.ModelState.TryGetValue(name + "." + propertyName, out var entry) && entry.Errors.Count > 0
            ? entry.Errors[0].ErrorMessage
            : null;

    string PanelClass(params SecretInputSource[] sources)
        => sources.Contains(source) ? null : "d-none";

    var valueError = GetError(nameof(SecretInputViewModel.Value));
    var secretNameError = GetError(nameof(SecretInputViewModel.SecretName));
    var newSecretNameError = GetError(nameof(SecretInputViewModel.NewSecretName));
    var valuePlaceholder = input.HasValue ? T["A value is stored. Enter a new value to replace it."].Value : Model.Placeholder;
}

<div class="secret-input" data-secret-input>
    <select id="@id" name="@(name).Source" class="form-select mb-2" aria-label="@T["Where the value is kept"]" data-secret-input-source>
        <option value="@SecretInputSource.Value" selected="@(source == SecretInputSource.Value)">@T["Keep the value in these settings"]</option>
        <option value="@SecretInputSource.Secret" selected="@(source == SecretInputSource.Secret)">@T["Use an existing secret"]</option>
        <option value="@SecretInputSource.NewSecret" selected="@(source == SecretInputSource.NewSecret)">@T["Store the value as a new secret"]</option>
    </select>

    <div class="@PanelClass(SecretInputSource.Secret)" data-secret-input-panel="@SecretInputSource.Secret">
        @await Component.InvokeAsync("SelectSecret", new
        {
            selectedSecret = input.SecretName,
            htmlId = id + "_SecretName",
            htmlName = name + "." + nameof(SecretInputViewModel.SecretName),
            secretTypes = new[] { nameof(TextSecret) },
            required = false,
            cssClass = secretNameError is null ? null : "is-invalid",
        })
        @if (secretNameError is not null)
        {
            <span class="text-danger field-validation-error">@secretNameError</span>
        }
    </div>

    <div class="@PanelClass(SecretInputSource.NewSecret)" data-secret-input-panel="@SecretInputSource.NewSecret">
        <div class="input-group mb-2">
            <label class="input-group-text" for="@(id)_NewSecretName">@T["Secret name"]</label>
            <input id="@(id)_NewSecretName" name="@(name).NewSecretName" value="@(input.NewSecretName ?? Model.SuggestedSecretName)" class="form-control @(newSecretNameError is null ? null : "is-invalid")" />
        </div>
        @if (newSecretNameError is not null)
        {
            <span class="text-danger field-validation-error d-block mb-2">@newSecretNameError</span>
        }
    </div>

    <div class="@PanelClass(SecretInputSource.Value, SecretInputSource.NewSecret)" data-secret-input-panel="@SecretInputSource.Value @SecretInputSource.NewSecret">
        <input type="password" id="@(id)_Value" name="@(name).Value" class="form-control @(valueError is null ? null : "is-invalid")" autocomplete="new-password" placeholder="@valuePlaceholder" />
        @if (valueError is not null)
        {
            <span class="text-danger field-validation-error">@valueError</span>
        }
        @if (input.HasValue)
        {
            <span class="hint d-block @PanelClass(SecretInputSource.NewSecret)" data-secret-input-panel="@SecretInputSource.NewSecret">@T["Leave the value empty to move the value currently kept in these settings."]</span>
        }
    </div>
</div>

<script at="Foot">
    document.querySelectorAll('[data-secret-input]:not([data-secret-input-ready])').forEach(function (root) {
        root.dataset.secretInputReady = 'true';

        var source = root.querySelector('[data-secret-input-source]');

        function update() {
            root.querySelectorAll('[data-secret-input-panel]').forEach(function (panel) {
                panel.classList.toggle('d-none', panel.dataset.secretInputPanel.split(' ').indexOf(source.value) < 0);
            });
        }

        source.addEventListener('change', update);
        update();
    });
</script>
