@model SecretInputEditorViewModel
@inject IAuthorizationService AuthorizationService
@*
    Rendered by the <secret-input> tag helper when the Secrets feature is enabled.
    The value is either entered and kept, protected, in the settings, or read from a secret.
*@
@{
    var input = Model.Input ?? new SecretInputViewModel();
    var name = Model.HtmlName;
    var id = Model.HtmlId;
    var useSecret = input.Source == SecretInputSource.Secret;
    var canViewSecrets = await AuthorizationService.AuthorizeAsync(User, SecretsPermissions.ViewSecrets);
    var canManageSecrets = await AuthorizationService.AuthorizeAsync(User, SecretsPermissions.ManageSecrets);

    string GetError(string propertyName)
        => ViewData.ModelState.TryGetValue(name + "." + propertyName, out var entry) && entry.Errors.Count > 0
            ? entry.Errors[0].ErrorMessage
            : null;

    var valueError = GetError(nameof(SecretInputViewModel.Value));
    var secretNameError = GetError(nameof(SecretInputViewModel.SecretName));
}

<div class="secret-input" data-secret-input data-secret-input-suggested="@Model.SuggestedSecretName">
    <select id="@id" name="@(name).Source" class="form-select mb-2" aria-label="@T["Where the value is kept"]" data-secret-input-source>
        <option value="@SecretInputSource.Value" selected="@(!useSecret)">@T["User-specified value"]</option>
        <option value="@SecretInputSource.Secret" selected="@useSecret">@T["Use a secret"]</option>
    </select>

    <div class="@(useSecret ? "d-none" : null)" data-secret-input-panel="@SecretInputSource.Value">
        <input type="password" id="@(id)_Value" name="@(name).Value" class="form-control @(valueError is null ? null : "is-invalid")" autocomplete="new-password" placeholder="@(input.HasValue ? T["The value is securely stored. Enter a new value to update it, or leave it blank to keep it."].Value : Model.Placeholder ?? T["Enter a new value"].Value)" />
        @if (valueError is not null)
        {
            <span class="text-danger field-validation-error">@valueError</span>
        }
        <span class="hint d-block">@T["The value is encrypted and stored with these settings."]</span>
    </div>

    <div class="@(useSecret ? null : "d-none")" data-secret-input-panel="@SecretInputSource.Secret">
        <div class="input-group" data-secret-input-secrets>
            @await Component.InvokeAsync("SelectSecret", new
            {
                selectedSecret = input.SecretName,
                htmlId = id + "_SecretName",
                htmlName = name + "." + nameof(SecretInputViewModel.SecretName),
                secretTypes = new[] { nameof(TextSecret) },
                required = false,
                cssClass = secretNameError is null ? null : "is-invalid",
            })
            @if (canViewSecrets)
            {
                <button type="button" class="btn btn-outline-secondary" title="@T["Reload the secrets"]" aria-label="@T["Reload the secrets"]" data-secret-input-reload="@Url.Action("SelectOptions", "Admin", new { area = "OrchardCore.Secrets", type = nameof(TextSecret) })">
                    <i class="fa-solid fa-rotate" aria-hidden="true"></i>
                </button>
            }
            @if (canManageSecrets)
            {
                <a class="btn btn-outline-secondary" target="_blank" rel="noopener" href="@Url.Action("Create", "Admin", new { area = "OrchardCore.Secrets", type = nameof(TextSecret), name = Model.SuggestedSecretName })">
                    <i class="fa-solid fa-plus" aria-hidden="true"></i> @T["New secret"]
                </a>
            }
        </div>
        @if (secretNameError is not null)
        {
            <span class="text-danger field-validation-error">@secretNameError</span>
        }
        @if (canManageSecrets)
        {
            <span class="hint d-block">@T["Create the secret in the new tab, then reload the secrets to select it."]</span>
        }
        @if (input.HasValue)
        {
            <span class="hint d-block">@T["The value currently stored with these settings is removed once a secret is selected."]</span>
        }
    </div>
</div>

<script at="Foot">
    document.querySelectorAll('[data-secret-input]:not([data-secret-input-ready])').forEach(function (root) {
        root.dataset.secretInputReady = 'true';

        var source = root.querySelector('[data-secret-input-source]');

        function update() {
            root.querySelectorAll('[data-secret-input-panel]').forEach(function (panel) {
                panel.classList.toggle('d-none', panel.dataset.secretInputPanel !== source.value);
            });
        }

        source.addEventListener('change', update);
        update();

        var reload = root.querySelector('[data-secret-input-reload]');

        if (!reload) {
            return;
        }

        reload.addEventListener('click', function () {
            var select = root.querySelector('[data-secret-input-secrets] select');
            var selected = select.value;

            reload.disabled = true;

            fetch(reload.dataset.secretInputReload, { credentials: 'same-origin' })
                .then(function (response) {
                    if (!response.ok) {
                        throw new Error(response.statusText);
                    }

                    return response.text();
                })
                .then(function (html) {
                    var options = new DOMParser().parseFromString(html, 'text/html').querySelectorAll('option');

                    select.replaceChildren.apply(select, Array.from(options).map(function (option) {
                        return document.importNode(option, true);
                    }));

                    function exists(value) {
                        return !!value && Array.from(select.options).some(function (option) { return option.value === value; });
                    }

                    // Keep the current selection when the secret still exists, or select the suggested one once created.
                    if (exists(selected)) {
                        select.value = selected;
                    } else if (exists(root.dataset.secretInputSuggested)) {
                        select.value = root.dataset.secretInputSuggested;
                    }
                })
                .catch(function (error) {
                    console.error(error);
                })
                .finally(function () {
                    reload.disabled = false;
                });
        });
    });
</script>
