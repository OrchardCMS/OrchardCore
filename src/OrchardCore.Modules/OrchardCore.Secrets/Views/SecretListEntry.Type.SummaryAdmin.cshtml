@model ShapeViewModel<SecretListEntry>

@* The badge links to the list filtered by that type. *@
<span class="badge ta-badge fw-normal">
    <i class="fa-solid fa-key text-secondary" aria-hidden="true"></i> <a asp-controller="Admin" asp-action="Index" asp-route-Options.Type="@Model.Value.Type" data-bs-toggle="tooltip" title="@T["Show the secrets of this type"]">@Model.Value.TypeDisplayName</a>
</span>
