@model SecretEditViewModel

<zone Name="Title">
    @if (Model.IsNew)
    {
        <breadcrumb name="SecretsCreate" title="@T["New {0}", Model.SecretTypeDisplayName]">
            <breadcrumb-item id="Secrets" action="Index" controller="Admin" area="OrchardCore.Secrets" permission="@SecretsPermissions.ViewSecrets.Name">@T["Secrets"]</breadcrumb-item>
        </breadcrumb>
    }
    else
    {
        <breadcrumb name="SecretsEdit" title="@T["Edit '{0}' secret", Model.Name]">
            <breadcrumb-item id="Secrets" action="Index" controller="Admin" area="OrchardCore.Secrets" permission="@SecretsPermissions.ViewSecrets.Name">@T["Secrets"]</breadcrumb-item>
        </breadcrumb>
    }
</zone>

<form asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-store="@(Model.IsNew ? null : Model.Store)" method="post" class="no-multisubmit">
    <input type="hidden" asp-for="SecretType" />

    @if (Model.IsNew)
    {
        <div class="ocat-wrapper" asp-validation-class-for="Name">
            <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
            <div class="ocat-end">
                <input asp-for="Name" class="form-control" autofocus />
                <span asp-validation-for="Name"></span>
                <span class="hint">@T["A unique name used by the settings that reference this secret, for instance <code>Smtp.Password</code>. It cannot be changed later."]</span>
            </div>
        </div>
    }
    else
    {
        <input type="hidden" asp-for="Name" />
        <input type="hidden" asp-for="Store" />
    }

    @{
        var selectStore = Model.IsNew && Model.AvailableStores.Count > 1;
    }
    <div class="ocat-wrapper" asp-validation-class-for="Store">
        <label for="@(selectStore ? Html.IdFor(m => m.Store) : "store-display")" class="ocat-label">@T["Store"]</label>
        <div class="ocat-end">
            @if (selectStore)
            {
                <select asp-for="Store" asp-items="@(new SelectList(Model.AvailableStores))" class="form-select"></select>
                <span class="hint">@T["The secret store where this secret is saved."]</span>
            }
            else
            {
                @if (Model.IsNew)
                {
                    <input type="hidden" asp-for="Store" />
                }
                <input id="store-display" class="form-control-plaintext" value="@Model.Store" readonly />
                @if (!Model.IsNew)
                {
                    <span class="hint">@T["To keep this secret in another store, use the <a href=\"{0}\">Move</a> action.", Url.Action("Index", "Store", new { area = "OrchardCore.Secrets", name = Model.Name, sourceStore = Model.Store })]</span>
                }
            }
            <span asp-validation-for="Store"></span>
        </div>
    </div>

    @if (Model.SecretType == nameof(TextSecret))
    {
        <div class="ocat-wrapper" asp-validation-class-for="TextValue">
            <label asp-for="TextValue" class="ocat-label @(Model.IsNew ? "ocat-label-required" : null)">@T["Value"]</label>
            <div class="ocat-end">
                <input asp-for="TextValue" type="password" class="form-control" autocomplete="new-password" placeholder="@(Model.IsNew ? T["Enter the secret value"] : T["Enter a new value to replace the current one"])" />
                <span asp-validation-for="TextValue"></span>
                @if (!Model.IsNew)
                {
                    <span class="hint">@T["Leave empty to keep the current value. Stored values are never displayed."]</span>
                }
            </div>
        </div>
    }
    else if (Model.SecretType == nameof(RsaKeySecret))
    {
        @if (Model.IsNew)
        {
            <div class="ocat-limited-wrapper" asp-validation-class-for="RsaKeySize">
                <label asp-for="RsaKeySize" class="ocat-label">@T["Key size"]</label>
                <div class="ocat-limited">
                    <select asp-for="RsaKeySize" class="form-select">
                        <option value="2048">@T["2048 bits"]</option>
                        <option value="3072">@T["3072 bits"]</option>
                        <option value="4096">@T["4096 bits"]</option>
                    </select>
                    <span asp-validation-for="RsaKeySize"></span>
                    <span class="hint">@T["A new RSA key pair is generated with this key size."]</span>
                </div>
            </div>
        }
        else
        {
            <div class="ocat-wrapper">
                <div class="ocat-end-offset">
                    <div class="alert alert-info mb-0" role="alert">
                        @T["The RSA key is stored securely. The private key cannot be displayed."]
                    </div>
                </div>
            </div>
        }
    }
    else if (Model.SecretType == nameof(X509Secret))
    {
        <div class="ocat-wrapper" asp-validation-class-for="X509StoreLocation">
            <label asp-for="X509StoreLocation" class="ocat-label">@T["Store location"]</label>
            <div class="ocat-end">
                <select asp-for="X509StoreLocation" class="form-select">
                    <option value="CurrentUser">@T["Current user"]</option>
                    <option value="LocalMachine">@T["Local machine"]</option>
                </select>
                <span asp-validation-for="X509StoreLocation"></span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="X509StoreName">
            <label asp-for="X509StoreName" class="ocat-label">@T["Store name"]</label>
            <div class="ocat-end">
                <select asp-for="X509StoreName" class="form-select">
                    <option value="My">@T["Personal (My)"]</option>
                    <option value="Root">@T["Trusted root certification authorities (Root)"]</option>
                    <option value="CA">@T["Intermediate certification authorities (CA)"]</option>
                    <option value="TrustedPeople">@T["Trusted people"]</option>
                </select>
                <span asp-validation-for="X509StoreName"></span>
            </div>
        </div>
        <div class="ocat-wrapper" asp-validation-class-for="X509Thumbprint">
            <label asp-for="X509Thumbprint" class="ocat-label ocat-label-required">@T["Thumbprint"]</label>
            <div class="ocat-end">
                <input asp-for="X509Thumbprint" class="form-control" placeholder="@T["Certificate thumbprint (SHA-1)"]" />
                <span asp-validation-for="X509Thumbprint"></span>
                <span class="hint">@T["The SHA-1 thumbprint of the certificate to use."]</span>
            </div>
        </div>
    }

    <div class="ocat-wrapper" asp-validation-class-for="Description">
        <label asp-for="Description" class="ocat-label">@T["Description"]</label>
        <div class="ocat-end">
            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Description"></span>
            <span class="hint">@T["An optional description of this secret."]</span>
        </div>
    </div>

    <div class="ocat-wrapper" asp-validation-class-for="ExpiresUtc">
        <label asp-for="ExpiresUtc" class="ocat-label">@T["Expiration date"]</label>
        <div class="ocat-end">
            <input asp-for="ExpiresUtc" type="date" class="form-control" />
            <span asp-validation-for="ExpiresUtc"></span>
            <span class="hint">@T["Optional. This is informational only and does not disable the secret. Use it for rotation reminders and alerts."]</span>
        </div>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary save" type="submit">@T["Save"]</button>
            <a class="btn btn-secondary cancel" asp-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>
