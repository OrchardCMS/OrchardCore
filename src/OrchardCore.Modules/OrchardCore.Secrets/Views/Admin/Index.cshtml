@model SecretIndexViewModel
@inject IAuthorizationService AuthorizationService
@{
    var canManage = await AuthorizationService.AuthorizeAsync(User, SecretsPermissions.ManageSecrets);
}

<style asp-name="bootstrap-select" at="Head"></style>
<script asp-name="bootstrap-select" at="Foot"></script>

<zone Name="Title">
    <breadcrumb name="Secrets" title="@T["Secrets"]" />
</zone>

@if (Model.ExpiredCount > 0 || Model.ExpiringCount > 0)
{
    @await DisplayAsync(await New.SecretsExpirationWarning(ExpiredCount: Model.ExpiredCount, ExpiringCount: Model.ExpiringCount, ShowReviewLink: false))
}

@* The form is necessary to generate an antiforgery token for the delete and bulk actions. *@
<form asp-action="Index" method="post" class="no-multisubmit" data-list-management data-filter-submit="true" data-min-selected-items="1" data-selected-label="@T["selected"]">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input asp-for="Options.BulkAction" type="hidden" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />

    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" asp-for="Options.Search" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" value="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                @if (canManage)
                {
                    <div class="col-auto">
                        <button type="button" class="btn btn-secondary create" data-bs-toggle="modal" data-bs-target="#modalSecretTypes">@T["Add Secret"]</button>
                    </div>
                }
            </div>
        </div>
    </div>

    @* The secrets, the toolbar and the pager are rendered by the AdminList shape using the configured layout (List,
       Grid) and actions layout (Buttons, Menu). *@
    <admin-list name="Secrets" context="Model.List"
                empty-message="@(Model.Options.HasFilters
                    ? T["No results found."]
                    : T["<strong>Nothing here!</strong> There are no secrets stored. Click 'Add Secret' to create one."])">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            @if (canManage)
            {
                <admin-list-column type="Select" />
            }
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column name="Type" position="30" title="@T["Type"]" width="auto" />
            <admin-list-column name="Store" position="40" title="@T["Store"]" width="auto" />
            <admin-list-column name="Expiration" position="50" title="@T["Expiration"]" width="auto" />
            <admin-list-column name="Updated" position="60" title="@T["Updated"]" width="auto" no-wrap="true" />
            @if (canManage)
            {
                <admin-list-column type="Actions" title="@T["Actions"]" />
            }
        </admin-list-grid>
    </admin-list>
</form>

@if (canManage)
{
    <!-- Modal for selecting secret type -->
    <div class="modal fade" id="modalSecretTypes" tabindex="-1" role="dialog" aria-labelledby="available-secret-types-title" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="available-secret-types-title">@T["Select Secret Type"]</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
                </div>
                <div class="modal-body">
                    <div class="row row-cols-1 row-cols-md-2 g-2">
                        @foreach (var secretType in Model.AvailableTypes)
                        {
                            <div class="col">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h5 class="card-title">@secretType.DisplayName</h5>
                                        <p class="card-text text-muted small">@secretType.Description</p>
                                    </div>
                                    <div class="card-footer bg-transparent text-end">
                                        <a asp-action="Create" asp-route-type="@secretType.Name" class="btn btn-primary btn-sm">@T["Create"]</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Cancel"]</button>
                </div>
            </div>
        </div>
    </div>
}

<script asp-name="list-management" at="Foot"></script>
