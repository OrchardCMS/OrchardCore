@model OrchardCore.Secrets.ViewModels.SecretsDeploymentStepViewModel

<div class="ocat-wrapper" asp-validation-class-for="EncryptionKeyName">
    <label asp-for="EncryptionKeyName" class="ocat-label">@T["Encryption key"]</label>
    <div class="ocat-end">
        <select asp-for="EncryptionKeyName" class="form-select">
            <option value="">@T["No encryption: metadata only"]</option>
            @foreach (var key in Model.AvailableEncryptionKeys)
            {
                <option value="@key" selected="@(key == Model.EncryptionKeyName)">@key</option>
            }
        </select>
        <span asp-validation-for="EncryptionKeyName"></span>
        <span class="hint">@T["An RSA key or X.509 certificate secret that encrypts the secret values during the export. The target site must have the same key to import them."]</span>
    </div>
</div>

@if (!Model.AvailableEncryptionKeys.Any())
{
    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <div class="alert alert-warning" role="alert">
                @T["No encryption key is available. Create an RSA key or X.509 certificate secret to export secret values."]
            </div>
        </div>
    </div>
}

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <div class="alert alert-info mb-0" role="alert">
            <p><strong>@T["With an encryption key:"]</strong> @T["Secret values are encrypted with hybrid RSA and AES encryption, and included in the export. The target site must have the same key, with its private key, to decrypt them."]</p>
            <p class="mb-0"><strong>@T["Without an encryption key:"]</strong> @T["Only the names and metadata of the secrets are exported. During the import, their values are read from the configuration, for instance the <code>OrchardCore__Secrets__{{SecretName}}</code> environment variable."]</p>
        </div>
    </div>
</div>
