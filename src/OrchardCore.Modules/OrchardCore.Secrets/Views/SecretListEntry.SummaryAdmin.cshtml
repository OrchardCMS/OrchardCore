@* The row of the List layout. The actions sit beside the whole row, centred on it, and everything else is stacked in
   the column left of them, so the description stops where the actions begin. The Grid layout does not use this
   template: it renders the zones of the row in the columns the index view declares. *@
<div class="row g-0 align-items-center">
    <div class="col">
        <div class="title d-flex align-items-center">
            @if (Model.Checkbox != null)
            {
                <div class="selectors-container d-flex me-2">
                    @await DisplayAsync(Model.Checkbox)
                </div>
            }
            <div class="summary d-flex flex-column flex-md-row list-item-search-text">
                <div class="me-2">
                    @if (Model.Content != null)
                    {
                        @await DisplayAsync(Model.Content)
                    }
                </div>

                @* Each fact of a secret has a column of its own in the Grid layout, so the List layout renders them one
                   after the other to keep the same row. *@
                @if (Model.Type != null)
                {
                    <div class="tags me-1">
                        @await DisplayAsync(Model.Type)
                    </div>
                }
                @if (Model.Store != null)
                {
                    <div class="tags me-1">
                        @await DisplayAsync(Model.Store)
                    </div>
                }
                @if (Model.Expiration != null)
                {
                    <div class="tags me-1">
                        @await DisplayAsync(Model.Expiration)
                    </div>
                }
                @if (Model.Updated != null)
                {
                    <div class="metadata me-1">
                        @await DisplayAsync(Model.Updated)
                    </div>
                }
            </div>
        </div>

        @if (Model.Description != null)
        {
            @await DisplayAsync(Model.Description)
        }
    </div>
    <div class="col-auto d-flex justify-content-end ps-2">
        @* The Actions zone is rendered in the layout configured in the admin settings (Buttons, Menu). *@
        @await DisplayAsync(await Factory.CreateAdminListActionsAsync((IShape)Model))
    </div>
</div>
