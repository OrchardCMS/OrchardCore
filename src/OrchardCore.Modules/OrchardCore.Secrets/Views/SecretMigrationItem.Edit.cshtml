@model SecretMigrationItemViewModel

<div class="list-group-item">
    <div class="row gx-3 gy-2 align-items-center">
        <div class="col-md-6 col-12">
            <div class="form-check">
                <input asp-for="Migrate" class="form-check-input" />
                <label asp-for="Migrate" class="form-check-label">
                    <span class="badge ta-badge fw-normal me-1"><i class="fa-solid fa-puzzle-piece text-secondary" aria-hidden="true"></i> @Model.Group</span>
                    @Model.DisplayName
                </label>
            </div>
        </div>
        <div class="col-md-6 col-12">
            <div class="input-group input-group-sm">
                <label asp-for="SecretName" class="input-group-text">@T["Secret name"]</label>
                <input asp-for="SecretName" class="form-control" />
            </div>
            <span asp-validation-for="SecretName"></span>
        </div>
    </div>
</div>
