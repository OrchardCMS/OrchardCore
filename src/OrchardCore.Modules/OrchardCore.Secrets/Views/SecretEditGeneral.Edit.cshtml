@model SecretEditViewModel

@if (Model.IsNew)
{
    <div class="ocat-wrapper" asp-validation-class-for="Name">
        <label asp-for="Name" class="ocat-label ocat-label-required">@T["Name"]</label>
        <div class="ocat-end">
            <input asp-for="Name" class="form-control" autofocus />
            <span asp-validation-for="Name"></span>
            <span class="hint">@T["A unique name used by the settings that reference this secret, for instance <code>Smtp.Password</code>. It cannot be changed later."]</span>
        </div>
    </div>
}
else
{
    <input type="hidden" asp-for="Name" />
    <input type="hidden" asp-for="Store" />
}

@{
    var selectStore = Model.IsNew && Model.AvailableStores.Count > 1;
}
<div class="ocat-wrapper" asp-validation-class-for="Store">
    <label for="@(selectStore ? Html.IdFor(m => m.Store) : "store-display")" class="ocat-label @(selectStore ? "ocat-label-required" : null)">@T["Store"]</label>
    <div class="ocat-end">
        @if (selectStore)
        {
            <select asp-for="Store" asp-items="@(new SelectList(Model.AvailableStores))" class="form-select"></select>
            <span class="hint">@T["The secret store where this secret is saved."]</span>
        }
        else
        {
            @if (Model.IsNew)
            {
                <input type="hidden" asp-for="Store" />
            }
            <input id="store-display" class="form-control-plaintext" value="@Model.Store" readonly />
            @if (!Model.IsNew)
            {
                <span class="hint">@T["To keep this secret in another store, use the <a href=\"{0}\">Move</a> action.", Url.Action("Index", "Store", new { area = "OrchardCore.Secrets", name = Model.Name, sourceStore = Model.Store })]</span>
            }
        }
        <span asp-validation-for="Store"></span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="Description">
    <label asp-for="Description" class="ocat-label">@T["Description"]</label>
    <div class="ocat-end">
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Description"></span>
        <span class="hint">@T["An optional description of this secret."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="ExpiresUtc">
    <label asp-for="ExpiresUtc" class="ocat-label">@T["Expiration date"]</label>
    <div class="ocat-end">
        <input asp-for="ExpiresUtc" type="date" class="form-control" />
        <span asp-validation-for="ExpiresUtc"></span>
        <span class="hint">@T["Optional. This is informational only and does not disable the secret. Use it for rotation reminders and alerts."]</span>
    </div>
</div>
