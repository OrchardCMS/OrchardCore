@model ShapeViewModel<SecretListEntry>

@{
    var secret = Model.Value;
}

<a asp-controller="Admin" asp-action="Edit" asp-route-name="@secret.Name" asp-route-store="@secret.Store" class="btn btn-sm btn-primary">@T["Edit"]</a>
<a asp-controller="Store" asp-action="Index" asp-route-name="@secret.Name" asp-route-sourceStore="@secret.Store" class="btn btn-sm btn-secondary">@T["Move"]</a>
<a asp-controller="Admin" asp-action="Delete" asp-route-name="@secret.Name" asp-route-store="@secret.Store" class="btn btn-sm btn-danger" data-url-af="RemoveUrl UnsafeUrl" data-title="@T["Delete Secret"]" data-message="@T["Are you sure you want to delete the secret '{0}'?", secret.Name]">@T["Delete"]</a>
