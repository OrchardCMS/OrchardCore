@model SecretStoreViewModel

<zone Name="Title"><h1>@RenderTitleSegments(T["Manage Secret Store"])</h1></zone>

<div asp-validation-summary="All"></div>

<div class="alert alert-warning">
    @T["Move verifies the destination before deleting the source and keeps the logical secret name. Existing destination names are never overwritten. Secret values stay on the server."]
    @T["Source deletion uses the provider's existing delete operation. Key Vault soft-delete retention, database backups, and transaction logs are not erased by a move."]
</div>

<form asp-action="Index" method="get" class="mb-3">
    <label for="inspect-store" class="form-label">@T["Inspect a store"]</label>
    <div class="input-group">
        <select id="inspect-store" name="sourceStore" class="form-select">
            @foreach (var store in Model.AvailableStores)
            {
                <option value="@store" selected="@(store == Model.SourceStore)">@store</option>
            }
        </select>
        <button class="btn btn-secondary" type="submit">@T["Inspect"]</button>
    </div>
</form>

@if (Model.ActiveCount.HasValue)
{
    <p>@T["Store: {0}. Active secrets: {1}.", Model.SourceStore, Model.ActiveCount.Value]</p>
    @if (Model.ActiveCount == 0)
    {
        <div class="alert alert-info">
            @T["This tenant has no active secrets visible through this store. Verify the destination integrations and every other tenant before disabling its feature."]
            @T["This does not erase database backups, transaction logs, exported copies, audit history, or storage-provider retention. Rotate credentials if old copies must no longer be usable."]
        </div>
    }
}

<form asp-action="Index" method="post" class="no-multisubmit">
    <input asp-for="SourceStore" type="hidden" />
    <input asp-for="Name" type="hidden" />
    @if (!string.IsNullOrEmpty(Model.Name))
    {
        <p>@T["Move secret: {0}", Model.Name]</p>
    }
    else
    {
        <p>@T["Move all active secrets from this source store."]</p>
    }
    <div class="mb-3">
        <label asp-for="DestinationStore" class="form-label">@T["Destination store"]</label>
        <select asp-for="DestinationStore" class="form-select">
            <option value="">@T["Select a destination"]</option>
            @foreach (var store in Model.AvailableStores.Where(store => !store.Equals(Model.SourceStore, StringComparison.OrdinalIgnoreCase)))
            {
                <option value="@store">@store</option>
            }
        </select>
    </div>
    <div class="mb-3 form-check">
        <input asp-for="Confirm" class="form-check-input" />
        <label asp-for="Confirm" class="form-check-label">@T["I confirm this move and deletion of the source after destination verification."]</label>
    </div>
    <button type="submit" class="btn btn-primary">@T["Execute"]</button>
    <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">@T["Back to Secrets"]</a>
</form>

@if (Model.Results.Count > 0)
{
    <h2 class="mt-4">@T["Operation results"]</h2>
    <table class="table">
        <thead><tr><th>@T["Secret"]</th><th>@T["Result"]</th><th>@T["Destination verified and source removed"]</th></tr></thead>
        <tbody>
            @foreach (var result in Model.Results)
            {
                <tr>
                    <td>@result.Name</td>
                    <td>@(result.Succeeded ? T["Succeeded"] : T["Failed: {0}", result.Failure])</td>
                    <td>
                        @(result.Succeeded ? T["Yes"] : result.DestinationSaved ? T["No. A destination copy exists; inspect both stores before retrying."] : T["No. The source was not intentionally deleted."])
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
