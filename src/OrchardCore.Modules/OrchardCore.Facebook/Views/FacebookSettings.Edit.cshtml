@using OrchardCore.Facebook.ViewModels
@model FacebookSettingsViewModel

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <p class="alert alert-warning" role="alert">
            @T["The website might be restarted upon saving the settings, potentially leading to temporary unresponsiveness during the process."]
            <a class="seedoc" href="@(OrchardCore.Admin.Constants.DocsUrl)reference/modules/Facebook/#core-components" target="_blank">@T["See documentation"]</a>
        </p>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="AppId">
    <label asp-for="AppId" class="ocat-label ocat-label-required">@T["Application Identifier"]</label>
    <div class="ocat-end">
        <input asp-for="AppId" class="form-control" autocomplete="off" />
        <span asp-validation-for="AppId"></span>
        <span class="hint">@T["The Application ID found on the Meta developer portal parameters."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="AppSecret">
    <label asp-for="AppSecret" class="ocat-label">@T["Secret Key"]</label>
    <div class="ocat-end">
        <secret-input asp-for="AppSecret" secret-name="@FacebookConstants.SecretNames.AppSecret" />
        <span class="hint">@T["The Application secret key found on the Meta developer portal parameters."]</span>
    </div>
</div>
