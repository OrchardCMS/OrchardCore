@using OrchardCore.BackgroundTasks.ViewModels
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<BackgroundTaskEntry>

<span class="badge ta-badge fw-normal" data-bs-toggle="tooltip" title="@T["Status"]">
    <i class="fa-solid @(Model.Value.Enable ? "fa-check text-success" : "fa-ban text-secondary")" aria-hidden="true"></i>
    @(Model.Value.Enable ? T["Enabled"] : T["Disabled"])
</span>
