@model BackgroundTaskViewModel

<zone Name="Title">
    <breadcrumb name="BackgroundTasksEdit" title="@T["Edit Task Settings"]">
        <breadcrumb-item id="BackgroundTasks" action="Index" controller="BackgroundTask" area="OrchardCore.BackgroundTasks" permission="@Permissions.ManageBackgroundTasks.Name">@T["Background Tasks"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div asp-validation-summary="ModelOnly"></div>
<form asp-action="Edit" method="post" class="no-multisubmit">
    <input asp-for="DefaultSchedule" class="form-control background-task-default-schedule" type="hidden" />

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary save" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>

<script asp-src="~/OrchardCore.BackgroundTasks/Scripts/background-task-editors/background-task-edit.min.js" debug-src="~/OrchardCore.BackgroundTasks/Scripts/background-task-editors/background-task-edit.js" at="Foot" type="module"></script>
