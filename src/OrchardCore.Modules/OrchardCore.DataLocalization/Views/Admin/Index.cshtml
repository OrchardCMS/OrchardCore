@model OrchardCore.DataLocalization.ViewModels.TranslationEditorViewModel
@using System.Text.Json

@{
    var culturesJson = JConvert.SerializeObject(Model.AllowedCultures, JOptions.CamelCase);
    var providersJson = JConvert.SerializeObject(Model.Providers, JOptions.CamelCase);
    var messagesJson = JConvert.SerializeObject(new
    {
        saved = T["Translations saved successfully."].Value,
        failedDefault = T["Failed to save translations."].Value,
        savingError = T["An error occurred while saving."].Value,
        discardConfirm = T["You have unsaved changes. Do you want to discard them?"].Value,
        loadError = T["Failed to load translations."].Value,
        incompletePlural = T["Supply every required plural form, or restore fallback."].Value,
        importError = T["Failed to import translations."].Value,
        imported = T["Translations imported successfully."].Value,
        importFileRequired = T["Select a PO file no larger than 2 MB."].Value,
    }, JOptions.CamelCase);
}

<zone Name="Title">
    @if (Model.IsUiLocalization)
    {
        <h1>@T["UI Translations"]</h1>
    }
    else
    {
        <breadcrumb name="DynamicTranslations" title="@T["Dynamic Translations"]" />
    }
</zone>

@if (Model.IsReadOnly)
{
    <div class="alert alert-info" role="alert">
        @(Model.IsUiLocalization
            ? T["You have read-only access to UI translations. Contact an administrator to request edit permissions."]
            : T["You have read-only access to dynamic translations. Contact an administrator to request edit permissions."])
    </div>
}

<div id="translation-editor"
     data-current-culture="@Model.CurrentCulture"
     data-is-read-only="@Model.IsReadOnly.ToString().ToLowerInvariant()"
     data-ui-localization="@Model.IsUiLocalization.ToString().ToLowerInvariant()"
     data-search="@Model.Search"
     data-save-url="@Url.Action("Save", Model.IsUiLocalization ? "UiTranslations" : "Admin", new { area = "OrchardCore.DataLocalization" })"
     data-get-strings-url="@Url.Action("GetStrings", Model.IsUiLocalization ? "UiTranslations" : "Admin", new { area = "OrchardCore.DataLocalization" })"
     data-import-url="@Url.Action("Import", "UiTranslations", new { area = "OrchardCore.DataLocalization" })"
     data-export-url="@Url.Action("Export", "UiTranslations", new { area = "OrchardCore.DataLocalization" })"
     data-cultures="@culturesJson"
     data-providers="@providersJson"
     data-messages="@messagesJson">

    @Html.AntiForgeryToken()

    <!-- Filters -->
    <div class="row g-3">
        <div class="ocat-wrapper col-xl-3 col-sm-6">
            <label class="ocat-label" for="culture-select">@T["Culture"]</label>
            <div class="ocat-end">
                <select id="culture-select" class="form-select" v-model="currentCulture" @@change="onCultureChange">
                    <option v-for="culture in cultures" :key="culture.name" :value="culture.name">
                        {{ culture.displayName }} ({{ culture.name }})
                    </option>
                </select>
            </div>
        </div>
        <div class="ocat-wrapper col-xl-3 col-sm-6">
            <label class="ocat-label" for="filter-select">@(Model.IsUiLocalization ? T["Assembly"] : T["Category"])</label>
            <div class="ocat-end">
                <select id="filter-select" class="form-select" v-model="categoryFilter">
                    <option value="">@(Model.IsUiLocalization ? T["All assemblies"] : T["All Categories"])</option>
                    <option v-for="provider in providers" :key="provider.name" :value="provider.name">
                        {{ provider.name }}
                    </option>
                </select>
            </div>
        </div>
        <div class="ocat-wrapper col-xl-4 col-sm-8">
            <label class="ocat-label" for="search-box">@T["Search"]</label>
            <div class="ocat-end">
                <div class="input-group filter-options">
                    <input id="search-box" type="search" class="form-control" v-model="searchQuery" placeholder="@T["Search translations"]" autocomplete="off" />
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-sm-4">
            <div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="missing-only-toggle" v-model="showMissingOnly">
                    <label class="form-check-label" for="missing-only-toggle">@T["Missing only"]</label>
                </div>
                <div class="form-check" v-if="!isReadOnly">
                    <input class="form-check-input" type="checkbox" id="auto-save-toggle" v-model="autoSave">
                    <label class="form-check-label" for="auto-save-toggle">@T["Auto-save"]</label>
                </div>
            </div>
        </div>
    </div>

    @if (Model.IsUiLocalization)
    {
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                <p class="hint">@T["Overrides are plain text. HTML is encoded when displayed. Supply every plural form, or restore fallback."]</p>
                <a class="btn btn-secondary" :href="exportUrl + '?culture=' + encodeURIComponent(loadedCulture)"
                   :class="{ disabled: isDirty || isLoading || isSaving }" :aria-disabled="isDirty || isLoading || isSaving"
                   @@click="(isDirty || isLoading || isSaving) && $event.preventDefault()">@T["Export overrides"]</a>
            </div>
        </div>
        <div class="ocat-wrapper" v-if="!isReadOnly">
            <label for="import-file" class="ocat-label">@T["Import overrides"]</label>
            <div class="ocat-end">
                <div class="input-group">
                    <input id="import-file" type="file" accept=".po" class="form-control" @@change="onImportFileChange" :disabled="isSaving || isLoading" />
                    <button type="button" class="btn btn-secondary" @@click="importTranslations" :disabled="!importFile || isSaving || isLoading">@T["Import"]</button>
                </div>
                <span class="hint">@T["UTF-8 PO file, up to 2 MB. The entire file is validated before saving. Empty translations remove overrides."]</span>
            </div>
        </div>
    }

    <!-- Status indicator -->
    <div class="mb-3" v-if="isDirty && !isReadOnly">
        <div>
            <span class="badge text-bg-warning">@T["Unsaved changes"]</span>
        </div>
    </div>

    <!-- Loading state -->
    <div v-if="isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">@T["Loading..."]</span>
        </div>
    </div>

    <!-- Translation groups -->
    <div v-if="!isLoading">
        <fieldset class="translations-list mb-3" v-for="(provider, index) in filteredProviders" :key="provider.name">
            <legend>
                <span class="me-1">{{ provider.name }}</span>
                <span class="hint">({{ getTotalStringsCount(provider) }} @T["strings"]<span v-if="getTotalTranslatedCount(provider) > 0">, {{ getTotalTranslatedCount(provider) }} @T["translated"]</span>)</span>
            </legend>

            <!-- Ungrouped strings (no sub-groups) -->
            <table v-if="getFilteredStrings(provider.strings).length > 0" class="table">
                <thead>
                    <tr>
                        <th class="col-5">@T["Original"]</th>
                        <th class="col-7">@T["Translation"]</th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-for="str in getFilteredStrings(provider.strings)" :key="str.context + '|' + str.key" :data-text="str.key.toLowerCase()">
                        <td class="col-5">
                            <code>{{ str.key }}</code>
                        </td>
                        <td class="col-7">
                            <input type="text" class="form-control"
                                   v-model="str.value"
                                   :disabled="isReadOnly || isLoading"
                                   :placeholder="str.key"
                                   @@input="onTranslationChange(str)" />
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- Sub-groups -->
            <div v-for="subGroup in getFilteredSubGroups(provider)" :key="subGroup.name" class="ms-3 mb-3">
                <h6 class="text-muted border-bottom pb-1">
                    {{ subGroup.name }}
                    <span class="hint">({{ getFilteredStrings(subGroup.strings).length }} @T["strings"])</span>
                </h6>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th class="col-5">@T["Original"]</th>
                            <th class="col-7">@T["Translation"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="str in getFilteredStrings(subGroup.strings)" :key="str.context + '|' + str.key" :data-text="str.key.toLowerCase()">
                            <td class="col-5">
                                <code>{{ str.key }}</code>
                                @if (Model.IsUiLocalization)
                                {
                                    <div v-if="str.plural" class="hint">{{ str.plural }}</div>
                                    <details>
                                        <summary>@T["Source metadata"]</summary>
                                        <pre>{{ (str.metadata || []).join('\n') }}</pre>
                                    </details>
                                }
                            </td>
                            <td class="col-7">
                                @if (Model.IsUiLocalization)
                                {
                                    <div v-for="(value, form) in str.values" :key="form" class="ocat-wrapper">
                                        <label :for="'translation-' + index + '-' + subGroup.name + '-' + str.key + '-' + form" class="ocat-label">@T["Translation"] {{ form }}</label>
                                        <div class="ocat-end">
                                            <textarea :id="'translation-' + index + '-' + subGroup.name + '-' + str.key + '-' + form"
                                                      class="form-control" rows="2" v-model="str.values[form]" :disabled="isReadOnly || isImporting || isLoading"
                                                      :placeholder="form === 0 ? str.key : str.plural"
                                                      @@input="onTranslationChange(str)"></textarea>
                                        </div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-secondary" v-if="!isReadOnly && str.values.some(value => value)" :disabled="isImporting || isLoading" @@click="restoreFallback(str)">@T["Restore fallback"]</button>
                                }
                                else
                                {
                                    <input type="text" class="form-control form-control-sm"
                                           v-model="str.value"
                                           :disabled="isReadOnly"
                                           :placeholder="str.key"
                                           @@input="onTranslationChange(str)" />
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </fieldset>
    </div>

    <!-- Empty state -->
    <div v-if="!isLoading && filteredProviders.length === 0" class="alert alert-info">
        @T["No translatable strings found matching your criteria."]
    </div>

    <!-- Action buttons -->
    <div class="mb-3" v-if="!isReadOnly">
        <div>
            <button type="button" class="btn btn-primary save me-2" @@click="saveTranslations" :disabled="!isDirty || isSaving">
                <span v-if="isSaving" class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                @T["Save"]
            </button>
            @if (!Model.IsUiLocalization)
            {
                <a class="btn btn-secondary" role="button" href="@Url.Action("Statistics", "Admin", new { area = "OrchardCore.DataLocalization" })">@T["Statistics"]</a>
            }
        </div>
    </div>
</div>

<script asp-name="vuejs" at="Foot"></script>
<script asp-src="~/OrchardCore.DataLocalization/Scripts/translation-editor/translation-editor.min.js" debug-src="~/OrchardCore.DataLocalization/Scripts/translation-editor/translation-editor.js" depends-on="vuejs" at="Foot" type="module"></script>
