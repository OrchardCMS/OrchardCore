@model OrchardCore.DataLocalization.ViewModels.UiTranslationsViewModel

<zone Name="Title">
    <h1>@T["UI Translations"]</h1>
</zone>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Index" method="get">
    <div class="ocat-wrapper">
        <label asp-for="Culture" class="ocat-label">@T["Culture"]</label>
        <div class="ocat-end">
            <select asp-for="Culture" class="form-select">
                @foreach (var culture in Model.Cultures)
                {
                    <option value="@culture">@culture</option>
                }
            </select>
        </div>
    </div>
    <div class="ocat-wrapper">
        <label asp-for="AssemblyName" class="ocat-label">@T["Assembly"]</label>
        <div class="ocat-end">
            <select asp-for="AssemblyName" class="form-select">
                <option value="">@T["All assemblies"]</option>
                @foreach (var assembly in Model.Assemblies)
                {
                    <option value="@assembly">@assembly</option>
                }
            </select>
        </div>
    </div>
    <div class="ocat-wrapper">
        <label asp-for="Search" class="ocat-label">@T["Search"]</label>
        <div class="ocat-end">
            <input asp-for="Search" type="search" class="form-control" />
            <span class="hint">@T["Search identifiers, contexts, overrides and extracted metadata."]</span>
        </div>
    </div>
    <div class="ocat-wrapper">
        <label asp-for="Status" class="ocat-label">@T["Status"]</label>
        <div class="ocat-end">
            <select asp-for="Status" class="form-select">
                <option value="">@T["All entries"]</option>
                <option value="overridden">@T["With overrides"]</option>
                <option value="untranslated">@T["Without overrides"]</option>
            </select>
        </div>
    </div>
    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Filter"]</button>
            @if (Model.Culture != null)
            {
                <a class="btn btn-secondary" asp-action="Export" asp-route-culture="@Model.Culture">@T["Export overrides"]</a>
            }
        </div>
    </div>
</form>

@if (Model.CanEdit)
{
    <form asp-action="Import" method="post" enctype="multipart/form-data">
        <input type="hidden" name="culture" value="@Model.Culture" />
        <div class="ocat-wrapper">
            <label for="import-file" class="ocat-label">@T["Import overrides"]</label>
            <div class="ocat-end">
                <input id="import-file" name="file" type="file" accept=".po" class="form-control" required />
                <span class="hint">@T["UTF-8 PO file, up to 2 MB. The entire file is validated before saving. Empty translations remove overrides."]</span>
                <button type="submit" class="btn btn-secondary">@T["Import"]</button>
            </div>
        </div>
    </form>
}

@if (Model.Resources.Count == 0)
{
    <p>@T["No matching embedded catalog entries. Build application assemblies with localization extraction enabled."]</p>
}

@for (var row = 0; row < Model.Resources.Count; row++)
{
    var resource = Model.Resources[row];
    var translation = Model.Overrides.FirstOrDefault(value => value.Context == resource.Context && value.Key == resource.Key);
    <div class="card mb-3">
        <div class="card-header">
            <strong>@resource.Key</strong>
            <div>@resource.Context</div>
            <small>@resource.AssemblyName</small>
        </div>
        <div class="card-body">
            @if (resource.Plural != null)
            {
                <p>@T["Plural source: {0}", resource.Plural]</p>
            }
            <details>
                <summary>@T["Source metadata"]</summary>
                <pre>@string.Join("\n", resource.Metadata)</pre>
            </details>
            <form asp-action="Save" method="post">
                <input type="hidden" name="culture" value="@Model.Culture" />
                <input type="hidden" name="context" value="@resource.Context" />
                <input type="hidden" name="key" value="@resource.Key" />
                <input type="hidden" name="plural" value="@resource.Plural" />
                @for (var form = 0; form < (resource.Plural == null ? 1 : Model.PluralFormCount); form++)
                {
                    var id = $"translation-{row}-{form}";
                    <div class="ocat-wrapper">
                        <label for="@id" class="ocat-label">@T["Translation {0}", form]</label>
                        <div class="ocat-end">
                            <textarea id="@id" name="values" class="form-control" rows="2" disabled="@(!Model.CanEdit)">@(translation?.Values.ElementAtOrDefault(form))</textarea>
                        </div>
                    </div>
                }
                @if (Model.CanEdit)
                {
                    <div class="ocat-wrapper">
                        <div class="ocat-end-offset">
                            <button type="submit" class="btn btn-primary">@T["Save override"]</button>
                            @if (translation != null)
                            {
                                <button type="submit" name="remove" value="true" class="btn btn-danger">@T["Restore fallback"]</button>
                            }
                            <span class="hint">@T["Overrides are plain text. HTML is encoded when displayed. Supply every plural form, or restore fallback."]</span>
                        </div>
                    </div>
                }
            </form>
        </div>
    </div>
}

@await DisplayAsync(Model.Pager)
