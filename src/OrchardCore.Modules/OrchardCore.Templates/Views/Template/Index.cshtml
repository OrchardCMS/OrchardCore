@using OrchardCore.Admin.Models
@using OrchardCore.Admin
@model TemplateIndexViewModel

<zone Name="Title">
    <breadcrumb name="Templates" title="@(Model.Options.AdminTemplates ? T["Admin Templates"] : T["Templates"])" />
</zone>

@* the form is necessary to generate an antiforgery token for the delete action *@
<form asp-action="Index" method="post" class="no-multisubmit bulk-select-list" data-checkbox-name="itemIds" data-bulk-action-name="Options.BulkAction" data-selected-text="@T.Note("Shown after the number of selected items.")["selected"]">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input asp-for="Options.AdminTemplates" type="hidden" />
    <input asp-for="Options.BulkAction" type="hidden" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />

    @* The search bar, the button, the templates, the toolbar, the pager and the page size selector are all
       rendered by the AdminList shape using the configured layout (List, Grid, ...). *@
    <admin-list name="Templates" context="Model.List"
                bulk-actions="Model.Options.ContentsBulkAction"
                empty-message="@T["<strong>Nothing here!</strong> There are no templates for the moment. <a class=\"seedoc\" href=\"{0}reference/modules/Templates\" target=\"_blank\">See documentation</a>", OrchardCore.Admin.Constants.DocsUrl]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column type="Select" />
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</form>

<script asp-src="~/OrchardCore.Templates/Scripts/template-editors/template-index.min.js" debug-src="~/OrchardCore.Templates/Scripts/template-editors/template-index.js" at="Foot" type="module"></script>
