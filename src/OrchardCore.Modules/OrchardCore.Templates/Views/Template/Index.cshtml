@model TemplateIndexViewModel

@{
    var pageTitle = Model.Options.AdminTemplates ? T["Admin Templates"] : T["Templates"];
}

<zone Name="Title"><h1>@RenderTitleSegments(pageTitle)</h1></zone>

@* the form is necessary to generate an antiforgery token for the delete action *@
<form asp-action="Index" method="post" class="no-multisubmit" data-list-management data-selected-label="@T["selected"]">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input asp-for="Options.AdminTemplates" type="hidden" />
    <input asp-for="Options.BulkAction" type="hidden" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />

    @* The search bar, the button, the templates, the toolbar, the pager and the page size selector are all
       rendered by the AdminList shape using the configured layout (List, Table, ...). *@
    @await DisplayAsync(Model.List)
</form>

<script asp-name="list-management" at="Foot"></script>
