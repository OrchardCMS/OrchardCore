@* The buttons of the templates list, passed to the AdminList shape as its 'Actions' so the layout places it. *@
@inject OrchardCore.Templates.Services.SourceTemplatesService SourceTemplatesService
@{
    var adminTemplates = Model.AdminTemplates != null && (bool)Model.AdminTemplates;
}

@* One button per template source, e.g. the active theme, listing the templates that can be overridden. *@
<div class="btn-group" role="group" aria-label="@T["Template sources"]">
    @foreach (var source in SourceTemplatesService.Sources)
    {
        <a asp-action="Index" asp-controller="TemplateSource" asp-route-source="@source.Name" asp-route-options.admintemplates="@adminTemplates" class="btn btn-secondary" role="button">@source.DisplayName</a>
    }
</div>
<a asp-action="Create" asp-controller="Template" asp-route-admintemplates="@adminTemplates" asp-route-returnUrl="@FullRequestPath" class="btn btn-secondary create" role="button">@T["Add Template"]</a>
