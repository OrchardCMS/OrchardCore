@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<SourceTemplateEntry>

<div class="form-check">
    <input type="checkbox" class="form-check-input" value="@Model.Value.Template.Name" name="itemIds" id="itemIds-@Model.Value.Template.Name">
    <label class="form-check-label" for="itemIds-@Model.Value.Template.Name">&nbsp;</label>
</div>
