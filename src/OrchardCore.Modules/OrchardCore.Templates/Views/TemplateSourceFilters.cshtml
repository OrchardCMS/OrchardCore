@*
    The status filter of a template source admin list, passed to the AdminListToolbar as its 'Actions'
    so it renders at the end of the toolbar next to the bulk actions.
*@
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var options = (SourceTemplatesOptions)Model.Options;
}

<div class="btn-group filter">
    <select asp-for="@options.Filter" name="Options.Filter" asp-items="@options.Filters" class="selectpicker show-tick me-2" data-header="@T["Filter by status"]" data-width="fit" data-selected-text-format="static" data-dropdown-align-right="true" title="@T["Status"]" data-style="btn-sm"></select>
</div>
