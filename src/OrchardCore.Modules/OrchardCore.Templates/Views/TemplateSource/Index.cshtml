@model SourceTemplatesIndexViewModel

<zone Name="Title">
    <breadcrumb name="TemplateSources" title="@(new OrchardCore.DisplayManagement.Html.HtmlContentString(Model.Source.DisplayName.Value ?? string.Empty))">
        <breadcrumb-item id="Templates" action="@(Model.Options.AdminTemplates ? "Admin" : "Index")" controller="Template" area="OrchardCore.Templates" permission="@(Model.Options.AdminTemplates ? AdminTemplatesPermissions.ManageAdminTemplates.Name : Permissions.ManageTemplates.Name)">@(Model.Options.AdminTemplates ? T["Admin Templates"] : T["Templates"])</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="alert alert-info" role="alert">
    @Model.Source.GetDescription(Model.Options.AdminTemplates)
</div>

@if (Model.Scope?.IsInUse == false)
{
    <div class="alert alert-warning" role="alert">
        @T["{0} is not the active theme: its templates can be viewed, but only cloned once it is active, as local templates apply to the active theme at once. The status shows the local templates that would override them.", Model.Scope.DisplayName]
    </div>
}

@* the form is necessary to generate an antiforgery token for the clone, reset and delete actions *@
<form asp-action="Index" asp-route-source="@Model.Source.Name" method="post" class="no-multisubmit bulk-select-list" data-checkbox-name="itemIds" data-bulk-action-name="Options.BulkAction" data-selected-text="@T["selected"]">
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    <input asp-for="Options.AdminTemplates" type="hidden" />
    <input asp-for="Options.BulkAction" type="hidden" />
    <input type="submit" name="submit.BulkAction" class="visually-hidden" />

    @* The search bar, the buttons, the templates, the toolbar and the pager are all
       rendered by the AdminList shape using the configured layout (List, Grid, ...). *@
    <admin-list name="TemplateSources" context="Model.List"
                bulk-actions="Model.Options.BulkActions"
                empty-message="@T["<strong>Nothing here!</strong> There are no templates in this source, or none matching the filter."]">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column type="Select" />
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column name="Source" position="30" title="@T["Source"]" />
            <admin-list-column name="Status" position="40" title="@T["Status"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</form>

<style asp-name="bootstrap-select" at="Head"></style>
<script asp-name="bootstrap-select" at="Foot"></script>
<script asp-src="~/OrchardCore.Templates/Scripts/template-editors/template-index.min.js" debug-src="~/OrchardCore.Templates/Scripts/template-editors/template-index.js" at="Foot" type="module"></script>
