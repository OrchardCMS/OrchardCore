@model LayerRuleEditViewModel

<zone Name="Title">
    <breadcrumb name="LayersRuleEdit" title="@T["Edit Rule"]">
        <breadcrumb-item id="Layers" action="Index" controller="Admin" area="OrchardCore.Layers" permission="@Permissions.ManageLayers.Name">@T["Widgets and Layers"]</breadcrumb-item>
        <breadcrumb-item id="Layer" action="Edit" controller="Admin" area="OrchardCore.Layers" route-name="@Model.Name" permission="@Permissions.ManageLayers.Name">@T["Edit Layer - {0}", Model.Name]</breadcrumb-item>
    </breadcrumb>
</zone>

<div asp-validation-summary="ModelOnly"></div>
<form asp-action="Edit" method="post" class="no-multisubmit">
    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            @await DisplayAsync(Model.Editor)
        </div>
    </div>

    <input type="hidden" asp-for="Name" />
    <input type="hidden" asp-for="ConditionId" />

    <div class="ocat-wrapper mt-3">
        <div class="ocat-end-offset">
            <button class="btn btn-primary save" type="submit">@T["Save"]</button>
        </div>
    </div>
</form>
