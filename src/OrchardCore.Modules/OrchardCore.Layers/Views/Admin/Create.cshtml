@model LayerEditViewModel

<zone Name="Title">
    <breadcrumb name="LayersCreate" title="@T["Create Layer"]">
        <breadcrumb-item id="Layers" action="Index" controller="Admin" area="OrchardCore.Layers" permission="@Permissions.ManageLayers.Name">@T["Widgets and Layers"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="Create" method="post" class="no-multisubmit">
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <input class="btn btn-primary" type="submit" value="@T["Create"]" />
    </div>
</form>
