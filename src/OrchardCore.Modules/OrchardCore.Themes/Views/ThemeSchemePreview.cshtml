@*
    The preview of a scheme in its editor, for a theme that has none of its own. A theme provides its preview with
    the alternate 'ThemeSchemePreview-{ThemeId}.cshtml', which can carry the scheme's attribute (the 'SchemeAttributeName'
    property) set to the 'SchemeId' property: the editor applies the CSS of the scheme being edited to it as the
    fields change. Properties: ThemeId, SchemeId, SchemeAttributeName, Scheme (a ThemeScheme).
*@
@{
    var scheme = Model.Scheme as ThemeScheme;
    var colors = new[]
    {
        (Label: T["Primary"], Value: scheme?.Primary),
        (Label: T["Deep"], Value: scheme?.Deep),
        (Label: T["Ink"], Value: scheme?.Ink),
        (Label: T["Accent"], Value: scheme?.Accent),
    };
}

<div class="d-flex flex-wrap gap-3" role="img" aria-label="@T["Colors of the scheme"]">
    @foreach (var color in colors)
    {
        if (ThemeColor.TryParse(color.Value, out var parsed))
        {
            <div class="d-flex align-items-center gap-2">
                <span class="d-inline-block rounded border" style="width: 2rem; height: 2rem; background-color: @parsed.ToHex();"></span>
                <span>@color.Label <span class="text-muted">@parsed.ToHex()</span></span>
            </div>
        }
    }
</div>
<p class="hint mt-2">@T["Save the scheme to see it in the theme."]</p>
