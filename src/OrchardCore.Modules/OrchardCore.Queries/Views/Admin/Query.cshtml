@model OrchardCore.Queries.Sql.ViewModels.AdminQueryViewModel
@using OrchardCore.ContentManagement
@using OrchardCore.Infrastructure

@inject IContentManager ContentManager

@{
  string sqlmode = MediaTypeNamesExtended.Text.SQL;

  if (Model.FactoryName.Contains("Sqlite"))
  {
      sqlmode = MediaTypeNamesExtended.Text.SQLite;
  }
  else if (Model.FactoryName.Contains("Mysql"))
  {
      sqlmode = MediaTypeNamesExtended.Text.MySQL;
  }
  else if (Model.FactoryName.Contains("Npgsql"))
  {
      sqlmode = MediaTypeNamesExtended.Text.PostgreSQL;
  }
  else if (Model.FactoryName.Contains("Sql"))
  {
      sqlmode = MediaTypeNamesExtended.Text.SqlServer;
  }
}

<style asp-name="codemirror"></style>

<zone Name="Title">
    <breadcrumb name="QueriesRun" title="@T["SQL Query"]">
        <breadcrumb-item id="Queries" action="Index" controller="Admin" area="OrchardCore.Queries" permission="@QueryPermissions.ManageQueries.Name">@T["Queries"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div asp-validation-summary="ModelOnly"></div>

<form asp-action="Query" method="post" class="no-multisubmit">
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button type="submit" class="btn btn-primary">@T["Query"]</button>
    </div>
</form>
@if (Model.Elapsed != TimeSpan.Zero)
{
    <div class="ocat-wrapper">
        <label asp-for="RawSql" class="ocat-label">@T["Final SQL Query"]</label>
        <div class="ocat-end">
            <textarea asp-for="RawSql" rows="12" class="form-control codemirror-query-editor" data-mode="@sqlmode" data-options='{"readonly":true}'></textarea>
            <span class="hint">@T["The query as it will be executed by the SQL database."]</span>
        </div>
    </div>

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <a href="@Url.Action("Create", "Admin", new { area = "OrchardCore.Queries", id = "Sql", query = Model.DecodedQuery })" class="btn btn-success action-bar-secondary">@T["Create"]</a>
        </div>
    </div>
}

@if (Model.Documents.Any())
{
    <span class="text-muted">@T["Query executed in {0} ms", Model.Elapsed.TotalMilliseconds]</span>

    var json = "[";

    var i = 0;
    @foreach (var document in Model.Documents)
    {
        json += Json.Serialize(document);
        if (i < Model.Documents.Count() - 1)
        {
            json += ",";
        }
        i++;
    }

    json += "]";

    <div class="form-control" style="min-height: 400px;">
        <div id="monaco_editor" style="min-height: 385px;" dir="@Orchard.CultureDir()"></div>
    </div>
    <textarea id="monaco_textarea" hidden>@json</textarea>
}

<style asp-name="monaco"></style>
<script asp-name="monaco" at="Foot"></script>
<script asp-src="~/OrchardCore.Queries/Scripts/queries-admin-query/queries-admin-query.min.js" debug-src="~/OrchardCore.Queries/Scripts/queries-admin-query/queries-admin-query.js" depends-on="monaco, admin" at="Foot" type="module"></script>
