@model QueriesCreateViewModel

<zone Name="Title">
    <breadcrumb name="QueriesCreate" title="@T["New {0} query", Model.SourceName]">
        <breadcrumb-item id="Queries" action="Index" controller="Admin" area="OrchardCore.Queries" permission="@QueryPermissions.ManageQueries.Name">@T["Queries"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form asp-action="Create" asp-route-returnUrl="@Context.Request.Query["ReturnUrl"]" method="post" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @if (Model.Editor.Content != null)
    {
        @await DisplayAsync(Model.Editor.Content)
    }

    @if (Model.Editor.Actions != null)
    {
        <div class="ocat-wrapper">
            <div class="ocat-end-offset">
                @await DisplayAsync(Model.Editor.Actions)
            </div>
        </div>
    }

    <input type="hidden" asp-for="SourceName" />
</form>
