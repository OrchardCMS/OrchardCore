{
  "type": "object",
  "properties": {
    "OrchardCore": {
      "type": "object",
      "properties": {
        "Setup": {
          "type": "object",
          "description": "Configures the setup screen displayed when a tenant is not set up yet. The values can also be defined per tenant under 'OrchardCore:{TenantName}:Setup'. See https://docs.orchardcore.net/en/latest/reference/modules/Setup/.",
          "properties": {
            "DefaultCulture": {
              "type": "string",
              "examples": [
                "ar",
                "cs",
                "de",
                "el",
                "en",
                "es",
                "fa",
                "fr",
                "it",
                "ja",
                "pl",
                "pt-BR",
                "ru",
                "sv",
                "tr",
                "vi",
                "zh-CN",
                "zh-TW",
                "zh-Hans-CN",
                "zh-Hant-TW"
              ],
              "description": "The default culture of the setup screen, e.g. 'en'. Defaults to the installed UI culture of the operating system. When empty, the current culture of the system is used."
            },
            "SupportedCultures": {
              "type": "array",
              "description": "The cultures that can be selected on the setup screen. The invariant culture ('') is not supported.",
              "items": {
                "type": "string",
                "examples": [
                  "ar",
                  "cs",
                  "de",
                  "el",
                  "en",
                  "es",
                  "fa",
                  "fr",
                  "it",
                  "ja",
                  "pl",
                  "pt-BR",
                  "ru",
                  "sv",
                  "tr",
                  "vi",
                  "zh-CN",
                  "zh-TW",
                  "zh-Hans-CN",
                  "zh-Hant-TW"
                ]
              },
              "default": [
                "ar",
                "cs",
                "de",
                "el",
                "en",
                "es",
                "fa",
                "fr",
                "it",
                "ja",
                "pl",
                "pt-BR",
                "ru",
                "sv",
                "tr",
                "vi",
                "zh-CN",
                "zh-TW",
                "zh-Hans-CN",
                "zh-Hant-TW"
              ]
            }
          }
        },
        "OrchardCore_Setup": {
          "type": "object",
          "deprecated": true,
          "deprecationMessage": "The 'OrchardCore_Setup' section is deprecated. Use 'OrchardCore:Setup' instead.",
          "description": "Deprecated. Use 'OrchardCore:Setup' instead.",
          "doNotSuggest": true
        }
      }
    }
  }
}
