@model SiteSettingsViewModel

<div class="ocat-limited-wrapper" asp-validation-class-for="CacheMode">
    <label asp-for="CacheMode" class="ocat-label">@T["Cache Mode"]</label>
    <div class="ocat-limited">
        <select asp-for="CacheMode" class="form-select">
            <option value="@CacheMode.FromConfiguration.ToString()">@T["From environment — enabled in Production, disabled otherwise"]</option>
            <option value="@CacheMode.Enabled.ToString()">@Localize(CommonLocalizationSources.EnabledState)</option>
            <option value="@CacheMode.DebugEnabled.ToString()">@T["Enabled with cache debug mode"]</option>
            <option value="@CacheMode.Disabled.ToString()">@Localize(CommonLocalizationSources.DisabledState)</option>
        </select>
        <span class="hint">@T["Determines whether caches are enabled or disabled."]</span>
    </div>
</div>
