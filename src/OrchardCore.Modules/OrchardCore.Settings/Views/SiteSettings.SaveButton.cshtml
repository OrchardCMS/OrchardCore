<div class="action-bar-bottom">
    @{
        var returnUrl = Context.Request.Query["returnUrl"];
    }
    @if (!string.IsNullOrWhiteSpace(returnUrl) && Url.IsLocalUrl(returnUrl))
    {
        <a href="@returnUrl" class="btn btn-secondary cancel" role="button">@Localize(CommonLocalizationSources.Cancel)</a>
    }

    <button class="primaryAction btn btn-primary save" type="submit">@Localize(CommonLocalizationSources.Save)</button>
</div>
