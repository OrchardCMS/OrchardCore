@model OrchardCore.ContentFields.ViewModels.EditMultiTextFieldViewModel
@using System.Text.Json
@using OrchardCore.ContentFields
@using OrchardCore.Mvc.Utilities
@using OrchardCore.Localization.Data
@inject IDataLocalizer D
@{
    var settings = Model.PartFieldDefinition.GetSettings<MultiTextFieldSettings>();
    string localizedFieldName = D[Model.PartFieldDefinition.DisplayName(), DataLocalizationContext.ContentField(Model.PartFieldDefinition.PartDefinition.Name)];
}

<style asp-name="bootstrap-select" at="Head"></style>
<script asp-name="bootstrap-select" at="Foot"></script>

<div class="@($"ocat-wrapper field-wrapper field-wrapper-{Model.PartFieldDefinition.PartDefinition.Name.HtmlClassify()}-{Model.PartFieldDefinition.Name.HtmlClassify()}" + (Model.PartFieldDefinition.IsNamedPart() ? $" field-wrapper-{Model.PartFieldDefinition.ContentTypePartDefinition.Name.HtmlClassify()}-{Model.PartFieldDefinition.Name.HtmlClassify()}" : string.Empty))" id="@Html.IdFor(x => x.Values)_FieldWrapper">
    <label asp-for="Values" class="ocat-label @(settings.Required ? "ocat-label-required" : "")">@localizedFieldName</label>
    <div class="ocat-end">
        <select asp-for="Values" multiple data-multi-text-field-picker data-live-search="true" data-show-selected-tags="true" data-selected-items-style="list" data-width="100%" placeholder="@T["Type to search"]" data-live-search-placeholder="@Localize(CommonLocalizationSources.Commands.Search)" data-none-results-text="@T["No values match {0}", "{0}"]" data-selected-tag-remove-label="@Localize(CommonLocalizationSources.Remove)" aria-label="@localizedFieldName">
            @foreach (var option in settings.Options)
            {
                <option value="@option.Value" selected="@(Model.Values?.Contains(option.Value) == true)">@option.Name</option>
            }
        </select>
        @if (!string.IsNullOrEmpty(settings.Hint))
        {
            <span class="hint">@settings.Hint</span>
        }
    </div>
</div>

<script asp-src="~/OrchardCore.ContentFields/Scripts/picker-fields/picker-fields.min.js" debug-src="~/OrchardCore.ContentFields/Scripts/picker-fields/picker-fields.js" at="Foot" depends-on="bootstrap-select" type="module"></script>
