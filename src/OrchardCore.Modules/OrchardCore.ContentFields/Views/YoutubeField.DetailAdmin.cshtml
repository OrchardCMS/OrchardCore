@model OrchardCore.ContentFields.ViewModels.YoutubeFieldDisplayViewModel
@using OrchardCore.ContentFields
@using OrchardCore.ContentFields.Settings
@using OrchardCore.ContentManagement.Metadata.Models
@using OrchardCore.Localization.Data
@using OrchardCore.Mvc.Utilities
@inject IDataLocalizer D
@{
    var name = (Model.PartFieldDefinition.PartDefinition.Name + "-" + Model.PartFieldDefinition.Name).HtmlClassify();
    string localizedFieldName = D[Model.PartFieldDefinition.DisplayName(), DataLocalizationContext.ContentField(Model.PartFieldDefinition.PartDefinition.Name)];
    var settings = Model.PartFieldDefinition.GetSettings<YoutubeFieldSettings>();
    int width = settings.Width != default(int) ? settings.Width : 640;
    int height = settings.Height != default(int) ? settings.Height : 640;
}
<div class="ocat-wrapper field field-type-textfield field-name-@name">
    <div class="ocat-label">@localizedFieldName</div>
    <div class="ocat-end">
        <div class="value">
            @if (!string.IsNullOrEmpty(Model.EmbeddedAddress))
            {
                <iframe width="@width" height="@height" src="@Model.EmbeddedAddress" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
            }
        </div>
    </div>
</div>
