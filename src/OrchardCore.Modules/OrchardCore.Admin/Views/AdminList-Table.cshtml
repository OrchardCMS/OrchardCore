@*
    The 'Table' layout of an admin list. Each column renders one or more zones of the row shape in an AdminListCell shape.
    On small screens the rows stack and each cell is prefixed with the column title (see _admin-list.scss), so the page
    never scrolls horizontally.

    Properties:
        Name          The name of the list, e.g. "Contents". Used for the AdminList__{Name} and AdminListCell__{Name}__{Column} alternates.
        Layout        The layout name, "Table" here.
        Columns       The AdminListColumn collection, usually built by IAdminListService.GetColumnsAsync().
        Rows          The row shapes, usually built with the "SummaryAdmin" display type. (Not "Items": that name is the shape's own child collection.)
                      The Classes and Attributes of a row shape (e.g. data-filter-value for client-side search) are rendered on its table row.
        RowsAttributes Optional attributes rendered on the <tbody>, e.g. the id a sortable list needs.
        Header        The options editor shape whose Summary and Actions zones are rendered above the table.
        Toolbar       Alternative to Header: a shape rendered as is above the table, e.g. AdminListToolbar.
        Pager         The pager shape.
        PageSize      Optional page size selector, so a layout can place it apart from the pager.
        Search        Optional search bar of the list, e.g. the AdminListSearch shape. Rendered in the action bar above the list.
        Actions       Optional buttons of the page, e.g. "Add", rendered beside the search in the action bar.
        LayoutSelector Optional selector offering the other layouts of the list, built for the list when the site lets a user choose.
        EmptyMessage  Optional message displayed when there are no items.
*@
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Html
@using OrchardCore.Admin.Models
@using OrchardCore.DisplayManagement.Shapes
@using OrchardCore.Mvc.Utilities
@{
    var rows = ((IEnumerable<object>)Model.Rows ?? []).ToList();
    // Optional attributes for the element wrapping the rows, e.g. the id a sortable list needs.
    var rowsAttributes = (IDictionary<string, string>)Model.RowsAttributes ?? new Dictionary<string, string>();
    var rowsAttributesHtml = new HtmlString(string.Join(' ', rowsAttributes.Select(attribute => $"{attribute.Key}=\"{HtmlEncoder.Default.Encode(attribute.Value)}\"")));
    var columns = ((IEnumerable<AdminListColumn>)Model.Columns ?? []).ToList();
    var header = Model.Header;
    var toolbar = Model.Toolbar;
    string name = Model.Name;

    static string ColumnCssClass(AdminListColumn column)
    {
        var classes = new List<string> { $"admin-list-column-{column.Name.HtmlClassify()}" };

        if (!string.IsNullOrEmpty(column.CssClass))
        {
            classes.Add(column.CssClass);
        }

        classes.Add(column.Alignment switch
        {
            AdminListColumnAlignment.Center => "text-center",
            AdminListColumnAlignment.End => "text-end",
            _ => "text-start",
        });

        if (column.NoWrap || column.HasAutoWidth)
        {
            classes.Add("text-nowrap");
        }

        classes.Add(column.HasAutoWidth
            ? "admin-list-column-auto"
            : string.IsNullOrEmpty(column.Width) ? "admin-list-column-fill" : "admin-list-column-fixed");

        return string.Join(' ', classes);
    }

    static string HeaderStyle(AdminListColumn column)
    {
        if (column.HasAutoWidth)
        {
            return "width: 1%;";
        }

        return string.IsNullOrEmpty(column.Width) ? null : $"width: {column.Width};";
    }
}

@{
    // Everything the layout renders above the rows, so it can leave any of it out.
    var layoutSelector = Model.LayoutSelector;
    var search = Model.Search;
    var actions = Model.Actions;
}

@if (search != null || actions != null)
{
    @* The search bar and the buttons of the page. Only a bar carrying the search follows the page as it
       scrolls, so two of them never cover each other. *@
    <div class="card text-bg-theme mb-3 @(search != null ? "position-sticky action-bar" : null)">
        <div class="card-body">
            <div class="row gx-2">
                @if (search != null)
                {
                    <div class="col">
                        @await DisplayAsync(search)
                    </div>
                }
                @if (actions != null)
                {
                    <div class="col-auto ms-auto">
                        @await DisplayAsync(actions)
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="admin-list admin-list-table">
    @if (toolbar != null || header != null || layoutSelector != null)
    {
        <div class="admin-list-toolbar text-bg-theme">
            @* Wrapping: a narrow list sends the selector to a line of its own instead of over the filters. *@
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="admin-list-toolbar-content">
                    @if (toolbar != null)
                    {
                        @await DisplayAsync(toolbar)
                    }
                    else if (header != null)
                    {
                        <div class="row gx-2 align-items-center">
                            <div class="col">
                                @await DisplayAsync(header.Summary)
                            </div>
                            <div class="col col-md-auto text-end">
                                @await DisplayAsync(header.Actions)
                            </div>
                        </div>
                    }
                </div>
                @if (layoutSelector != null)
                {
                    @await DisplayAsync(layoutSelector)
                }
            </div>
        </div>
    }
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                @foreach (var column in columns)
                {
                    <th scope="col" class="@ColumnCssClass(column)" style="@HeaderStyle(column)">@column.Title</th>
                }
            </tr>
        </thead>
        <tbody @rowsAttributesHtml>
            @if (rows.Count > 0)
            {
                foreach (var row in rows)
                {
                    var tr = new TagBuilder("tr");

                    if (row is Shape rowShape)
                    {
                        foreach (var cssClass in rowShape.Classes)
                        {
                            tr.AddCssClass(cssClass);
                        }

                        tr.MergeAttributes(rowShape.Attributes);
                    }

                    foreach (var column in columns)
                    {
                        var cell = await New.AdminListCell(ListName: name, Row: row, Column: column);
                        var td = new TagBuilder("td");
                        td.AddCssClass(ColumnCssClass(column));

                        // The title is displayed before the cell when the rows are stacked on small screens.
                        if (column.Title != null && !string.IsNullOrEmpty(column.Title.Value))
                        {
                            td.Attributes["data-title"] = column.Title.Value;
                        }

                        td.InnerHtml.AppendHtml(await DisplayAsync(cell));
                        tr.InnerHtml.AppendHtml(td);
                    }

                    @tr
                }
            }
            else
            {
                <tr class="admin-list-empty">
                    <td colspan="@Math.Max(columns.Count, 1)">
                        @* No mb-0: the cell has no padding, so the alert is spaced by the .admin-list-empty rule in _admin-list.scss. *@
                        <div class="alert alert-info">
                            @(Model.EmptyMessage ?? T["No results found."])
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Pager != null || Model.PageSize != null)
{
    @* The pager is centred on the row and the page size selector sits at its end, see _admin-list.scss. *@
    <div class="admin-list-footer d-flex flex-wrap align-items-center gap-2">
        <div class="admin-list-footer-pager">
            @if (Model.Pager != null)
            {
                @await DisplayAsync(Model.Pager)
            }
        </div>
        @if (Model.PageSize != null)
        {
            <div class="admin-list-footer-page-size">
                @await DisplayAsync(Model.PageSize)
            </div>
        }
    </div>
}
