@using System.Globalization
@{
    var indexUrl = Url.RouteUrl("AdminQuickNavigationIndex", new Dictionary<string, string>
    {
        ["culture"] = CultureInfo.CurrentCulture.Name,
        ["ui-culture"] = CultureInfo.CurrentUICulture.Name,
    });
}
<style asp-name="admin-quick-navigation" depends-on="@(Orchard.IsRightToLeft() ? "bootstrap-rtl:5" : "bootstrap:5")" at="Head"></style>
<script asp-name="admin-quick-navigation" at="Foot"></script>

<li class="nav-item">
    <button type="button" class="btn btn-link nav-link" id="adminQuickNavigationToggle" data-bs-toggle="tooltip" data-bs-placement="bottom" title="@T["Quick navigation (Ctrl+K)"]" aria-label="@T["Quick navigation"]" aria-haspopup="dialog" aria-controls="adminQuickNavigationModal">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
    </button>
    <div class="modal fade" id="adminQuickNavigationModal" tabindex="-1" role="dialog" aria-labelledby="adminQuickNavigationLabel" aria-hidden="true" data-index-url="@indexUrl" data-no-results="@T["No destinations found"]" data-loading="@T["Loading navigation..."]" data-load-error="@T["Unable to load navigation. Close and reopen the palette to try again."]" data-max-results="15">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content admin-quick-navigation">
                <h2 id="adminQuickNavigationLabel" class="visually-hidden">@T["Quick navigation"]</h2>
                <div class="modal-body p-0">
                    <div class="admin-quick-navigation-input">
                        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                        <input type="text" id="adminQuickNavigationInput" class="form-control form-control-lg border-0 shadow-none" placeholder="@T["Go to an admin page..."]" aria-label="@T["Filter navigation destinations"]" autocomplete="off" spellcheck="false" role="combobox" aria-autocomplete="list" aria-expanded="true" aria-controls="adminQuickNavigationResults" />
                    </div>
                    <ul id="adminQuickNavigationResults" class="admin-quick-navigation-results list-unstyled mb-0" role="listbox" aria-label="@T["Navigation destinations"]"></ul>
                    <div id="adminQuickNavigationStatus" class="admin-quick-navigation-empty" role="status" hidden></div>
                    <div class="admin-quick-navigation-footer d-none d-md-flex">
                        <span><kbd>↑</kbd><kbd>↓</kbd> @T["to navigate"]</span>
                        <span><kbd>↵</kbd> @T["to open"]</span>
                        <span><kbd>Esc</kbd> @T["to close"]</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</li>
