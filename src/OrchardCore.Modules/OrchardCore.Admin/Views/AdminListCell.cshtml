@*
    Renders the column zones of a row built with the SummaryAdminGrid display type.
    Override per column with AdminListCell-{Column}.cshtml or per list with AdminListCell-{ListName}-{Column}.cshtml.
    The layouts render the zones this way themselves, and only create this shape when a template overrides a cell.
*@
@using OrchardCore.Admin.Models
@using OrchardCore.DisplayManagement.Zones
@{
    var column = (AdminListColumn)Model.Column;
    var row = Model.Row as IZoneHolding;
    var zones = column.Zones.Length > 0 ? column.Zones : [column.Name];
}
@if (row != null)
{
    foreach (var zone in zones)
    {
        if (row.Zones.IsNotEmpty(zone))
        {
            @await DisplayAsync(row.Zones[zone])
        }
    }
}
