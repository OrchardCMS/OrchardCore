@using OrchardCore.Admin.Models
@model OrchardCore.Admin.ViewModels.AdminSettingsViewModel

<div class="ocat-wrapper" asp-validation-class-for="DisplayThemeToggler">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="DisplayThemeToggler" class="form-check-input" type="checkbox" />
            <label asp-for="DisplayThemeToggler" class="form-check-label">@T["Enable theme toggler"]</label>
        </div>
        <span class="hint">@T["Whether or not to display a theme toggler."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="DisplayTitlesInTopbar">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="DisplayTitlesInTopbar" class="form-check-input" type="checkbox" />
            <label asp-for="DisplayTitlesInTopbar" class="form-check-label">@T["Display titles in top bar"]</label>
        </div>
        <span class="hint">@T["Whether the titles are displayed in the top bar."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="ActionsLayout">
    <label asp-for="ActionsLayout" class="ocat-label">@T["Actions layout"]</label>
    <div class="ocat-end">
        <select asp-for="ActionsLayout" class="form-select">
            <option value="">@T["Use configuration default"]</option>
            <option value="@AdminListActionsLayout.Buttons">@T["Buttons"]</option>
            <option value="@AdminListActionsLayout.Menu">@T["Menu"]</option>
        </select>
        <span asp-validation-for="ActionsLayout"></span>
        <span class="hint">@T["How the actions of each list row and the secondary actions of the bottom action bar of edit pages are displayed: as buttons, or in a single compact menu. On small screens the secondary actions of the bottom action bar are always in a menu. Use the configuration default to inherit from appsettings.json."]</span>
    </div>
</div>
