@using OrchardCore.Admin.Models
@model OrchardCore.Admin.ViewModels.AdminSettingsViewModel
@using OrchardCore.Admin.Services
@using OrchardCore.DisplayManagement
@using OrchardCore.DisplayManagement.Descriptors
@using OrchardCore.DisplayManagement.Theming

@inject IThemeManager ThemeManager
@inject IShapeTableManager ShapeTableManager

@{
    // Layouts are discovered from the shape table, like content field editors: a layout is available
    // when a shape named AdminListLayout_Option__{Layout} exists, e.g. AdminListLayout-Grid.Option.cshtml.
    var shapeTable = await ThemeManager.GetShapeTableAsync(ShapeTableManager);
    var layoutOptionShapes = AdminListOptionShapes.GetNames(shapeTable, AdminListConstants.OptionShapePrefix)
        .Select(name => AdminListConstants.OptionShapePrefix + name);

    // Same convention for the layouts of the row actions: AdminListActions_Option__{Layout}.
    var actionsLayoutOptionShapes = AdminListOptionShapes.GetNames(shapeTable, AdminListActionsLayouts.OptionShapePrefix)
        .Select(name => AdminListActionsLayouts.OptionShapePrefix + name);
}

<div class="ocat-wrapper" asp-validation-class-for="DisplayThemeToggler">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="DisplayThemeToggler" class="form-check-input" type="checkbox" />
            <label asp-for="DisplayThemeToggler" class="form-check-label">@T["Enable theme toggler"]</label>
        </div>
        <span class="hint">@T["Whether or not to display a theme toggler."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="DisplayMenuFilter">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="DisplayMenuFilter" class="form-check-input" type="checkbox" />
            <label asp-for="DisplayMenuFilter" class="form-check-label">@T["Enable Admin Menu filter"]</label>
        </div>
        <span class="hint">@T["Whether a filter input is displayed above the admin menu."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="DisplayQuickNavigation">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="DisplayQuickNavigation" class="form-check-input" type="checkbox" />
            <label asp-for="DisplayQuickNavigation" class="form-check-label">@T["Enable quick navigation"]</label>
        </div>
        <span class="hint">@T["Whether the quick navigation palette (Ctrl+K / Cmd+K) is displayed."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="DisplayNewMenu">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="DisplayNewMenu" class="form-check-input" type="checkbox" />
            <label asp-for="DisplayNewMenu" class="form-check-label">@T["Display New menu"]</label>
        </div>
        <span class="hint">@T["Whether a New menu is displayed in the admin menu."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="DisplayTitlesInTopbar">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="DisplayTitlesInTopbar" class="form-check-input" type="checkbox" />
            <label asp-for="DisplayTitlesInTopbar" class="form-check-label">@T["Display titles in top bar"]</label>
        </div>
        <span class="hint">@T["Whether the titles are displayed in the top bar."]</span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="ShowBreadcrumb">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="ShowBreadcrumb" class="form-check-input" type="checkbox" />
            <label asp-for="ShowBreadcrumb" class="form-check-label">@T["Show breadcrumb"]</label>
        </div>
        <span class="hint">@T["Whether the breadcrumb trail is displayed on admin screens."]</span>
    </div>
</div>

@{
    var menuBehaviorId = Html.IdFor(m => m.MenuBehavior);
}

<div class="ocat-wrapper" asp-validation-class-for="MenuBehavior">
    <label class="ocat-label">@T["Navigation menu behavior"]</label>
    <div class="ocat-end" id="@menuBehaviorId">
        <div class="form-check">
            <input class="form-check-input" type="radio" asp-for="MenuBehavior" id="@(menuBehaviorId)_Focused" value="@AdminMenuBehavior.Focused" checked="@(Model.MenuBehavior == AdminMenuBehavior.Focused)" />
            <label for="@(menuBehaviorId)_Focused" class="form-check-label">@T["Focused"]</label>
            <span class="hint d-block">@T["Only the section of the current page is open, and opening a section closes the others."]</span>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="radio" asp-for="MenuBehavior" id="@(menuBehaviorId)_Persistent" value="@AdminMenuBehavior.Persistent" checked="@(Model.MenuBehavior == AdminMenuBehavior.Persistent)" />
            <label for="@(menuBehaviorId)_Persistent" class="form-check-label">@T["Persistent"]</label>
            <span class="hint d-block">@T["Sections stay open until you close them, from page to page, so several can be open at once."]</span>
        </div>
        <span class="hint">@T["The section holding the current page is always open, whichever behavior is chosen."]</span>
    </div>
</div>

<div class="mb-3" asp-validation-class-for="ListLayout">
    <label asp-for="ListLayout" class="form-label">@T["List layout"]</label>
    <select asp-for="ListLayout" class="form-select">
        @foreach (var shapeType in layoutOptionShapes)
        {
            var optionShape = await Factory.CreateAsync(shapeType);
            optionShape.Properties["ListLayout"] = Model.ListLayout;
            @await DisplayAsync(optionShape)
        }
    </select>
    <span class="hint">@T["How the admin lists are rendered, e.g. the content items list. When left unchanged, the value configured for this site in appsettings.json under {0} is used.", "OrchardCore:Admin:List:DefaultLayout"]</span>
</div>

<div class="mb-3" asp-validation-class-for="ListActionsLayout">
    <label asp-for="ListActionsLayout" class="form-label">@T["List actions layout"]</label>
    <select asp-for="ListActionsLayout" class="form-select">
        @foreach (var shapeType in actionsLayoutOptionShapes)
        {
            var optionShape = await Factory.CreateAsync(shapeType);
            optionShape.Properties["ListActionsLayout"] = Model.ListActionsLayout;
            @await DisplayAsync(optionShape)
        }
    </select>
    <span class="hint">@T["How the actions of each row are displayed: as buttons, or in a single compact menu. When left unchanged, the value configured for this site in appsettings.json under {0} is used.", "OrchardCore:Admin:List:DefaultActionsLayout"]</span>
</div>

<div class="ocat-wrapper" asp-validation-class-for="AllowUserListLayoutSelection">
    <div class="ocat-end-offset">
        <div class="form-check">
            <input asp-for="AllowUserListLayoutSelection" class="form-check-input" type="checkbox" />
            <label asp-for="AllowUserListLayoutSelection" class="form-check-label">@T["Let users choose the layout of a list"]</label>
        </div>
        <span class="hint">@T["Whether each list shows a selector with the available layouts. A user's choice is kept in a cookie, per list, and applies to that user only. The layout above stays the one every list starts from."]</span>
    </div>
</div>
