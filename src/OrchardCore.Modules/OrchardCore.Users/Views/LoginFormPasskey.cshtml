@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var tokens = Antiforgery.GetAndStoreTokens(Context);
}

<div class="d-none" data-passkey-login
     data-options-url="@Url.Action("RequestOptions", "Passkey", new { area = UserConstants.Features.Users })"
     data-login-url="@Url.RouteUrl(RateLimitRouteNames.PasskeyLogin, new { returnUrl = ViewData["ReturnUrl"] })"
     data-antiforgery-name="@tokens.FormFieldName"
     data-antiforgery-token="@tokens.RequestToken"
     data-error-message="@T["The passkey couldn't be used. Try again, or log in with your password."]">
    <div class="d-flex align-items-center my-3">
        <hr class="flex-grow-1 my-0" />
        <span class="px-2 text-body-secondary">@T["or"]</span>
        <hr class="flex-grow-1 my-0" />
    </div>
    <button type="button" class="btn btn-outline-primary w-100" data-passkey-button>
        <i class="fa-solid fa-key" aria-hidden="true"></i> @T["Log in with a passkey"]
    </button>
    <div class="text-danger mt-2 d-none" role="alert" data-passkey-error></div>
</div>

<script asp-src="~/OrchardCore.Users/Scripts/passkeys/passkeys.min.js" debug-src="~/OrchardCore.Users/Scripts/passkeys/passkeys.js" at="Foot" type="module"></script>
