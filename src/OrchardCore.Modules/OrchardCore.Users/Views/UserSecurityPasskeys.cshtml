@model PasskeysViewModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var tokens = Antiforgery.GetAndStoreTokens(Context);
}

<div class="card text-bg-theme" id="passkeys">
    <div class="card-header">@T["Passkeys"]</div>

    <div class="card-body">
        <p>@T["A passkey lets you log in with the fingerprint, face or screen lock of your device, or with a security key, instead of your password."]</p>

        @if (Model.IsTwoFactorMethod)
        {
            <p>@T["When two-factor authentication is enabled, a passkey can also confirm it's you after you log in with your password."]</p>
        }

        <div class="alert alert-warning d-none" role="alert" data-passkey-unsupported>
            @T["This browser doesn't support passkeys."]
        </div>

        <form asp-action="Create" asp-controller="Passkey" method="post" class="no-multisubmit" data-passkey-register
              data-options-url="@Url.Action("CreationOptions", "Passkey", new { area = UserConstants.Features.Users })"
              data-antiforgery-name="@tokens.FormFieldName"
              data-antiforgery-token="@tokens.RequestToken"
              data-error-message="@T["The passkey couldn't be added. Try again."]">
            <input type="hidden" name="Credential" />
            <div class="ocat-wrapper">
                <label for="PasskeyName" class="ocat-label">@T["Name"]</label>
                <div class="ocat-end">
                    <input id="PasskeyName" name="Name" class="form-control" maxlength="@RenamePasskeyViewModel.MaxNameLength" placeholder="@T["For example, my laptop"]" />
                    <span class="hint">@T["A name that helps you recognize the device or password manager that keeps the passkey."]</span>
                </div>
            </div>
            <div class="ocat-wrapper">
                <div class="ocat-end-offset">
                    <button type="submit" class="btn btn-primary" data-passkey-button disabled>
                        <i class="fa-solid fa-plus" aria-hidden="true"></i> @T["Add a passkey"]
                    </button>
                    <div class="text-danger mt-2 d-none" role="alert" data-passkey-error></div>
                </div>
            </div>
        </form>
    </div>

    @if (Model.Passkeys.Count > 0)
    {
        <ul class="list-group list-group-flush">
            @foreach (var passkey in Model.Passkeys)
            {
                <li class="list-group-item">
                    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
                        <div>
                            <div class="fw-semibold">
                                <i class="fa-solid fa-key me-1" aria-hidden="true"></i> @passkey.Name
                                @if (passkey.IsBackedUp)
                                {
                                    <span class="badge text-bg-info ms-1">@T["Synced"]</span>
                                }
                            </div>
                            <small class="text-body-secondary">
                                @T["Added {0}", await DisplayAsync(await New.DateTime(Utc: passkey.CreatedUtc, Format: "g"))]
                                &middot;
                                @if (passkey.LastUsedUtc.HasValue)
                                {
                                    @T["Last used {0}", await DisplayAsync(await New.DateTime(Utc: passkey.LastUsedUtc.Value, Format: "g"))]
                                }
                                else
                                {
                                    @T["Never used"]
                                }
                            </small>
                        </div>
                        <form asp-action="Delete" asp-controller="Passkey" method="post" class="no-multisubmit" data-passkey-confirm="@T["Are you sure you want to remove this passkey? You won't be able to log in with it anymore."]">
                            <input type="hidden" name="Id" value="@passkey.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">@T["Remove"]</button>
                        </form>
                    </div>
                    <details class="mt-2">
                        <summary class="small">@T["Rename"]</summary>
                        <form asp-action="Rename" asp-controller="Passkey" method="post" class="mt-2 no-multisubmit">
                            <input type="hidden" name="Id" value="@passkey.Id" />
                            <div class="input-group">
                                <input name="Name" class="form-control" value="@passkey.Name" maxlength="@RenamePasskeyViewModel.MaxNameLength" required aria-label="@T["Name"]" />
                                <button type="submit" class="btn btn-primary">@T["Save"]</button>
                            </div>
                        </form>
                    </details>
                </li>
            }
        </ul>
    }
    else
    {
        <div class="card-body pt-0">
            <div class="alert alert-info mb-0">@T["You don't have any passkey yet."]</div>
        </div>
    }
</div>

<script asp-src="~/OrchardCore.Users/Scripts/passkeys/passkeys.min.js" debug-src="~/OrchardCore.Users/Scripts/passkeys/passkeys.js" at="Foot" type="module"></script>
