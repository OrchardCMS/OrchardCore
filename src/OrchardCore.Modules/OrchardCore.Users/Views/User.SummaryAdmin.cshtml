@if (Model.Checkbox != null)
{
    <div class="float-start">
        @await DisplayAsync(Model.Checkbox)
    </div>
}
<div class="d-flex justify-content-between flex-wrap">
    <div class="d-flex flex-column">
        <div>
            @if (Model.Header != null)
            {
                <div class="header">@await DisplayAsync(Model.Header)</div>
            }

            @if (Model.Meta != null)
            {
                <div class="metadata">
                    @await DisplayAsync(Model.Meta)
                </div>
            }
        </div>

        @if (Model.Description != null)
        {
            <div>@await DisplayAsync(Model.Description)</div>
        }
    </div>

    <div>
        @* The Actions and ActionsMenu zones are rendered in the layout configured in the admin settings (Buttons, Menu, ...). *@
        @await DisplayAsync(await New.AdminListActions(Row: Model))
    </div>

    @if (Model.Content != null)
    {
        <div class="w-100 primary">
                @await DisplayAsync(Model.Content)
        </div>
    }
</div>
