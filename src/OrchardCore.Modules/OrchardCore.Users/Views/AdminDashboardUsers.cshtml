<div class="col-md-6 col-xxl-3 mb-3">
    <div class="card h-100">
        <div class="card-body d-flex flex-column">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="dashboard-card-icon"><i class="fa-solid fa-users" aria-hidden="true"></i></div>
                <h5 class="card-title fs-6 mb-0">@T["Manage users"]</h5>
            </div>
            <p class="card-text text-body-secondary">@T["Add users and assign roles and permissions."]</p>
            <a asp-action="Index" asp-controller="Admin" asp-route-area="OrchardCore.Users" class="btn btn-sm btn-primary mt-auto align-self-start">@T["Go to users"]</a>
        </div>
    </div>
</div>
