@model EditPasswordViewModel

@if (Model.UsernameOrEmail == User.Identity.Name)
{
    <div class="ocat-wrapper">
        <label asp-for="CurrentPassword" class="ocat-label ocat-label-required">@T["Current password"]</label>
        <div class="ocat-end">
            <input asp-for="CurrentPassword" class="form-control" autofocus />
            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            <span class="text-muted form-text small">@T["To confirm the change, please provide your password."]</span>
        </div>
    </div>
}
<div class="ocat-wrapper">
    <label asp-for="NewPassword" class="ocat-label ocat-label-required">@T["New password"]</label>
    <div class="ocat-end">
        <input asp-for="NewPassword" class="form-control" />
        <div id="passwordStrength"></div>
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>
</div>
<div class="ocat-wrapper">
    <label asp-for="PasswordConfirmation" class="ocat-label ocat-label-required">@T["New password confirmation"]</label>
    <div class="ocat-end">
        <input asp-for="PasswordConfirmation" class="form-control" />
        <span asp-validation-for="PasswordConfirmation" class="text-danger"></span>
    </div>
</div>
