@using OrchardCore.Users.Models

@model TwoFactorMethod

@* The passkeys are managed from their own section of the Security page. *@
@if (Model.IsEnabled)
{
    <a href="#passkeys" class="btn btn-sm btn-primary">@T["Manage"]</a>
}
else
{
    <a href="#passkeys" class="btn btn-sm btn-success">@T["Add"]</a>
}
