@using OrchardCore.Security.Services
@model SummaryAdminUserViewModel

@inject IRoleService RoleService

@{
    var roles = (await RoleService.GetRolesAsync()).ToDictionary(x => x.RoleName, x => x, StringComparer.OrdinalIgnoreCase);
}

<div class="d-inline-flex flex-wrap gap-1" data-bs-toggle="tooltip" title="@T["The roles this user has"]">
    @foreach (var roleName in Model.User.RoleNames.OrderBy(r => r))
    {
        if (!roles.TryGetValue(roleName, out var role))
        {
            continue;
        }

        <span class="badge ta-badge fw-normal">@role.RoleName</span>
    }
</div>
