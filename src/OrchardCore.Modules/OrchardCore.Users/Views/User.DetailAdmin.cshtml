@using OrchardCore.Mvc.Utilities
@using OrchardCore.ContentManagement

<zone Name="Title">
    <breadcrumb name="UsersDisplay" title="@T["View User"]">
        <breadcrumb-item id="Users" action="Index" controller="Admin" area="OrchardCore.Users" permission="@UsersPermissions.ListUsers.Name">@T["Users"]</breadcrumb-item>
    </breadcrumb>
</zone>

<article>
    <header>
        @await DisplayAsync(Model.Header)
        @if (Model.Meta != null)
        {
            <div class="metadata">
                @await DisplayAsync(Model.Meta)
            </div>
        }
    </header>
    @await DisplayAsync(Model.Content)
    @if (Model.Footer != null)
    {
        <footer>
            @await DisplayAsync(Model.Footer)
        </footer>
    }
</article>
