@model dynamic

<zone Name="Title">
    <breadcrumb name="@UsersBreadcrumbs.Edit" />
</zone>

<form asp-action="Edit" method="post" asp-route-returnUrl="@ViewData["returnUrl"]" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model)
</form>
