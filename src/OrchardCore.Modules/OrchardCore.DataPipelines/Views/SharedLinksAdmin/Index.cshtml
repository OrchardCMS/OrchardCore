@model SharedLinksViewModel

<zone Name="Title">
    <breadcrumb name="SharedLinks" title="@T["Shared Links"]" />
</zone>

<form asp-action="Index" method="get">
    <div class="card mb-3 text-bg-theme position-sticky action-bar">
        <div class="card-body">
            <div class="has-search">
                <i class="fa-solid fa-search form-control-feedback" aria-hidden="true"></i>
                <input name="q" value="@Model.Search" class="form-control" placeholder="@T["Search by name or source"]" type="search" aria-label="@T["Search by name or source"]" autofocus />
            </div>
        </div>
    </div>
</form>

<ul class="list-group">
    <li class="list-group-item text-bg-theme">
        <div class="my-1">
            @T.Plural(Model.Links.Count, "{0} item", "{0} items")<span class="text-muted">@T.Plural(Model.TotalCount, " / {0} item in total", " / {0} items in total")</span>
            <span class="hint ms-2">@T["A link works only for its recipients, once signed in. A link is deleted a day after it stops working."]</span>
        </div>
    </li>

    @if (Model.Links.Count == 0)
    {
        <li class="list-group-item">
            <div class="alert alert-info mb-0" role="alert">
                @if (string.IsNullOrWhiteSpace(Model.Search))
                {
                    @T["<strong>Nothing here!</strong> Nothing was shared yet."]
                }
                else
                {
                    @T["<strong>Nothing here!</strong> No shared link matches your search."]
                }
            </div>
        </li>
    }

    @foreach (var link in Model.Links)
    {
        var active = link.IsActive(Model.UtcNow);

        <li class="list-group-item" data-link-id="@link.LinkId">
            <div class="row">
                <div class="col-lg col-12 d-flex align-items-center">
                    <div class="d-flex flex-column flex-md-row flex-wrap align-items-md-center gap-1">
                        <div class="me-2">@link.Title</div>
                        <div>
                            @if (link.RevokedUtc is not null)
                            {
                                <span class="badge ta-badge fw-normal"><i class="fa-solid fa-link-slash text-danger" aria-hidden="true"></i> @T["Revoked"]</span>
                            }
                            else if (link.IsUsedUp)
                            {
                                <span class="badge ta-badge fw-normal"><i class="fa-solid fa-ban text-secondary" aria-hidden="true"></i> @T["Used up"]</span>
                            }
                            else if (!active)
                            {
                                <span class="badge ta-badge fw-normal"><i class="fa-solid fa-hourglass-end text-secondary" aria-hidden="true"></i> @T["Expired"]</span>
                            }
                            else
                            {
                                <span class="badge ta-badge fw-normal" title="@T["The link works until {0} (UTC).", Arg("expiration date", link.ExpiresUtc.ToString("g", System.Globalization.CultureInfo.CurrentCulture))]"><i class="fa-solid fa-link text-success" aria-hidden="true"></i> @T["Active"]</span>
                            }
                            <span class="badge ta-badge fw-normal" title="@T["Kind"]"><i class="fa-solid fa-tag text-secondary" aria-hidden="true"></i> @(Model.KindNames.TryGetValue(link.Kind, out var kindName) ? kindName : link.Kind)</span>
                            <span class="badge ta-badge fw-normal" title="@T["Recipients"]"><i class="fa-solid fa-user-group text-secondary" aria-hidden="true"></i> @string.Join(", ", link.RecipientNames)</span>
                            @if (!string.IsNullOrEmpty(link.SourceName))
                            {
                                <span class="badge ta-badge fw-normal" title="@T["Shared by"]"><i class="fa-solid fa-share-nodes text-secondary" aria-hidden="true"></i> @link.SourceName</span>
                            }
                            <span class="badge ta-badge fw-normal" title="@T["Shared"]"><i class="fa-solid fa-calendar text-secondary" aria-hidden="true"></i> @await DisplayAsync(await New.Timespan(Utc: link.CreatedUtc))</span>
                            <span class="badge ta-badge fw-normal" title="@T.Note("Number of times the shared link has been used.")["Uses"]">
                                <i class="fa-solid fa-arrow-pointer text-secondary" aria-hidden="true"></i>
                                @if (link.MaxUses > 0)
                                {
                                    @T["{0} of {1} uses", link.Uses, link.MaxUses]
                                }
                                else
                                {
                                    @T.Plural(link.Uses, "1 use", "{0} uses")
                                }
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-auto col-12 d-flex justify-content-end align-items-center">
                    <div class="btn-group" title="@T["Actions"]">
                        <button type="button" class="btn btn-sm btn-secondary dropdown-toggle actions" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <span>@T["Actions"]</span>
                        </button>
                        <div class="actions-menu dropdown-menu dropdown-menu-end">
                            @if (Model.SourceUrls.TryGetValue(link.LinkId, out var sourceUrl))
                            {
                                <a href="@sourceUrl" class="dropdown-item btn-sm">@T["View the source"]</a>
                            }
                            @if (active)
                            {
                                <a asp-action="Revoke" asp-route-linkId="@link.LinkId" class="dropdown-item btn-sm" data-url-af="UnsafeUrl" data-title="@T["Revoke"]" data-message="@T["Stop the link to '{0}' from working?", link.Title]" data-ok-text="@T["Yes"]" data-cancel-text="@T["No"]">@T["Revoke the link"]</a>
                            }
                            <div class="dropdown-divider"></div>
                            <a asp-action="Delete" asp-route-linkId="@link.LinkId" class="dropdown-item btn-sm" data-url-af="RemoveUrl UnsafeUrl" data-title="@T["Delete"]" data-message="@T["Delete the link to '{0}'?", link.Title]" data-ok-text="@T["Ok"]" data-cancel-text="@T["Cancel"]">@T["Delete"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </li>
    }
</ul>

@await DisplayAsync(Model.Pager)
