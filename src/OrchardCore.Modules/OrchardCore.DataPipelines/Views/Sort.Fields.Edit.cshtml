@model SortStepViewModel

<script asp-name="data-pipelines-editors" at="Foot"></script>

<div class="ocat-wrapper">
    <label class="ocat-label ocat-label-required">@T["Sort by"]</label>
    <div class="ocat-end" data-dp-list data-dp-prefix="@Html.Name("Keys")">
        <template data-dp-template>
            <partial name="DataPipelineSortRow" model="@((Model.AvailableFields, new SortField(), "__index__"))" />
        </template>
        <div data-dp-rows>
            @for (var index = 0; index < Model.Keys.Count; index++)
            {
                <partial name="DataPipelineSortRow" model="@((Model.AvailableFields, Model.Keys[index], index.ToString(System.Globalization.CultureInfo.InvariantCulture)))" />
            }
        </div>
        <button type="button" class="btn btn-sm btn-secondary" data-dp-add>@T["Add a field"]</button>
        <span class="hint">@T["The most significant field first. Sorting holds every row in memory before writing the first one."]</span>
    </div>
</div>
