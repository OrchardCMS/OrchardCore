@model DataPipelineSecretInputViewModel
@{
    // The full names, such as "DataPipelineStep.Password", so the inputs bind to the step's editor.
    var name = Html.Name(Model.Name);
    var id = Html.Id(Model.Name);
    var removeName = Html.Name(Model.RemoveName);
    var removeId = Html.Id(Model.RemoveName);
}

<div class="ocat-wrapper">
    <label for="@id" class="ocat-label">@Model.Label</label>
    <div class="ocat-end">
        @if (Model.Multiline)
        {
            <textarea id="@id" name="@name" class="form-control font-monospace" rows="4" autocomplete="off" spellcheck="false"></textarea>
        }
        else
        {
            <input type="password" id="@id" name="@name" value="" class="form-control" autocomplete="new-password" />
        }
        @if (Model.HasValue)
        {
            <span class="hint">@Model.KeepHint</span>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="@removeId" name="@removeName" value="true" />
                <label class="form-check-label" for="@removeId">@Model.RemoveLabel</label>
            </div>
        }
        else if (!string.IsNullOrEmpty(Model.Hint))
        {
            <span class="hint">@Model.Hint</span>
        }
    </div>
</div>
