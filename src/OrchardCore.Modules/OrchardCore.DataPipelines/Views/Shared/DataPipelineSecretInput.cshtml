@model DataPipelineSecretInputViewModel

<div class="ocat-wrapper">
    <label for="@Model.Name" class="ocat-label">@Model.Label</label>
    <div class="ocat-end">
        @if (Model.Multiline)
        {
            <textarea id="@Model.Name" name="@Model.Name" class="form-control font-monospace" rows="4" autocomplete="off" spellcheck="false"></textarea>
        }
        else
        {
            <input type="password" id="@Model.Name" name="@Model.Name" value="" class="form-control" autocomplete="new-password" />
        }
        @if (Model.HasValue)
        {
            <span class="hint">@Model.KeepHint</span>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="@Model.RemoveName" name="@Model.RemoveName" value="true" />
                <label class="form-check-label" for="@Model.RemoveName">@Model.RemoveLabel</label>
            </div>
        }
        else if (!string.IsNullOrEmpty(Model.Hint))
        {
            <span class="hint">@Model.Hint</span>
        }
    </div>
</div>
