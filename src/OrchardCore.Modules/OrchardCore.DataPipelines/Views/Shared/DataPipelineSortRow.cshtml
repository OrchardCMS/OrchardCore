@model (IReadOnlyList<DataField> Fields, SortField Key, string Index)
@{
    var prefix = $"Keys[{Model.Index}]";
}

<div class="input-group input-group-sm mb-2" data-dp-row>
    <select name="@(prefix).Field" class="form-select" aria-label="@T["Field"]">
        <partial name="DataPipelineFieldOptions" model="@((Model.Fields, Model.Key.Field, true))" />
    </select>
    <select name="@(prefix).Descending" class="form-select" style="max-width: 12rem" aria-label="@T["Order"]">
        <option value="false" selected="@(!Model.Key.Descending)">@T["Ascending"]</option>
        <option value="true" selected="@Model.Key.Descending">@T["Descending"]</option>
    </select>
    <button type="button" class="btn btn-outline-secondary" data-dp-up title="@T["Move up"]"><i class="fa-solid fa-arrow-up" aria-hidden="true"></i></button>
    <button type="button" class="btn btn-outline-danger" data-dp-remove title="@T["Remove"]"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
</div>
