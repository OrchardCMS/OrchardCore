@model DataPipelineIndexViewModel

<zone Name="Title">
    <breadcrumb name="DataPipelines" title="@T["Data Pipelines"]" />
</zone>

<form asp-action="Index" method="get" data-list-management>
    @* Enter in the search box clicks it (list-management). *@
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />

    <div class="card mb-3 text-bg-theme position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" name="q" value="@Model.Search" class="form-control" placeholder="@T["Search"]" type="search" aria-label="@T["Search the pipelines"]" autofocus autocomplete="off" />
                        <button type="submit" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                @if (Model.CanManage)
                {
                    <div class="col-auto">
                        <a asp-action="Create" class="btn btn-secondary create" role="button">@T["Add Pipeline"]</a>
                    </div>
                }
            </div>
        </div>
    </div>

    @* The pipelines, the toolbar and the pager are rendered by the AdminList shape using the configured layout (List, Grid, ...). *@
    <admin-list name="DataPipelines" context="Model.List" show-select-all="false"
                empty-message="@(string.IsNullOrWhiteSpace(Model.Search)
                    ? T["<strong>Nothing here!</strong> There are no data pipelines for the moment."]
                    : T["<strong>Nothing here!</strong> No data pipeline matches your search."])">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column name="Name" position="20" title="@T["Name"]" />
            <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
            <admin-list-column name="LastRun" position="40" title="@T["Last run"]" width="auto" no-wrap="true" />
            <admin-list-column name="Modified" position="50" title="@T["Modified"]" width="auto" no-wrap="true" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</form>

<script asp-name="list-management" at="Foot"></script>
