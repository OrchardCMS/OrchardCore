@model DataPipelineRunsViewModel

<zone Name="Title">
    <breadcrumb name="DataPipelinesRuns" title="@(Model.Pipeline is null ? T["Run History"] : T["Run History of {0}", Model.Pipeline.Name])">
        <breadcrumb-item action="Index" controller="Admin" area="OrchardCore.DataPipelines">@T["Data Pipelines"]</breadcrumb-item>
    </breadcrumb>
</zone>

@* One form for the search and the status filter of the toolbar: picking a status submits it (list-management). *@
<form asp-action="Runs" asp-route-pipelineId="@Model.Pipeline?.PipelineId" method="get" data-list-management>
    <input type="submit" name="submit.Filter" id="submitFilter" class="visually-hidden" />
    @if (Model.Pipeline is not null && !string.IsNullOrEmpty(Model.Search))
    {
        <input type="hidden" name="q" value="@Model.Search" />
    }

    <div class="card mb-3 text-bg-theme position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2 align-items-center">
                <div class="col">
                    @if (Model.Pipeline is null)
                    {
                        <div class="input-group">
                            <input id="search-box" name="q" value="@Model.Search" class="form-control" placeholder="@T["Search by pipeline"]" type="search" aria-label="@T["Search by pipeline"]" autofocus autocomplete="off" />
                            <button type="submit" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                        </div>
                    }
                    else
                    {
                        <div class="form-control-plaintext">
                            @T["The runs of {0}, the most recent first.", Model.Pipeline.Name]
                            <a asp-action="Runs" asp-route-pipelineId="">@T["See every pipeline"]</a>
                        </div>
                    }
                </div>
                @if (Model.Pipeline is not null)
                {
                    <div class="col-auto">
                        <a asp-action="Edit" asp-route-pipelineId="@Model.Pipeline.PipelineId" class="btn btn-secondary">@T["Open the pipeline"]</a>
                    </div>
                }
            </div>
        </div>
    </div>

    @* The runs, the toolbar with the status filter and the pager are rendered by the AdminList shape using the configured layout (List, Grid, ...). *@
    <admin-list name="DataPipelineRuns" context="Model.List" show-select-all="false"
                empty-message="@(string.IsNullOrWhiteSpace(Model.Search) && Model.Status is null
                    ? T["<strong>Nothing here!</strong> No pipeline ran yet."]
                    : T["<strong>Nothing here!</strong> No run matches your search."])">
        <admin-list-list item-css-class="list-group-item" />
        <admin-list-grid>
            <admin-list-column name="Pipeline" position="20" title="@T["Pipeline"]" />
            <admin-list-column name="Status" position="30" title="@T["Status"]" width="auto" />
            <admin-list-column name="Version" position="40" title="@T["Version"]" width="auto" no-wrap="true" />
            <admin-list-column name="Queued" position="50" title="@T["Queued"]" width="auto" no-wrap="true" />
            <admin-list-column name="Duration" position="60" title="@T["Duration"]" width="auto" no-wrap="true" />
            <admin-list-column name="StartedBy" position="70" title="@T["Started by"]" width="auto" />
            <admin-list-column type="Actions" title="@T["Actions"]" />
        </admin-list-grid>
    </admin-list>
</form>

<style asp-name="bootstrap-select" at="Head"></style>
<script asp-name="bootstrap-select" at="Foot"></script>
<script asp-name="list-management" at="Foot"></script>
