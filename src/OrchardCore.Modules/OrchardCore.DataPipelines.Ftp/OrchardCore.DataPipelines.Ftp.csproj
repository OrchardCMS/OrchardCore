<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <!-- NuGet properties-->
    <Title>OrchardCore Data Pipelines FTP</Title>
    <Description>$(OCCMSDescription)

    Lets data pipelines upload the files they create to FTP servers, over TLS or in clear text, with FluentFTP.
    </Description>
    <PackageTags>$(PackageTags) OrchardCoreCMS DataPipelines ETL FTP</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OrchardCore\OrchardCore.DisplayManagement\OrchardCore.DisplayManagement.csproj" />
    <ProjectReference Include="..\..\OrchardCore\OrchardCore.Module.Targets\OrchardCore.Module.Targets.csproj" />
    <ProjectReference Include="..\OrchardCore.DataPipelines\OrchardCore.DataPipelines.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" />
  </ItemGroup>

</Project>
