                  "examples": [
                    "self",
                    "*",
                    "()"
                  ],
                  "description": "Controls the use of the Screen Wake Lock API."
                },
                "sync-xhr": {
                  "type": "string",
                  "examples": [
                    "self",
                    "*",
                    "()"
                  ],
                  "description": "Controls the use of synchronous XMLHttpRequest requests."
                },
                "unoptimized-images": {
                  "type": "string",
                  "examples": [
                    "self",
                    "*",
                    "()"
                  ],
                  "description": "Controls the display of unoptimized images."
                },
                "unsized-media": {
                  "type": "string",
                  "examples": [
                    "self",
                    "*",
                    "()"
                  ],
                  "description": "Controls the display of media elements without explicit dimensions."
                },
                "usb": {
                  "type": "string",
                  "examples": [
                    "self",
                    "*",
                    "()"
                  ],
                  "description": "Controls the use of the WebUSB API."
                },
                "web-share": {
                  "type": "string",
                  "examples": [
                    "self",
                    "*",
                    "()"
                  ],
                  "description": "Controls the use of the Web Share API."
                },
                "xr-spatial-tracking": {
                  "type": "string",
                  "examples": [
                    "self",
                    "*",
                    "()"
                  ],
                  "description": "Controls the use of the WebXR Device API."
                }
              },
              "additionalProperties": {
                "type": "string",
                "examples": [
                  "self",
                  "*",
                  "()"
                ]
              }
            },
            "ReferrerPolicy": {
              "type": "string",
              "enum": [
                "no-referrer",
                "no-referrer-when-downgrade",
                "origin",
                "origin-when-cross-origin",
                "same-origin",
                "strict-origin",
                "strict-origin-when-cross-origin",
                "unsafe-url"
              ],
              "description": "The value of the 'Referrer-Policy' HTTP header: 'no-referrer', 'no-referrer-when-downgrade', 'origin', 'origin-when-cross-origin', 'same-origin', 'strict-origin', 'strict-origin-when-cross-origin' or 'unsafe-url'.",
              "default": "no-referrer"
            }
          }
        },
        "OrchardCore_Security": {
          "type": "object",
          "deprecated": true,
          "deprecationMessage": "The 'OrchardCore_Security' section is deprecated. Use 'OrchardCore:Security' instead.",
          "description": "Deprecated. Use 'OrchardCore:Security' instead.",
          "doNotSuggest": true
        }
      }
    }
  }
}
