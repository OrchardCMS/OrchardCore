@using OrchardCore.Infrastructure.Entities

@model ModelViewModel

<zone Name="Title">
    <breadcrumb name="IndexesCreate" title="@T["New '{0}' index", Model.DisplayName]">
        <breadcrumb-item id="Indexes" action="Index" controller="Admin" area="OrchardCore.Indexing" permission="@IndexingPermissions.ManageIndexes.Name">@T["Indexes"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <div class="ocat-wrapper">
        <div class="ocat-end-offset">
            <button class="btn btn-primary" type="submit">@T["Save"]</button>
            <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
        </div>
    </div>
</form>
