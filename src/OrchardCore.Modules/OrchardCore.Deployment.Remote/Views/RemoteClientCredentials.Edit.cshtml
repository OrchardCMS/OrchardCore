@model EditRemoteClientViewModel
@{
    // The edit page shows the api key of the remote client, the create page doesn't show the one typed again.
    var apiKey = string.IsNullOrEmpty(Model.Id) ? null : Model.ApiKey;
}

<div class="ocat-wrapper" asp-validation-class-for="ClientName">
    <label asp-for="ClientName" class="ocat-label ocat-label-required">@T["Client Name"]</label>
    <div class="ocat-end">
        <input asp-for="ClientName" class="form-control" />
        <span asp-validation-for="ClientName" class="text-danger"></span>
    </div>
</div>

<div class="ocat-wrapper" asp-validation-class-for="ApiKey">
    <label asp-for="ApiKey" class="ocat-label ocat-label-required">@T["Api Key"]</label>
    <div class="ocat-end">
        <input asp-for="ApiKey" type="password" class="form-control" value="@apiKey" />
        <span asp-validation-for="ApiKey" class="text-danger"></span>
    </div>
</div>
