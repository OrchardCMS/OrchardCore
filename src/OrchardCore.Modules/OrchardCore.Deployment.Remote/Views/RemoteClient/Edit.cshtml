@model EditRemoteClientViewModel

<zone Name="Title">
    <breadcrumb name="RemoteClientsEdit" title="@T["Edit Remote Client"]">
        <breadcrumb-item id="RemoteClients" action="Index" controller="RemoteClient" area="OrchardCore.Deployment.Remote" permission="@DeploymentPermissions.ManageRemoteClients.Name">@T["Remote Clients"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div asp-validation-summary="ModelOnly"></div>
<form asp-action="Edit" method="post" class="no-multisubmit">
    <input type="hidden" asp-for="Id" />

    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary save" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
