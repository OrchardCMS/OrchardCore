@using OrchardCore.Deployment.Remote.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<RemoteClient>

<a asp-action="Edit" asp-controller="RemoteClient" asp-route-id="@Model.Value.Id" class="btn btn-primary btn-sm">@T["Edit"]</a>

<a asp-action="Delete" asp-controller="RemoteClient" asp-route-id="@Model.Value.Id" class="btn btn-danger btn-sm" data-url-af="RemoveUrl UnsafeUrl">@T["Delete"]</a>
