@model EditRemoteInstanceViewModel

<zone Name="Title">
    <breadcrumb name="RemoteInstancesCreate" title="@T["Create Remote Instance"]">
        <breadcrumb-item id="RemoteInstances" action="Index" controller="RemoteInstance" area="OrchardCore.Deployment.Remote" permission="@DeploymentPermissions.ManageRemoteInstances.Name">@T["Remote Instances"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div asp-validation-summary="ModelOnly"></div>
<form asp-action="Create" method="post" class="no-multisubmit">
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary create" type="submit">@T["Create"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
