@using OrchardCore.Deployment.Remote.Models
@using OrchardCore.DisplayManagement.Views

@model ShapeViewModel<RemoteInstance>

<a asp-action="Edit" asp-controller="RemoteInstance" asp-route-id="@Model.Value.Id" class="btn btn-primary btn-sm">@Localize(CommonLocalizationSources.Edit)</a>

<a asp-action="Delete" asp-controller="RemoteInstance" asp-route-id="@Model.Value.Id" class="btn btn-danger btn-sm" data-url-af="RemoveUrl UnsafeUrl">@Localize(CommonLocalizationSources.Delete)</a>
