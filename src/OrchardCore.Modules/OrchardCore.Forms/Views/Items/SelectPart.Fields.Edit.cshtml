@using OrchardCore.Forms.ViewModels
@using OrchardCore.Forms.Models
@using System.Text.Json
@model SelectPartEditViewModel

@{
    var translations = Orchard.GetJSLocalizations("forms-select-part-editor");
    var translationsJson = Json.Serialize(translations).ToString();
    var widgetId = Html.IdFor(m => m);
}

<script asp-name="vue-draggable" at="Foot"></script>
<script asp-src="~/OrchardCore.Forms/Scripts/select-part/select-part.min.js" debug-src="~/OrchardCore.Forms/Scripts/select-part/select-part.js" depends-on="vuejs, vue-draggable" at="Foot" type="module"></script>
<style asp-src="~/OrchardCore.Forms/Styles/selectOptionsEditor.min.css" debug-src="~/OrchardCore.Forms/Styles/selectOptionsEditor.css"></style>

<div class="select-part-properties-wrapper select-part-editor" id="@widgetId">

    <div class="ocat-wrapper show-for-input">
        <label asp-for="Editor" class="ocat-label">@T["Editor"]</label>
        <div class="ocat-end">
            <select asp-for="Editor" class="form-select content-preview-select">
                <option value="@SelectEditorOption.Dropdown">@T["Dropdown"]</option>
                <option value="@SelectEditorOption.Checkbox">@T["Checkbox"]</option>
                <option value="@SelectEditorOption.Radio">@T["Radio"]</option>
            </select>
            <span class="hint">@T["The editor style to use for this field."]</span>
        </div>
    </div>

    <div class="ocat-wrapper field-options-wrapper" id="@(widgetId)-selectOptions" data-options="@Model.Options" data-default-value="@Model.DefaultValue" data-translations="@translationsJson" data-default-value-input-id="@Html.IdFor(m => m.DefaultValue)" data-default-value-input-name="@Html.NameFor(m => m.DefaultValue)" data-options-input-id="@Html.IdFor(m => m.Options)" data-options-input-name="@Html.NameFor(m => m.Options)">
        <label asp-for="Options" class="ocat-label">@T["Options"]</label>

        <div class="ocat-end">
            <div class="select-part-editor-mount"></div>
        </div>
    </div>
</div>
