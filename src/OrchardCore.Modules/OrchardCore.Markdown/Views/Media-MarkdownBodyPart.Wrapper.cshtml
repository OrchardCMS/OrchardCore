@using System.Text.Json
@inject Microsoft.Extensions.Options.IOptions<OrchardCore.Media.MediaOptions> MediaOptions

@Model.Metadata.ChildContent

@if (!Context.Items.ContainsKey("Media_Assets__MarkdownBodyPart"))
{
    Context.Items["Media_Assets__MarkdownBodyPart"] = new object();

    var jsLocalizations = Orchard.GetJSLocalizations("media-gallery");

    <style asp-name="media" at="Head"></style>
    <script asp-name="media-picker" at="Foot"></script>
    <div hidden
         data-media-picker-config
         data-translations="@JsonSerializer.Serialize(jsLocalizations)"
         data-base-path="@Url.Content("~/")"
         data-upload-files-url="@Url.Content("~/api/media/Upload")"
         data-disable-thumbnails="@(MediaOptions.Value.DisableThumbnails ? "true" : "false")"></div>
}
