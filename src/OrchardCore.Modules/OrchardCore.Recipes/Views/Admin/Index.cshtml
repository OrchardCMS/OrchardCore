@model OrchardCore.Recipes.ViewModels.RecipesIndexViewModel

<zone Name="Title">
    <breadcrumb name="Recipes" title="@T["Recipes"]" />
</zone>

<div>
    <div class="card text-bg-theme mb-3 position-sticky action-bar">
        <div class="card-body">
            <div class="row gx-2">
                <div class="col">
                    <div class="input-group">
                        <input id="search-box" class="form-control" placeholder="@T["Search"]" type="search" autofocus autocomplete="off" />
                        <button type="submit" name="submit.Filter" class="btn btn-outline-secondary" title="@T["Search"]" aria-label="@T["Search"]"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
                    </div>
                </div>
                @if (Model.LayoutSelector != null)
                {
                    <div class="col-auto d-flex align-items-center">
                        @await DisplayAsync(Model.LayoutSelector)
                    </div>
                }
            </div>
        </div>
    </div>

    @* the form is necessary to generate an antiforgery token for the execute action *@
    <form asp-action="Recipes">
        @foreach (var group in Model.Groups)
        {
            <div class="recipe-group list-management-group mb-3" data-filter-value="@group.FilterValue">
                <h4 class="mb-2" data-filter-value="@group.FilterValue">@group.Feature</h4>

                @* The recipes of this feature are rendered by the AdminList shape using the configured layout. *@
                @await DisplayAsync(group.List)
            </div>
        }
    </form>

    <div id="list-alert" class="alert alert-info my-3 d-none text-center" role="alert">
        @T["Your search returned no results."]
    </div>
</div>

<script asp-src="~/OrchardCore.Recipes/Scripts/recipes-index/recipes-index.min.js" debug-src="~/OrchardCore.Recipes/Scripts/recipes-index/recipes-index.js" at="Foot" type="module"></script>
