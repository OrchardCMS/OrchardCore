@model OrchardCore.Taxonomies.ViewModels.EditTagTaxonomyFieldViewModel
@using System.Text.Json
@using OrchardCore.Taxonomies.Settings
@using OrchardCore.ContentManagement.Metadata.Models
@using OrchardCore.ContentFields
@using Microsoft.AspNetCore.Authorization
@using OrchardCore.Mvc.Utilities
@using OrchardCore.Localization.Data
@inject IAuthorizationService AuthorizationService
@inject IDataLocalizer D

@{
    var taxonomySettings = Model.PartFieldDefinition.GetSettings<TaxonomyFieldSettings>();
    var tagsSettings = Model.PartFieldDefinition.GetSettings<TaxonomyFieldTagsEditorSettings>();

    var partName = Model.PartFieldDefinition.PartDefinition.Name;
    var fieldName = Model.PartFieldDefinition.Name;

    var createTagUrl = Url.Action("Create", "Tag", new { area = "OrchardCore.Taxonomies" });

    bool open = tagsSettings.Open;
    if (!await AuthorizationService.AuthorizeAsync(User, OrchardCore.Taxonomies.Permissions.ManageTaxonomies))
    {
        open = false;
    }

    // Only the leaves can be picked when the field is restricted to them.
    var selectableTerms = taxonomySettings.LeavesOnly ? Model.TagTerms.Where(term => term.IsLeaf).ToArray() : Model.TagTerms.ToArray();
    var placeholder = string.IsNullOrEmpty(taxonomySettings.Placeholder) ? T["Type to search"].Value : taxonomySettings.Placeholder;
    string localizedFieldName = D[Model.PartFieldDefinition.DisplayName(), DataLocalizationContext.ContentField(Model.PartFieldDefinition.PartDefinition.Name)];
}

<style asp-name="bootstrap-select" at="Head"></style>
<script asp-name="bootstrap-select" at="Foot"></script>

<div class="@($"ocat-wrapper field-wrapper field-wrapper-{Model.PartFieldDefinition.PartDefinition.Name.HtmlClassify()}-{Model.PartFieldDefinition.Name.HtmlClassify()}" + (Model.PartFieldDefinition.IsNamedPart() ? $" field-wrapper-{Model.PartFieldDefinition.ContentTypePartDefinition.Name.HtmlClassify()}-{Model.PartFieldDefinition.Name.HtmlClassify()}" : string.Empty))" id="@Html.IdFor(x => x.TermContentItemIds)_FieldWrapper">
    <span id="@Html.IdFor(x => x.TermContentItemIds)_Label" class="ocat-label @(taxonomySettings.Required ? "ocat-label-required" : "")">@localizedFieldName</span>
    <div class="ocat-end" role="group" aria-labelledby="@Html.IdFor(x => x.TermContentItemIds)_Label">
        @if (Model.Taxonomy == null)
        {
            <div class="alert alert-warning" role="alert">
                @T["The taxonomy could not be found. Please check the settings for this field."]
            </div>
        }
        else
        {
            <input type="hidden" asp-for="TermContentItemIds" />
            <select id="@($"{Html.IdFor(x => x.TermContentItemIds)}_Picker")" multiple="@(!taxonomySettings.Unique)" disabled="@(!open && selectableTerms.Length == 0)"
                    data-tags-editor
                    data-values-input="@Html.IdFor(x => x.TermContentItemIds)"
                    data-taxonomy-content-item-id="@Model.Taxonomy.ContentItemId"
                    data-create-tag-url="@createTagUrl"
                    data-create-tag-error-message="@T["Error creating tag"]"
                    data-open-options="@open.ToString().ToLowerInvariant()"
                    data-open-options-text="@T["Create the tag: {0}", "{0}"]"
                    data-live-search="true"
                    data-show-selected-tags="true"
                    data-allow-clear="@taxonomySettings.Unique.ToString().ToLowerInvariant()"
                    data-width="100%"
                    placeholder="@placeholder"
                    data-live-search-placeholder="@T["Search"]"
                    data-none-results-text="@T["No tags match {0}", "{0}"]"
                    data-deselect-all-text="@T["Clear"]"
                    data-selected-tag-remove-label="@T["Remove"]"
                    aria-label="@localizedFieldName">
                @foreach (var term in selectableTerms)
                {
                    <option value="@term.ContentItemId" selected="@term.Selected">@term.DisplayText</option>
                }
            </select>

            <script asp-src="~/OrchardCore.Taxonomies/Scripts/taxonomy-field-tags/taxonomy-field-tags.min.js" debug-src="~/OrchardCore.Taxonomies/Scripts/taxonomy-field-tags/taxonomy-field-tags.js" at="Foot" depends-on="bootstrap-select" type="module"></script>

            <span asp-validation-for="TermContentItemIds"></span>
        }

        @if (!string.IsNullOrEmpty(taxonomySettings.Hint))
        {
            @await DisplayAsync(await New.Hint_Admin(Hint: taxonomySettings.Hint))
        }
    </div>
</div>
