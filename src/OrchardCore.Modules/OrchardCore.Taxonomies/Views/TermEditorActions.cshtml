@*
    The actions of the editor of a taxonomy term, which replace the actions of a content item: a term is saved in the
    content of its taxonomy, which is published from the editor of the taxonomy.

    Properties:
        TaxonomyContentItemId  The id of the taxonomy the term belongs to.
*@
@{
    string taxonomyContentItemId = Model.TaxonomyContentItemId;
}

@* The content editor renders its own Cancel button when the page has a return URL. *@
@if (string.IsNullOrWhiteSpace(Context.Request.Query["returnUrl"]))
{
    <a class="btn btn-secondary cancel" role="button" asp-action="Edit" asp-controller="Admin" asp-route-area="OrchardCore.Contents" asp-route-contentItemId="@taxonomyContentItemId">@T["Cancel"]</a>
}
<button type="submit" class="btn btn-primary save" name="submit.Save" value="submit.Save">@T["Save Term"]</button>

<script at="Foot" asp-src="~/OrchardCore.Contents/Scripts/expand-cards-with-invalid-inputs.js"></script>
