@using OrchardCore.ContentManagement
@using OrchardCore.ContentManagement.Metadata
@using OrchardCore.Mvc.Utilities
@using OrchardCore.Localization.Data

@inject IContentDefinitionManager ContentDefinitionManager
@inject IContentManager ContentManager
@inject IDataLocalizer D

@{
    ContentItem contentItem = Model.ContentItem;
    var contentTypeDefinition = await ContentDefinitionManager.GetTypeDefinitionAsync(contentItem.ContentType);
    var typeDisplayName = contentTypeDefinition?.DisplayName ?? contentItem.ContentType.CamelFriendly();
    string localizedTypeDisplayName = D[typeDisplayName, "Content Types"];
    string taxonomyContentItemId = Model.TaxonomyContentItemId;
}

<zone Name="Title">
    <breadcrumb name="TaxonomiesCreate" title="@T["New {0}", localizedTypeDisplayName]">
        <breadcrumb-item id="Contents" action="List" controller="Admin" area="OrchardCore.Contents" route-contentTypeId="">@T["Manage Content"]</breadcrumb-item>
        @if (!string.IsNullOrEmpty(taxonomyContentItemId))
        {
            var taxonomy = await ContentManager.GetAsync(taxonomyContentItemId);
            <breadcrumb-item id="Taxonomy" action="Edit" controller="Admin" area="OrchardCore.Contents" route-contentItemId="@taxonomyContentItemId">@T["Edit {0}", taxonomy?.DisplayText]</breadcrumb-item>
        }
    </breadcrumb>
</zone>

<form asp-action="Create" asp-route-returnUrl="@Context.Request.Query["ReturnUrl"]" method="post" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model)

    <input type="hidden" name="TaxonomyContentItemId" value="@Model.TaxonomyContentItemId" />
    <input type="hidden" name="TaxonomyItemId" value="@Model.TaxonomyItemId" />
</form>
