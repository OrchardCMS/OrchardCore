@model SelectContentTypesViewModel
@using OrchardCore.Localization.Data
@inject IDataLocalizer D

<style asp-name="bootstrap-select" at="Head"></style>
<script asp-name="bootstrap-select" at="Foot"></script>
<script asp-src="~/OrchardCore.Contents/Scripts/content-type-picker/content-type-picker.min.js" debug-src="~/OrchardCore.Contents/Scripts/content-type-picker/content-type-picker.js" at="Foot" type="module"></script>
<select id="@Html.GenerateIdFromName(Model.HtmlName)" name="@Model.HtmlName" class="selectpicker" multiple
        data-content-type-picker
        data-live-search="true"
        data-actions-box="true"
        data-show-selected-tags="true"
        data-selection-indicator="checkbox"
        data-width="100%"
        placeholder="@T["Any content type"]"
        data-select-all-text="@T["Select all"]"
        data-deselect-all-text="@T["Deselect all"]"
        data-none-results-text="@T["No content type matches {0}", "{0}"]"
        data-live-search-placeholder="@T["Search content types"]"
        data-selected-tag-remove-label="@T["Remove"]">
    @foreach (var selection in Model.ContentTypeSelections)
    {
        <option value="@selection.ContentTypeDefinition.Name" selected="@selection.IsSelected">@D[selection.ContentTypeDefinition.DisplayName, "Content Types"]</option>
    }
</select>
