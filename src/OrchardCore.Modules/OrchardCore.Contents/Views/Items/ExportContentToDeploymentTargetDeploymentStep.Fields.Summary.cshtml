@model ShapeViewModel<ExportContentToDeploymentTargetDeploymentStep>

<h5>@T["Export Content To Deployment Target"]</h5>

<span class="hint">@T["Allows the export content to deployment target feature to add content items to the plan."]</span>

@if (Model.Value.ContentItemIds is not null)
{
    <p class="hint">@T["This step exports {0} explicitly selected content items. Latest versions: {1}.", Model.Value.ContentItemIds.Length, Model.Value.Latest]</p>
}
