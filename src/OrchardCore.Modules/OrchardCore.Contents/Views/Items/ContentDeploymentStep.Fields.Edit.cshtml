@model ContentDeploymentStepViewModel

@{
    var contentTypes = (string[])Model.ContentTypes;
}

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <span class="hint">@T["The content types to add as part of the plan."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        @await Component.InvokeAsync("SelectContentTypes", new { selectedContentTypes = contentTypes, htmlName = Html.NameFor(m => m.ContentTypes) })
    </div>
</div>
