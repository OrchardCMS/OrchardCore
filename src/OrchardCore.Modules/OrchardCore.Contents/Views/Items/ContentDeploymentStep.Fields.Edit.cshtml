@model ContentDeploymentStepViewModel
@using OrchardCore.ContentTypes
@using OrchardCore.Localization.Data
@inject OrchardCore.ContentManagement.Metadata.IContentDefinitionManager ContentDefinitionManager
@inject IDataLocalizer D

@{
    var contentTypes = (string[])Model.ContentTypes;
}

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <span class="hint">@T["The content types to add as part of the plan."]</span>
    </div>
</div>

<div class="ocat-wrapper">
    <div class="ocat-end-offset">
        <ul class="list-group">
            @foreach (var contentTypeDefinition in (await ContentDefinitionManager.ListTypeDefinitionsAsync()).OrderBy(i => i.Name))
            {
                var name = contentTypeDefinition.Name;
                var checkd = contentTypes?.Contains(name);

                <li class="list-group-item">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="@(Html.IdFor(m => m.ContentTypes) + "_" + contentTypeDefinition.Name)" name="@Html.NameFor(m => m.ContentTypes)" value="@name" checked="@checkd">
                        <label class="form-check-label" for="@(Html.IdFor(m => m.ContentTypes) + "_" + contentTypeDefinition.Name)">@D[contentTypeDefinition.DisplayName, DataLocalizationContext.ContentType]</label>
                    </div>
                </li>
            }
        </ul>
    </div>
</div>
