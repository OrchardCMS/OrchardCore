@model IShape
@using OrchardCore.ContentManagement
@using OrchardCore.ContentManagement.Metadata.Models
@inject IAuthorizationService AuthorizationService
@inject IContentDefinitionManager ContentDefinitionManager
@inject IContentManager ContentManager

@{
    var contentItem = Model.GetProperty<ContentItem>("ContentItem");
    var versionNumber = Model.GetProperty<int>("VersionNumber");
    var canList = false;

    if (User is not null)
    {
        var listableTypes = (await ContentDefinitionManager.ListTypeDefinitionsAsync()).Where(definition => definition.IsListable());
        canList = await AuthorizationService.AuthorizeContentTypeDefinitionsAsync(User, CommonPermissions.ListContent, listableTypes, ContentManager);
    }
}

<style asp-src="~/OrchardCore.Contents/Styles/audittrail-disabledcontent.min.css" debug-src="~/OrchardCore.Contents/Styles/audittrail-disabledcontent.css"></style>
<script asp-src="~/OrchardCore.Contents/Scripts/audittrail-disabledcontent.min.js" debug-src="~/OrchardCore.Contents/Scripts/audittrail-disabledcontent.js" at="Foot"></script>

<zone Name="Title">
    <breadcrumb name="ContentsDisplay" title="@T["{0} {1} - Version {2}", contentItem.ContentType, contentItem.DisplayText, versionNumber]">
        <breadcrumb-item id="Contents" action="List" controller="Admin" area="OrchardCore.Contents" route-contentTypeId="" link-enabled="@canList">@T["Manage Content"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div class="disabledContent__wrapper">
    @await DisplayAsync(Model)
    <div class="disabledContent__overlay"></div>
</div>
