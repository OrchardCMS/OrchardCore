@model ListContentsViewModel
@using OrchardCore.Contents
@using OrchardCore.Contents.ViewModels

<zone Name="Title">
    <breadcrumb name="@ContentsBreadcrumbs.List" data="@(new { ContentType = Model.Options.SelectedContentType })" />
</zone>

<form asp-action="List" asp-controller="Admin" method="post" id="items-form" autocomplete="off">
    @Html.ValidationSummary()
    @await DisplayAsync(Model)
</form>
