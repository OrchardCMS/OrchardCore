@using OrchardCore.Admin
@using OrchardCore.ContentFields
@using OrchardCore.ContentManagement.Display.ContentDisplay
@using OrchardCore.ContentManagement.Metadata.Models
@using OrchardCore.Localization.Data
@inject IDataLocalizer D
@{
    // Wraps the display of a content field whose 'Display the field name' setting is enabled, to show its name next to its value.
    var shape = (IShape)Model;
    shape.Properties.TryGetValue(ContentFieldDisplayConstants.PartFieldDefinitionProperty, out var value);
    var partFieldDefinition = value as ContentPartFieldDefinition;
}
@if (partFieldDefinition is null)
{
    @shape.Metadata.ChildContent
}
else
{
    var fieldName = (partFieldDefinition.PartDefinition.Name + "-" + partFieldDefinition.Name).HtmlClassify();
    string displayName = D[partFieldDefinition.DisplayName(), DataLocalizationContext.ContentField(partFieldDefinition.PartDefinition.Name)];

    if (AdminAttribute.IsApplied(ViewContext.HttpContext))
    {
        <div class="ocat-wrapper field-display field-display-@fieldName">
            <div class="ocat-label">@displayName</div>
            <div class="ocat-end">
                @shape.Metadata.ChildContent
            </div>
        </div>
    }
    else
    {
        <div class="field-display field-display-@fieldName">
            <span class="field-display-name">@displayName</span>
            @shape.Metadata.ChildContent
        </div>
    }
}
