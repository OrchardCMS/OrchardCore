@model DashboardViewModel

@{
    Model.Dashboards ??= [];

    // Todo Create Settings for Dashboard.
    var settings = new
    {
        // Default is 1, i.e. 6 columns in large screen, 3 for tablets and 1 for phones.
        // Changing Scale 2 will increase the # columns to 12 for large screen, 6 for tablets and 2 for phones.
        ColumnScale = 1
    };
}

@if (!Model.CanManageDashboard && Model.Dashboards.Length == 0)
{
    // The user can't view the dashboard, or it has no widgets they can see.
    var unavailable = await New.DashboardUnavailable(DashboardType: Model.DashboardType, CanView: Model.CanViewDashboard);
    unavailable.Metadata.Alternates.Add($"DashboardUnavailable__{Model.DashboardType.Name}");

    @await DisplayAsync(unavailable)

    return;
}

<style asp-src="~/OrchardCore.Dashboards/Styles/dashboard.min.css" debug-src="~/OrchardCore.Dashboards/Styles/dashboard.css" at="Head"></style>

@if (Model.CanManageDashboard)
{
    <div class="btn-group float-end mb-3">
        <a class="btn btn-primary btn-sm" asp-action="Manage" asp-route-type="@Model.DashboardType.Name">
            @T["Manage Dashboard"]
        </a>
    </div>
}

<zone Name="Title"><h1 class="float-start">@RenderTitleSegments(Model.Title)</h1></zone>
<div class="clearfix"></div>

@if (Model.Dashboards.Length > 0)
{
    <div class="dashboard-container" style="--dashboard-columns: calc( @(settings.ColumnScale) * var(--dashboard-columns-default));">
        @foreach (var dashboard in Model.Dashboards)
        {
            @await DisplayAsync(dashboard)
        }
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        @T["Click on Manage Dashboard button to add dashboard widget."]
    </div>
}
