@using OrchardCore.DisplayManagement.Views
@using OrchardCore.UrlRewriting.Models

@model ShapeViewModel<RewriteRule>

<div class="form-check">
    <input type="checkbox" class="form-check-input" value="@Model.Value.Id" name="ruleIds" id="ruleIds-@Model.Value.Id">
    <label class="form-check-label" for="ruleIds-@Model.Value.Id">&nbsp;</label>
</div>
