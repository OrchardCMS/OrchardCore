@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using OrchardCore.Localization
@using OrchardCore.UrlRewriting

@inject IOptions<UrlRewriteRuleSourceOptions> RuleSourceOptions
@inject IStringLocalizerFactory StringLocalizerFactory

@{
    RuleSourceOptions.Value.Sources.TryGetValue(Model.Source as string ?? string.Empty, out var descriptor);
    var displayName = descriptor == null ? null : StringLocalizerFactory.Localize(descriptor.DisplayName).Value;
    var description = descriptor == null ? null : StringLocalizerFactory.Localize(descriptor.Description).Value;
}

<div class="col">
    <div class="card h-100">
        <div class="card-body">
            <h4>@(displayName ?? Model.Source)</h4>
            <p class="hint">@description</p>
        </div>
        <div class="card-footer text-muted text-sm-end">
            <a class="btn btn-primary btn-sm" 
               asp-route-action="Create" 
               asp-route-controller="Admin" 
               asp-route-id="@Model.Name" 
               asp-area="OrchardCore.UrlRewriting">@T["Add"]</a>
        </div>
    </div>
</div>
