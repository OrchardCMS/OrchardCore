@model RewriteRuleViewModel

<zone Name="Title">
    <breadcrumb name="UrlRewritingEdit" title="@T["Edit '{0}' rule", Model.DisplayName]">
        <breadcrumb-item id="UrlRewriting" action="Index" controller="Admin" area="OrchardCore.UrlRewriting" permission="@UrlRewritingPermissions.ManageUrlRewritingRules.Name">@T["URL Rewriting Rules"]</breadcrumb-item>
    </breadcrumb>
</zone>

<form method="post" asp-route-id="@ViewContext.HttpContext.Request.RouteValues["id"]" enctype="multipart/form-data" class="no-multisubmit">
    @Html.ValidationSummary()
    @await DisplayAsync(Model.Editor)

    <button class="btn btn-primary" type="submit">@T["Save"]</button>

    <a class="btn btn-secondary cancel"
       role="button"
       asp-route-action="Index"
       asp-route-controller="Admin"
       asp-route-area="OrchardCore.UrlRewriting">@T["Cancel"]</a>
</form>
