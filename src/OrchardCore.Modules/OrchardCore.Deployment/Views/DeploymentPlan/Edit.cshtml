@model EditDeploymentPlanViewModel

<zone Name="Title">
    <breadcrumb name="DeploymentPlansEdit" title="@T["Edit Deployment Plan"]">
        <breadcrumb-item id="DeploymentPlans" action="Index" controller="DeploymentPlan" area="OrchardCore.Deployment" permission="@DeploymentPermissions.Export.Name">@T["Deployment Plans"]</breadcrumb-item>
    </breadcrumb>
</zone>

<div asp-validation-summary="All"></div>
<form asp-action="Edit" method="post" class="no-multisubmit">
    <input type="hidden" asp-for="Id" />
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary save" type="submit">@T["Save"]</button>
        <a class="btn btn-secondary cancel" role="button" asp-route-action="Index">@T["Cancel"]</a>
    </div>
</form>
