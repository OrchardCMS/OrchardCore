@model ImportPackageViewModel

<zone Name="Title">
    <breadcrumb name="DeploymentImport" title="@T["Import Deployment Package"]" />
</zone>
<form asp-action="Import" enctype="multipart/form-data" class="no-multisubmit">
    @await DisplayAsync(Model.Editor)

    <div class="action-bar-bottom">
        <button class="btn btn-primary import" type="submit">@T["Import"]</button>
    </div>
</form>
