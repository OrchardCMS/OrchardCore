@using System.Text.Json.Serialization
@model dynamic

<div class="w-100">
    <div class="float-end">
        @if (Model.DeploymentStep is not IUnknownTypePlaceholder)
        {
            <a asp-action="Edit"
               asp-controller="Step"
               asp-route-id="@Model.DeploymentPlanId"
               asp-route-stepId="@Model.DeploymentStep.Id"
               class="btn btn-primary btn-sm">@Localize(CommonLocalizationSources.Edit)</a>
        }

        <a asp-action="Delete"
           asp-controller="Step"
           asp-route-id="@Model.DeploymentPlanId"
           asp-route-stepId="@Model.DeploymentStep.Id"
           class="btn btn-danger btn-sm"
           data-url-af="RemoveUrl UnsafeUrl">@Localize(CommonLocalizationSources.Delete)</a>
    </div>

    @await DisplayAsync(Model.Content)
</div>
