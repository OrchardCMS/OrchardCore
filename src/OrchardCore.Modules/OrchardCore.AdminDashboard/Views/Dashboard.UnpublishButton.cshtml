<a class="dropdown-item" asp-action="Unpublish" asp-controller="Admin" asp-route-area="OrchardCore.Contents"
   asp-route-contentItemId="@Model.ContentItem.ContentItemId" asp-route-returnUrl="@FullRequestPath"
   data-url-af="UnsafeUrl RemoveUrl" data-title=@T["Unpublish"] data-message=@T["Are you sure you want to unpublish this item?"]
   data-ok-text="@Localize(CommonLocalizationSources.Yes)" data-cancel-text="@Localize(CommonLocalizationSources.No)" data-ok-class="btn-primary">@T["Unpublish"]</a>
