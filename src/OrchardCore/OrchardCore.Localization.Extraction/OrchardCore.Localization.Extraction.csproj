<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RazorCompilerDirectory>$(NetCoreRoot)sdk/$(NETCoreSdkVersion)/Sdks/Microsoft.NET.Sdk.Razor/source-generators</RazorCompilerDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Fluid.Core" />
    <ProjectReference Include="../OrchardCore.DisplayManagement.Liquid/OrchardCore.DisplayManagement.Liquid.csproj" AdditionalProperties="GenerateLocalizationCatalog=false" />
    <Reference Include="Microsoft.CodeAnalysis.Razor.Compiler" HintPath="$(RazorCompilerDirectory)/Microsoft.CodeAnalysis.Razor.Compiler.dll" />
    <Reference Include="Microsoft.AspNetCore.Razor.Utilities.Shared" HintPath="$(RazorCompilerDirectory)/Microsoft.AspNetCore.Razor.Utilities.Shared.dll" />
  </ItemGroup>
</Project>
