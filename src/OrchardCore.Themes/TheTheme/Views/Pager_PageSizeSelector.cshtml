@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var items = Model.PageSizes as List<SelectListItem>;
    var selectId = $"pager-page-size-{Guid.NewGuid():n}";
}
@if (items is { Count: > 0 })
{
    <div class="pager-page-size d-flex align-items-center ms-auto">
        <label for="@selectId" class="col-form-label text-nowrap me-2">@T["Items per page"]</label>
        <select id="@selectId" class="form-select form-select-sm w-auto" onchange="if (this.value) { window.location.href = this.value; }">
            @foreach (var item in items)
            {
                <option value="@item.Value" selected="@item.Selected">@item.Text</option>
            }
        </select>
    </div>
}
