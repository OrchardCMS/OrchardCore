<section class="saas-welcome">
    <div class="saas-welcome__mark" aria-hidden="true">
        <span></span><span></span><span></span>
    </div>
    <span class="saas-eyebrow">@T["Orchard Core SaaS"]</span>
    <h1>@T["Welcome to {0}", Site.SiteName]</h1>
    <p>@T["Your site is ready. Open the administration area to manage its settings and tenants."]</p>
    <a class="btn btn-primary btn-lg" href="@Url.Content("~/Admin")">@T["Open administration"]</a>
</section>
