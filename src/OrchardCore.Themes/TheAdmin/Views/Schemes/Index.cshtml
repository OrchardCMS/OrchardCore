@model AdminSchemesIndexViewModel

@*
    The schemes of the admin. A site has a handful of them at most, so the list has no search, paging or bulk actions,
    and needs no list script.
*@

<zone Name="Title">
    <breadcrumb name="AdminSchemes" title="@T["Admin schemes"]" />
</zone>

<p class="hint">@T["The schemes users can pick for the admin. Each is made of four colors, from which every other color, light and dark, is derived and adjusted to meet WCAG 2.2 AA contrast, and of the fonts, sizes, corners and spacing of the admin. The theme adds its default schemes once; edit or delete them like any other."]</p>

<div class="card text-bg-theme mb-3 position-sticky action-bar">
    <div class="card-body">
        <div class="row gx-2 justify-content-end">
            <div class="col-auto">
                <a asp-action="Create" class="btn btn-secondary create" role="button">@T["Add scheme"]</a>
            </div>
        </div>
    </div>
</div>

@* The rows are rendered by the AdminList shape using the configured layout (List, Grid, ...). *@
<admin-list name="AdminSchemes" context="Model.List" show-select-all="false"
            empty-message="@T["<strong>Nothing here!</strong> There are no schemes for the moment."]">
    <admin-list-list item-css-class="list-group-item" />
    <admin-list-grid>
        <admin-list-column name="Name" position="20" title="@T["Name"]" />
        <admin-list-column name="Colors" position="30" title="@T["Colors"]" width="auto" />
        <admin-list-column type="Actions" title="@T["Actions"]" />
    </admin-list-grid>
</admin-list>
