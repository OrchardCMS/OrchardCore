@model OrchardCore.DisplayManagement.ViewModels.GroupingViewModel
@using OrchardCore.DisplayManagement
@using OrchardCore.DisplayManagement.ViewModels
@using OrchardCore.Mvc.Utilities

@inject IShapeFactory ShapeFactory

@*
    A card of a content zone, grouping the shapes placed in the same card, e.g. with a "Content:5%Server;10"
    placement, rendered as a Bootstrap card, or as a fieldset in a tab, always expanded: it groups fields, it doesn't
    hide them. The shapes placed in no card are grouped under the "Content" key: they render as they are.
*@

@{
    var name = Model.Grouping.Key;

    // The columns of the shapes placed in this card, e.g. with a "Content:5%Server|Left" placement.
    var columns = await ShapeFactory.CreateAsync<GroupingViewModel>("ColumnGrouping", m =>
    {
        m.Identifier = Model.Identifier;
        m.Grouping = Model.Grouping;
    });

    // A card whose shapes render nothing is not shown.
    var content = await DisplayAsync(columns);

    using var writer = new System.IO.StringWriter();
    content.WriteTo(writer, System.Text.Encodings.Web.HtmlEncoder.Default);
    var html = writer.ToString();

    if (string.IsNullOrWhiteSpace(html))
    {
        return;
    }

    var titleId = $"card-{Model.Identifier}-{name}".HtmlClassify();

    // In a tab, which already frames them, the groups are fieldsets titled by their legends, e.g. in the general,
    // email and SMS settings.
    var inTab = Model.Grouping.OfType<IShape>().Any(shape => shape.Metadata.TabGrouping.HasValue);
}

@if (name == "Content")
{
    @Html.Raw(html)
}
else if (inTab)
{
    <fieldset class="mb-4 ocat-card @($"ocat-card-{name}".HtmlClassify())">
        <legend class="fs-6 fw-semibold border-bottom pb-2 mb-3 ocat-card-title">@name</legend>
        <div class="ocat-card-body">
            @Html.Raw(html)
        </div>
    </fieldset>
}
else
{
    <div class="card mb-3 ocat-card @($"ocat-card-{name}".HtmlClassify())" role="group" aria-labelledby="@titleId">
        <div class="card-header ocat-card-title" id="@titleId">@name</div>
        <div class="card-body ocat-card-body">
            @Html.Raw(html)
        </div>
    </div>
}
