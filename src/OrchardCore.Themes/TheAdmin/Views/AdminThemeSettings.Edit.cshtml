@model AdminThemeSettingsViewModel

@*
    The site's default scheme, on the Settings > Admin page. Each scheme is a radio button with the swatch the top
    bar's picker shows for it.
*@

<fieldset class="ocat-wrapper" asp-validation-class-for="DefaultScheme" aria-describedby="@Html.IdFor(m => m.DefaultScheme)_Hint">
    <legend class="ocat-label">@T["Default scheme"]</legend>
    <div class="ocat-end">
        <div class="ta-scheme-choices">
            @foreach (var scheme in Model.Schemes)
            {
                var id = Html.IdFor(m => m.DefaultScheme) + "_" + scheme.Id;
                <div class="form-check ta-scheme-choice">
                    <input type="radio" class="form-check-input" id="@id" name="@Html.NameFor(m => m.DefaultScheme)" value="@scheme.Id" checked="@(Model.DefaultScheme == scheme.Id)" />
                    <label class="form-check-label" for="@id">
                        <span>@scheme.Name</span>
                        <span class="ta-scheme-swatch" data-scheme="@scheme.Id" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
                    </label>
                </div>
            }
        </div>
        <span asp-validation-for="DefaultScheme"></span>
        <span class="hint" id="@Html.IdFor(m => m.DefaultScheme)_Hint">@T["The scheme of the admin for users who have not picked their own from the top bar."]</span>
    </div>
</fieldset>
