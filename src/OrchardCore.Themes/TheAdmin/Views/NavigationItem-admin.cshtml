@using OrchardCore.DisplayManagement
@using OrchardCore.Localization
@using OrchardCore.Navigation
@{
    // The shape is used through its static type, as it is rendered for each menu item, falling back to
    // dynamic accesses for shapes that are not navigation items.
    var shape = (IShape)Model;
    var navigationItem = shape as NavigationItemViewModel;

    TagBuilder li = Tag(shape, "li");

    var level = navigationItem?.Level ?? (int)Model.Level;
    var hasItems = navigationItem?.HasItems ?? (bool)Model.HasItems;
    var isSelected = navigationItem?.Selected ?? (bool)Model.Selected;

    // A group is a first level item holding children. Nothing is expanded when the menu is
    // rendered, the script restores what the user last left open.
    var isGroup = level == 1 && hasItems;

    // Morphing the shape to keep Model untouched.
    shape.Metadata.Alternates.Clear();
    shape.Metadata.Type = "NavigationItemLink";

    if (shape.Id != null)
    {
        shape.Metadata.Alternates.Add("NavigationItemLink_Id__" + shape.Id);
    }

    // Extract classes that are not icons from 'Model.Classes'.
    string notIconClasses = null;

    foreach (var className in shape.Classes)
    {
        if (!className.StartsWith(NavigationConstants.CssClassPrefix, StringComparison.OrdinalIgnoreCase))
        {
            notIconClasses = notIconClasses is null ? className : notIconClasses + " " + className;
        }
    }

    if (notIconClasses is not null)
    {
        li.Attributes["class"] = notIconClasses;
    }
    else
    {
        // This removes the class attribute on the li element when
        // an empty class attribute gets rendered.
        li.Attributes.Remove("class");
    }

    if (isSelected)
    {
        li.AddCssClass("active");

        // Only the deepest selected item represents the current page. Its ancestors are
        // marked as active too, but they must not be highlighted the same way.
        var hasSelectedChild = ((IEnumerable<object>)Model)
            .OfType<NavigationItemViewModel>()
            .Any(child => child.Selected);

        if (!hasSelectedChild)
        {
            li.AddCssClass("current");
        }
    }

    if (level == 1)
    {
        li.AddCssClass("nav-group");
    }

    var figure = new TagBuilder("figure");
    var figCaption = new TagBuilder("figcaption");
    figCaption.AddCssClass("nav-item-row");

    // Render sub-items (MenuItem).
    if (hasItems)
    {
        li.AddCssClass("has-items");

        if (li.Attributes.ContainsKey("id"))
        {
            figure.Attributes["aria-labelledby"] = li.Attributes["id"];
            figCaption.Attributes["id"] = li.Attributes["id"];
            li.Attributes["id"] = null;
        }

        var targetId = "m" + (navigationItem is not null ? navigationItem.Hash : (string)Model.Hash);

        var ul = new TagBuilder("ul");
        ul.Attributes["id"] = targetId;
        ul.Attributes["data-title"] = navigationItem is not null ? navigationItem.Text.ToString() : Model.Text.ToString();
        ul.AddCssClass("collapse");

        if (isGroup)
        {
            ul.AddCssClass("nav-group-items");
        }

        foreach (var item in shape.Items)
        {
            ul.InnerHtml.AppendHtml(await DisplayAsync(item));
        }

        figCaption.InnerHtml.AppendHtml(await DisplayAsync(shape));

        // When the item links to a real page, the label navigates and a dedicated button
        // toggles its children, so both actions stay available.
        var href = navigationItem is not null ? navigationItem.Href : Model.Href?.ToString();

        if (!string.IsNullOrEmpty(href) && href != "#")
        {
            var toggle = new TagBuilder("button");
            toggle.Attributes["type"] = "button";
            toggle.Attributes["data-bs-toggle"] = "collapse";
            toggle.Attributes["data-bs-target"] = "#" + targetId;
            toggle.Attributes["aria-controls"] = targetId;
            toggle.Attributes["aria-expanded"] = "false";
            toggle.Attributes["aria-label"] = T.GetString("Toggle {0}", navigationItem is not null ? navigationItem.Text.ToString() : Model.Text.ToString());
            toggle.AddCssClass("nav-toggle");
            toggle.InnerHtml.AppendHtml(Html.Raw("<i class=\"fa-solid fa-chevron-" + (Orchard.CultureDir() == LanguageDirection.LTR ? "right" : "left") + " chevron\" aria-hidden=\"true\"></i>"));

            figCaption.InnerHtml.AppendHtml(toggle);
        }

        figure.InnerHtml.AppendHtml(figCaption);
        figure.InnerHtml.AppendHtml(ul);
    }
    else
    {
        figCaption.InnerHtml.AppendHtml(await DisplayAsync(shape));
        figure.InnerHtml.AppendHtml(figCaption);
    }

    li.InnerHtml.AppendHtml(figure);
}

@li
