<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="NuGet" value="https://api.nuget.org/v3/index.json" />
        <add key="OrchardCoreTranslations" value="https://nuget.cloudsmith.io/orchardcore/preview/v3/index.json" />
    </packageSources>

    <packageSourceMapping>
        <packageSource key="OrchardCoreTranslations">
            <package pattern="OrchardCore.Translations.*" />
        </packageSource>
        <packageSource key="NuGet">
            <package pattern="*" />
            <!-- Equal specificity allows stable translations to come from NuGet.org. -->
            <package pattern="OrchardCore.Translations.*" />
        </packageSource>
    </packageSourceMapping>

    <disabledPackageSources />
</configuration>
