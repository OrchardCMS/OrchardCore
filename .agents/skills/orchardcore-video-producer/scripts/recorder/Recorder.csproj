<Project Sdk="Microsoft.NET.Sdk">
  <!-- Copy this folder into the video workspace, outside the repository, so the repository's build settings don't apply. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- The Playwright driver files exceed MAX_PATH under deep folders on Windows: build into a short path. -->
    <BaseOutputPath>$([System.IO.Path]::Combine($([System.IO.Path]::GetTempPath()), 'ocvideo', 'bin'))$([System.IO.Path]::DirectorySeparatorChar)</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>
</Project>
