    <ProjectReference Include="..\..\src\OrchardCore.Modules\OrchardCore.Media.Azure\OrchardCore.Media.Azure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moq" />
    <!-- Override Testcontainers until it adopts the SCP path-validation fix (GHSA-q939-rpr3-3284). -->
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.Azurite" />
    <PackageReference Include="Testcontainers.LocalStack" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <Import Project="..\..\src\OrchardCore.Build\OrchardCore.Commons.targets" />

</Project>
