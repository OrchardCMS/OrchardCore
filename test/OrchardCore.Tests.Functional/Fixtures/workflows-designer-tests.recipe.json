{
  "name": "WorkflowsDesignerTests",
  "displayName": "WorkflowsDesignerTests",
  "description": "Testing the OrchardCore.Workflows designer: the canvas, the properties panel, drafts and publishing, and the read-only instance viewer.",
  "author": "The Orchard Core Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [ "tests" ],
  "tags": [ "tests" ],

  "steps": [
    {
      "name": "feature",
      "enable": [
        "OrchardCore.HomeRoute",
        "OrchardCore.Admin",
        "OrchardCore.Navigation",
        "OrchardCore.Recipes",
        "OrchardCore.Resources",
        "OrchardCore.Roles",
        "OrchardCore.Security",
        "OrchardCore.Settings",
        "OrchardCore.Themes",
        "OrchardCore.Users",

        "OrchardCore.Contents",
        "OrchardCore.Workflows",
        "OrchardCore.Workflows.Http",
        "OrchardCore.Workflows.Timers",
        "WorkflowsSample",
        "OrchardCore.SignalR",
        "OrchardCore.Workflows.SignalR",

        "TheAdmin",
        "SafeMode"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin",
      "site": "TheAdmin"
    },
    {
      "name": "Roles",
      "Roles": [
        {
          "Name": "WorkflowViewer",
          "Description": "Can open the admin, but can't manage workflows.",
          "Permissions": [ "AccessAdminPanel" ]
        },
        {
          "Name": "WorkflowEditor",
          "Description": "Can manage workflows.",
          "Permissions": [ "AccessAdminPanel", "ManageWorkflows" ]
        }
      ]
    },
    {
      "name": "WorkflowType",
      "data": [
        {
          "WorkflowTypeId": "wfdseededapproval",
          "Name": "Seeded approval",
          "IsEnabled": true,
          "IsSingleton": false,
          "DeleteFinishedWorkflows": false,
          "Activities": [
            {
              "ActivityId": "seededrequest",
              "Name": "HttpRequestEvent",
              "X": 40,
              "Y": 40,
              "IsStart": true,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Article submitted"
                },
                "HttpMethod": "GET",
                "ValidateAntiforgeryToken": false
              }
            },
            {
              "ActivityId": "seedednotify",
              "Name": "NotifyTask",
              "X": 360,
              "Y": 40,
              "IsStart": false,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Notify the editors"
                },
                "Message": {
                  "Expression": "An article is waiting for review."
                }
              }
            },
            {
              "ActivityId": "seededsignal",
              "Name": "SignalEvent",
              "X": 360,
              "Y": 240,
              "IsStart": false,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Wait for approval"
                },
                "SignalName": {
                  "Expression": "approve"
                }
              }
            },
            {
              "ActivityId": "seededapproved",
              "Name": "NotifyTask",
              "X": 680,
              "Y": 240,
              "IsStart": false,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Notify the author"
                },
                "Message": {
                  "Expression": "Your article was approved."
                }
              }
            }
          ],
          "Transitions": [
            {
              "SourceActivityId": "seededrequest",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "seedednotify"
            },
            {
              "SourceActivityId": "seedednotify",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "seededsignal"
            },
            {
              "SourceActivityId": "seededsignal",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "seededapproved"
            }
          ]
        },
        {
          "WorkflowTypeId": "wfdversionedapproval",
          "Name": "Versioned approval",
          "IsEnabled": true,
          "IsSingleton": false,
          "DeleteFinishedWorkflows": false,
          "Activities": [
            {
              "ActivityId": "versionstart",
              "Name": "HttpRequestEvent",
              "X": 40,
              "Y": 40,
              "IsStart": true,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Approval requested"
                },
                "HttpMethod": "GET",
                "ValidateAntiforgeryToken": false
              }
            },
            {
              "ActivityId": "versionrespond",
              "Name": "HttpResponseTask",
              "X": 360,
              "Y": 40,
              "IsStart": false,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Return the approval URL"
                },
                "Content": {
                  "Expression": "{{ 'approve' | signal_url }}"
                },
                "HttpStatusCode": 200,
                "ContentType": {
                  "Expression": "text/plain"
                }
              }
            },
            {
              "ActivityId": "versionwait",
              "Name": "SignalEvent",
              "X": 360,
              "Y": 240,
              "IsStart": false,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Wait for the approval"
                },
                "SignalName": {
                  "Expression": "approve"
                }
              }
            },
            {
              "ActivityId": "versiondone",
              "Name": "NotifyTask",
              "X": 680,
              "Y": 240,
              "IsStart": false,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Notify the requester"
                },
                "Message": {
                  "Expression": "Approved."
                }
              }
            }
          ],
          "Transitions": [
            {
              "SourceActivityId": "versionstart",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "versionrespond"
            },
            {
              "SourceActivityId": "versionrespond",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "versionwait"
            },
            {
              "SourceActivityId": "versionwait",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "versiondone"
            }
          ]
        },
        {
          "WorkflowTypeId": "wfdvariablesgreeting",
          "Name": "Variables greeting",
          "IsEnabled": true,
          "IsSingleton": false,
          "DeleteFinishedWorkflows": false,
          "Activities": [
            {
              "ActivityId": "greetstart",
              "Name": "HttpRequestEvent",
              "X": 40,
              "Y": 40,
              "IsStart": true,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Greeting requested"
                },
                "HttpMethod": "GET",
                "ValidateAntiforgeryToken": false
              }
            },
            {
              "ActivityId": "greetscript",
              "Name": "ScriptTask",
              "X": 360,
              "Y": 40,
              "IsStart": false,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Compose the greeting"
                },
                "AvailableOutcomes": [
                  "Done"
                ],
                "Script": {
                  "Expression": "setOutcome('Done'); 'hello ' + 21 * 2;"
                }
              }
            },
            {
              "ActivityId": "greetrespond",
              "Name": "HttpResponseTask",
              "X": 680,
              "Y": 40,
              "IsStart": false,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Return the greeting"
                },
                "Content": {
                  "Expression": "{{ Workflow.Variables.greeting }}"
                },
                "HttpStatusCode": 200,
                "ContentType": {
                  "Expression": "text/plain"
                }
              }
            }
          ],
          "Transitions": [
            {
              "SourceActivityId": "greetstart",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "greetscript"
            },
            {
              "SourceActivityId": "greetscript",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "greetrespond"
            }
          ]
        },
        {
          "WorkflowTypeId": "wfdexpressionsyntaxes",
          "Name": "Expression syntaxes",
          "IsEnabled": true,
          "IsSingleton": false,
          "DeleteFinishedWorkflows": false,
          "Variables": [
            {
              "Name": "name",
              "TypeName": "string"
            }
          ],
          "Activities": [
            {
              "ActivityId": "syntaxstart",
              "Name": "HttpRequestEvent",
              "X": 40,
              "Y": 40,
              "IsStart": true,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Name requested"
                },
                "HttpMethod": "GET",
                "ValidateAntiforgeryToken": false
              }
            },
            {
              "ActivityId": "syntaxset",
              "Name": "SetVariableTask",
              "X": 360,
              "Y": 40,
              "IsStart": false,
              "Properties": {
                "VariableName": "name",
                "Value": {
                  "Expression": "'from script'"
                },
                "LiquidValue": {
                  "Expression": "{{ 'legacy' }}"
                },
                "Syntax": "Liquid"
              }
            },
            {
              "ActivityId": "syntaxrespond",
              "Name": "HttpResponseTask",
              "X": 680,
              "Y": 40,
              "IsStart": false,
              "Properties": {
                "Content": {
                  "Expression": "{{ Workflow.Variables.name }}"
                },
                "HttpStatusCode": 200,
                "ContentType": {
                  "Expression": "text/plain"
                }
              }
            }
          ],
          "Transitions": [
            {
              "SourceActivityId": "syntaxstart",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "syntaxset"
            },
            {
              "SourceActivityId": "syntaxset",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "syntaxrespond"
            }
          ]
        },
        {
          "WorkflowTypeId": "wfdtransientfailure",
          "Name": "Transient failure",
          "IsEnabled": true,
          "IsSingleton": false,
          "DeleteFinishedWorkflows": false,
          "Activities": [
            {
              "ActivityId": "faultstart",
              "Name": "HttpRequestEvent",
              "X": 40,
              "Y": 40,
              "IsStart": true,
              "Properties": {
                "HttpMethod": "GET",
                "ValidateAntiforgeryToken": false
              }
            },
            {
              "ActivityId": "faultcall",
              "Name": "TransientFailureTask",
              "X": 360,
              "Y": 40,
              "IsStart": false,
              "Properties": {}
            },
            {
              "ActivityId": "faultdone",
              "Name": "SetPropertyTask",
              "X": 680,
              "Y": 40,
              "IsStart": false,
              "Properties": {
                "PropertyName": "Done",
                "Value": {
                  "Expression": "yes",
                  "Syntax": "Literal"
                }
              }
            }
          ],
          "Transitions": [
            {
              "SourceActivityId": "faultstart",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "faultcall"
            },
            {
              "SourceActivityId": "faultcall",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "faultdone"
            }
          ]
        },
        {
          "WorkflowTypeId": "wfdliveapproval",
          "Name": "Live approval",
          "IsEnabled": true,
          "IsSingleton": false,
          "DeleteFinishedWorkflows": false,
          "Activities": [
            {
              "ActivityId": "livestart",
              "Name": "HttpRequestEvent",
              "X": 40,
              "Y": 40,
              "IsStart": true,
              "Properties": {
                "HttpMethod": "GET",
                "ValidateAntiforgeryToken": false
              }
            },
            {
              "ActivityId": "liverespond",
              "Name": "HttpResponseTask",
              "X": 360,
              "Y": 40,
              "IsStart": false,
              "Properties": {
                "Content": {
                  "Expression": "{{ 'approve' | signal_url }}"
                },
                "HttpStatusCode": 200,
                "ContentType": {
                  "Expression": "text/plain"
                }
              }
            },
            {
              "ActivityId": "livewait",
              "Name": "SignalEvent",
              "X": 360,
              "Y": 240,
              "IsStart": false,
              "Properties": {
                "SignalName": {
                  "Expression": "approve"
                }
              }
            },
            {
              "ActivityId": "livedone",
              "Name": "NotifyTask",
              "X": 680,
              "Y": 240,
              "IsStart": false,
              "Properties": {
                "Message": {
                  "Expression": "Approved."
                }
              }
            }
          ],
          "Transitions": [
            {
              "SourceActivityId": "livestart",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "liverespond"
            },
            {
              "SourceActivityId": "liverespond",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "livewait"
            },
            {
              "SourceActivityId": "livewait",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "livedone"
            }
          ]
        },
        {
          "WorkflowTypeId": "wfdversionedhistory",
          "Name": "Versioned history",
          "IsEnabled": true,
          "IsSingleton": false,
          "DeleteFinishedWorkflows": false,
          "Activities": [
            {
              "ActivityId": "historystart",
              "Name": "SignalEvent",
              "X": 40,
              "Y": 40,
              "IsStart": true,
              "Properties": {
                "SignalName": {
                  "Expression": "go"
                }
              }
            },
            {
              "ActivityId": "historynotify",
              "Name": "NotifyTask",
              "X": 360,
              "Y": 40,
              "IsStart": false,
              "Properties": {
                "Message": {
                  "Expression": "Hello."
                }
              }
            }
          ],
          "Transitions": [
            {
              "SourceActivityId": "historystart",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "historynotify"
            }
          ]
        }
      ]
    }
  ]
}
