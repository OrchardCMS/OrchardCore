{
  "name": "WorkflowsDesignerTests",
  "displayName": "WorkflowsDesignerTests",
  "description": "Testing the OrchardCore.Workflows designer: the canvas, the properties panel, drafts and publishing, and the read-only instance viewer.",
  "author": "The Orchard Core Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [ "tests" ],
  "tags": [ "tests" ],

  "steps": [
    {
      "name": "feature",
      "enable": [
        "OrchardCore.HomeRoute",
        "OrchardCore.Admin",
        "OrchardCore.Navigation",
        "OrchardCore.Recipes",
        "OrchardCore.Resources",
        "OrchardCore.Roles",
        "OrchardCore.Security",
        "OrchardCore.Settings",
        "OrchardCore.Themes",
        "OrchardCore.Users",

        "OrchardCore.Contents",
        "OrchardCore.Workflows",
        "OrchardCore.Workflows.Http",
        "OrchardCore.Workflows.Timers",

        "TheAdmin",
        "SafeMode"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin",
      "site": "TheAdmin"
    },
    {
      "name": "Roles",
      "Roles": [
        {
          "Name": "WorkflowViewer",
          "Description": "Can open the admin, but can't manage workflows.",
          "Permissions": [ "AccessAdminPanel" ]
        }
      ]
    },
    {
      "name": "WorkflowType",
      "data": [
        {
          "WorkflowTypeId": "wfdseededapproval",
          "Name": "Seeded approval",
          "IsEnabled": true,
          "IsSingleton": false,
          "DeleteFinishedWorkflows": false,
          "Activities": [
            {
              "ActivityId": "seededrequest",
              "Name": "HttpRequestEvent",
              "X": 40,
              "Y": 40,
              "IsStart": true,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Article submitted"
                },
                "HttpMethod": "GET",
                "ValidateAntiforgeryToken": false
              }
            },
            {
              "ActivityId": "seedednotify",
              "Name": "NotifyTask",
              "X": 360,
              "Y": 40,
              "IsStart": false,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Notify the editors"
                },
                "Message": {
                  "Expression": "An article is waiting for review."
                }
              }
            },
            {
              "ActivityId": "seededsignal",
              "Name": "SignalEvent",
              "X": 360,
              "Y": 240,
              "IsStart": false,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Wait for approval"
                },
                "SignalName": {
                  "Expression": "approve"
                }
              }
            },
            {
              "ActivityId": "seededapproved",
              "Name": "NotifyTask",
              "X": 680,
              "Y": 240,
              "IsStart": false,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Notify the author"
                },
                "Message": {
                  "Expression": "Your article was approved."
                }
              }
            }
          ],
          "Transitions": [
            {
              "SourceActivityId": "seededrequest",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "seedednotify"
            },
            {
              "SourceActivityId": "seedednotify",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "seededsignal"
            },
            {
              "SourceActivityId": "seededsignal",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "seededapproved"
            }
          ]
        },
        {
          "WorkflowTypeId": "wfdversionedapproval",
          "Name": "Versioned approval",
          "IsEnabled": true,
          "IsSingleton": false,
          "DeleteFinishedWorkflows": false,
          "Activities": [
            {
              "ActivityId": "versionstart",
              "Name": "HttpRequestEvent",
              "X": 40,
              "Y": 40,
              "IsStart": true,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Approval requested"
                },
                "HttpMethod": "GET",
                "ValidateAntiforgeryToken": false
              }
            },
            {
              "ActivityId": "versionrespond",
              "Name": "HttpResponseTask",
              "X": 360,
              "Y": 40,
              "IsStart": false,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Return the approval URL"
                },
                "Content": {
                  "Expression": "{{ 'approve' | signal_url }}"
                },
                "HttpStatusCode": 200,
                "ContentType": {
                  "Expression": "text/plain"
                }
              }
            },
            {
              "ActivityId": "versionwait",
              "Name": "SignalEvent",
              "X": 360,
              "Y": 240,
              "IsStart": false,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Wait for the approval"
                },
                "SignalName": {
                  "Expression": "approve"
                }
              }
            },
            {
              "ActivityId": "versiondone",
              "Name": "NotifyTask",
              "X": 680,
              "Y": 240,
              "IsStart": false,
              "Properties": {
                "ActivityMetadata": {
                  "Title": "Notify the requester"
                },
                "Message": {
                  "Expression": "Approved."
                }
              }
            }
          ],
          "Transitions": [
            {
              "SourceActivityId": "versionstart",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "versionrespond"
            },
            {
              "SourceActivityId": "versionrespond",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "versionwait"
            },
            {
              "SourceActivityId": "versionwait",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "versiondone"
            }
          ]
        },
        {
          "WorkflowTypeId": "wfdversionedhistory",
          "Name": "Versioned history",
          "IsEnabled": true,
          "IsSingleton": false,
          "DeleteFinishedWorkflows": false,
          "Activities": [
            {
              "ActivityId": "historystart",
              "Name": "SignalEvent",
              "X": 40,
              "Y": 40,
              "IsStart": true,
              "Properties": {
                "SignalName": {
                  "Expression": "go"
                }
              }
            },
            {
              "ActivityId": "historynotify",
              "Name": "NotifyTask",
              "X": 360,
              "Y": 40,
              "IsStart": false,
              "Properties": {
                "Message": {
                  "Expression": "Hello."
                }
              }
            }
          ],
          "Transitions": [
            {
              "SourceActivityId": "historystart",
              "SourceOutcomeName": "Done",
              "DestinationActivityId": "historynotify"
            }
          ]
        }
      ]
    }
  ]
}
