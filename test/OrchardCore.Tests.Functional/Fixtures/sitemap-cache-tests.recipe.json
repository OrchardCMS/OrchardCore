{
  "name": "SitemapCacheTests",
  "displayName": "SitemapCacheTests",
  "description": "Testing OrchardCore.Sitemaps' SitemapsCache admin page (search box + Purge/Purge All actions).",
  "author": "The Orchard Core Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [ "tests" ],
  "tags": [ "tests" ],

  "steps": [
    {
      "name": "feature",
      "enable": [
        "OrchardCore.HomeRoute",
        "OrchardCore.Admin",
        "OrchardCore.Navigation",
        "OrchardCore.Recipes",
        "OrchardCore.Resources",
        "OrchardCore.Roles",
        "OrchardCore.Security",
        "OrchardCore.Settings",
        "OrchardCore.Themes",
        "OrchardCore.Users",

        "OrchardCore.Contents",
        "OrchardCore.Sitemaps",

        "TheAdmin",
        "SafeMode"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin",
      "site": "TheAdmin"
    },
    {
      "name": "Sitemaps",
      "Data": [
        {
          "$type": "OrchardCore.Sitemaps.Models.Sitemap, OrchardCore.Sitemaps.Abstractions",
          "SitemapId": "sitemapcachetestsitemap",
          "Name": "Sitemap Cache Test Sitemap",
          "Enabled": true,
          "Path": "sitemap-cache-test-sitemap",
          "SitemapSources": []
        }
      ]
    }
  ]
}
