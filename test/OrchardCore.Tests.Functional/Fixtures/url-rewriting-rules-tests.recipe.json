{
  "name": "UrlRewritingRulesTests",
  "displayName": "UrlRewritingRulesTests",
  "description": "Seeds 2 URL rewrite rules via the built-in Redirect source so UrlRewritingRulesTests.cs can verify sortable-rules.js drag-reorder.",
  "author": "The Orchard Core Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [ "tests" ],
  "tags": [ "tests" ],

  "steps": [
    {
      "name": "feature",
      "enable": [
        "OrchardCore.HomeRoute",
        "OrchardCore.Admin",
        "OrchardCore.Navigation",
        "OrchardCore.Recipes",
        "OrchardCore.Resources",
        "OrchardCore.Roles",
        "OrchardCore.Security",
        "OrchardCore.Settings",
        "OrchardCore.Themes",
        "OrchardCore.Users",

        "OrchardCore.UrlRewriting",

        "TheAdmin",
        "SafeMode"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin",
      "site": "TheAdmin"
    },
    {
      "name": "UrlRewriting",
      "Rules": [
        {
          "Name": "Url Rewriting Rule One",
          "Source": "Redirect",
          "Pattern": "^/url-rewriting-test-one$",
          "SubstitutionPattern": "/"
        },
        {
          "Name": "Url Rewriting Rule Two",
          "Source": "Redirect",
          "Pattern": "^/url-rewriting-test-two$",
          "SubstitutionPattern": "/"
        }
      ]
    }
  ]
}
