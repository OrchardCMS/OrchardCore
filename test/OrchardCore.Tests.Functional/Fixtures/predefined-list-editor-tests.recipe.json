{
  "name": "PredefinedListEditorTests",
  "displayName": "PredefinedListEditorTests",
  "description": "Testing OrchardCore.ContentFields' TextField PredefinedList options editor (options-editor-fields.ts, a Vue 3 options-table-editor.ts consumer, PR #19581's name->value auto-fill and duplicate-option validation fixes).",
  "author": "The Orchard Core Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [ "tests" ],
