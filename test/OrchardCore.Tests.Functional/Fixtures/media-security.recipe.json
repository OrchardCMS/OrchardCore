{
  "name": "MediaSecurity",
  "displayName": "Media Security",
  "description": "Minimal recipe for testing secure media folder authorization.",
  "author": "The Orchard Core Team",
  "website": "https://orchardcore.net",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [ "tests" ],
  "tags": [ "tests" ],

  "steps": [
    {
      "name": "feature",
      "enable": [
        "OrchardCore.HomeRoute",
        "OrchardCore.Admin",
        "OrchardCore.Diagnostics",
        "OrchardCore.Features",
        "OrchardCore.Navigation",
        "OrchardCore.Recipes",
        "OrchardCore.Resources",
        "OrchardCore.Roles",
        "OrchardCore.Security",
        "OrchardCore.Settings",
        "OrchardCore.Themes",
        "OrchardCore.Users",
        "OrchardCore.Contents",
        "OrchardCore.ContentTypes",
        "OrchardCore.Media",
        "OrchardCore.Media.Security",
        "TheAdmin",
        "SafeMode"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin",
      "site": ""
    },
    {
      "name": "media",
      "Files": [
        {
          "TargetPath": "alpha/alpha.png",
          "Base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII="
        },
        {
          "TargetPath": "beta/beta.png",
          "Base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII="
        }
      ]
    },
    {
      "name": "Roles",
      "Roles": [
        {
          "Name": "Anonymous",
          "Permissions": []
        },
        {
          "Name": "AlphaMediaViewer",
          "Permissions": [ "AccessAdminPanel", "ManageMediaContent", "ViewMediaContent_alpha" ]
        },
        {
          "Name": "BetaMediaViewer",
          "Permissions": [ "AccessAdminPanel", "ManageMediaContent", "ViewMediaContent_beta" ]
        },
        {
          "Name": "AllMediaViewer",
          "Permissions": [ "ViewMediaContent" ]
        }
      ]
    }
  ]
}
